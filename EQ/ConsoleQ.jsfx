desc:ConsoleQ (Hybrid Console EQ & Air Strip)
// @description ConsoleQ (Hybrid Console EQ & Air Strip)
// @author MemoryAPI
// @version 1.1.0
// @changelog Initial release in repository
// @about
//   # ConsoleQ
//   Hybrid Console Channel Strip Equalizer with E/G series curves, high-headroom Air Band, Sub weight, and real-time FFT spectrum analyzer.
//
//   ### Features
//   - 4-Band Console EQ (LF, LMF, HMF, HF) with switchable Bell/Shelf modes on LF and HF
//   - 18 dB/oct HPF (20 - 500 Hz) and 12 dB/oct LPF (3k - 22 kHz) console filters
//   - High-headroom Air Band with selectable frequencies (2.5k, 5k, 10k, 20k, 40 kHz) and Sub 10Hz resonance control
//   - Switchable E-Series (Constant Q) and G-Series (Proportional Q) EQ topologies
//   - Analog character modes: Clean, Subtle, and Warm saturation
//   - Interactive draggable EQ nodes directly on the curve display
//   - Real-time 2048-point FFT Spectrum Analyzer (Post-EQ, Pre-EQ, or Off)
//   - Momentary band solo auditioning per frequency band
//   - Output stage with M/S stereo width (0-200%), panning, auto-gain, and latched peak LED
//   - Scalable HiDPI text zoom (100% - 140%)
// @provides
//   [effect] ConsoleQ.jsfx

// Sliders are hidden (- prefix) for the custom @gfx interface while remaining automatable.
slider1:in_gain_db=0<-20,20,0.1>-Input Trim (dB)
slider2:phase_inv=0<0,1,1{Normal,Inverted}>-Phase Invert
slider3:hpf_hz=20<20,500,1>-HPF Frequency (Hz)
slider4:lpf_hz=22000<3000,22000,10>-LPF Frequency (Hz)
slider5:sub_gain_db=0<-4.5,15,0.1>-Sub 10Hz Gain (dB)

slider6:lf_gain_db=0<-20,20,0.1>-LF Gain (dB)
slider7:lf_freq_hz=100<40,600,1>-LF Frequency (Hz)
slider8:lf_bell=0<0,1,1{Shelf,Bell}>-LF Shape

slider9:lmf_gain_db=0<-20,20,0.1>-LMF Gain (dB)
slider10:lmf_freq_hz=600<200,2500,1>-LMF Frequency (Hz)
slider11:lmf_q=1.0<0.4,3.0,0.01>-LMF Q

slider12:hmf_gain_db=0<-20,20,0.1>-HMF Gain (dB)
slider13:hmf_freq_hz=2500<600,7000,1>-HMF Frequency (Hz)
slider14:hmf_q=1.0<0.4,3.0,0.01>-HMF Q

slider15:hf_gain_db=0<-20,20,0.1>-HF Gain (dB)
slider16:hf_freq_hz=8000<1500,20000,10>-HF Frequency (Hz)
slider17:hf_bell=0<0,1,1{Shelf,Bell}>-HF Shape

slider18:air_gain_db=0<0,20,0.1>-Air Band Gain (dB)
slider19:air_freq_idx=2<0,4,1{2.5 kHz,5 kHz,10 kHz,20 kHz,40 kHz}>-Air Frequency

slider20:eq_mode_g=1<0,1,1{E-Series (Const Q),G-Series (Prop Q)}>-EQ Topology
slider21:char_mode=1<0,2,1{Clean,Subtle,Warm}>-Character Mode
slider22:auto_gain=0<0,1,1{Off,On}>-Auto Gain
slider23:stereo_width=100<0,200,1>-Stereo Width (%)
slider24:out_pan=0<-100,100,1>-Output Pan (%)
slider25:out_gain_db=0<-20,20,0.1>-Output Fader (dB)
slider26:eq_active=1<0,1,1{Bypass,Active}>-EQ Active
slider27:ui_zoom=1.15<1.0,1.4,0.2>-UI Text Zoom
slider28:spec_mode=1<0,2,1{Off,Post-EQ,Pre-EQ}>-Spectrum Mode

in_pin:Left Input
in_pin:Right Input
out_pin:Left Output
out_pin:Right Output

@init
ext_noinit = 1.0;

MIN_FREQ = 20.0;
MAX_FREQ = 22000.0;
LOG_MIN  = log(MIN_FREQ);
LOG_MAX  = log(MAX_FREQ);

air_freq_tbl = 100;
air_freq_tbl[0] = 2500.0;
air_freq_tbl[1] = 5000.0;
air_freq_tbl[2] = 10000.0;
air_freq_tbl[3] = 20000.0;
air_freq_tbl[4] = 40000.0;

// Coefficient memory blocks (10 floats each):
// [0]=a1, [1]=a2, [2]=a3, [3]=m0, [4]=m1, [5]=m2, [6]=type, [7]=g_w, [8]=k, [9]=A
C_HPF1 = 200;
C_LPF  = 210;
C_SUB  = 220;
C_LF   = 230;
C_LMF  = 240;
C_HMF  = 250;
C_HF   = 260;
C_AIR  = 270;
C_SOLO = 280;

// Filter state blocks
S_L = 300;
S_R = 350;

// FFT Spectrum Analyzer Memory Layout (2048-point FFT)
FFT_SIZE   = 2048;
FFT_RING   = 1024;  // 2048 floats: circular time-domain audio history
FFT_WIN    = 4096;  // 2048 floats: precomputed Hann window
FFT_WORK   = 8192;  // 4096 floats: complex [re, im] pairs for fft()
SPEC_DB    = 14000; // 1024 floats: smoothed bin magnitudes in dB
UI_BINS    = 120;
UI_SPEC_Y  = 16000; // 128 floats: screen-space smoothed spectrum points

function DB_TO_K(x)
(
  10 ^ (x / 20.0)
);

function K_TO_DB(lin)
(
  8.685889638 * log(max(0.0000001, lin))
);

// Design Cytomic SVF & store exact normalized analog parameters (g, k, A) for 100% accurate plotting
// type: 0=Bell, 1=LowShelf, 2=HighShelf, 3=HPF12, 4=LPF12, 5=BPF(Solo)
function svf_design(ptr, type, fc, gain_db, Q, srate_val)
  local(nyq, fc_safe, g, A, k, a1, a2, a3, m0, m1, m2, air_scale)
(
  nyq = srate_val * 0.475;
  type == 2 && fc > (srate_val * 0.32) ? (
    air_scale = min(1.0, (srate_val * 0.42) / fc);
    fc_safe   = srate_val * 0.40 * (1.0 - 0.15 * (1.0 - air_scale));
    gain_db  *= (0.55 + 0.45 * air_scale);
  ) : (
    fc_safe = max(8.0, min(nyq, fc));
  );

  g = tan($pi * fc_safe / srate_val);
  A = 1.0;
  k = 1.0 / max(0.2, Q);

  type == 0 ? (
    // Bell
    A  = pow(10.0, gain_db / 40.0);
    k  = 1.0 / max(0.1, Q * A);
    a1 = 1.0 / (1.0 + g * (g + k));
    a2 = g * a1;
    a3 = g * a2;
    m0 = 1.0;
    m1 = k * (A * A - 1.0);
    m2 = 0.0;
  ) : type == 1 ? (
    // Low Shelf
    A  = pow(10.0, gain_db / 40.0);
    g  = g / sqrt(A);
    k  = 1.0 / max(0.2, Q);
    a1 = 1.0 / (1.0 + g * (g + k));
    a2 = g * a1;
    a3 = g * a2;
    m0 = 1.0;
    m1 = k * (A - 1.0);
    m2 = (A * A - 1.0);
  ) : type == 2 ? (
    // High Shelf
    A  = pow(10.0, gain_db / 40.0);
    g  = g * sqrt(A);
    k  = 1.0 / max(0.2, Q);
    a1 = 1.0 / (1.0 + g * (g + k));
    a2 = g * a1;
    a3 = g * a2;
    m0 = A * A;
    m1 = k * (1.0 - A) * A;
    m2 = (1.0 - A * A);
  ) : type == 3 ? (
    // High-Pass 12 dB/oct
    k  = 1.0 / max(0.2, Q);
    a1 = 1.0 / (1.0 + g * (g + k));
    a2 = g * a1;
    a3 = g * a2;
    m0 = 1.0;
    m1 = -k;
    m2 = -1.0;
  ) : type == 4 ? (
    // Low-Pass 12 dB/oct
    k  = 1.0 / max(0.2, Q);
    a1 = 1.0 / (1.0 + g * (g + k));
    a2 = g * a1;
    a3 = g * a2;
    m0 = 0.0;
    m1 = 0.0;
    m2 = 1.0;
  ) : (
    // Unity-gain Band-Pass for Solo Listen
    k  = 1.0 / max(0.2, Q);
    a1 = 1.0 / (1.0 + g * (g + k));
    a2 = g * a1;
    a3 = g * a2;
    m0 = 0.0;
    m1 = k;
    m2 = 0.0;
  );

  ptr[0] = a1; ptr[1] = a2; ptr[2] = a3;
  ptr[3] = m0; ptr[4] = m1; ptr[5] = m2;
  ptr[6] = type; ptr[7] = g; ptr[8] = k; ptr[9] = A;
);

// Exact Bilinear-Transformed Magnitude Response in dB (Zero Z-Plane Aliasing or Sign Bugs)
// Since Cytomic SVF is the exact trapezoidal integration (bilinear transform) of the analog SVF,
// evaluating at w = tan(pi * f / srate) / g yields the exact digital filter response.
function svf_exact_mag_db(ptr, tan_f)
  local(type, g, k, A, w, w2, den, num, mag_sq)
(
  type = ptr[6];
  g    = max(0.000001, ptr[7]);
  k    = ptr[8];
  A    = ptr[9];

  w  = tan_f / g;
  w2 = w * w;
  den = (1.0 - w2)*(1.0 - w2) + (k * w)*(k * w);

  type == 0 ? (
    // Bell: | (1 - w^2) + j*(k*A^2*w) |^2 / den
    num = (1.0 - w2)*(1.0 - w2) + (k * A * A * w)*(k * A * A * w);
  ) : type == 1 ? (
    // Low Shelf: | (A^2 - w^2) + j*(k*A*w) |^2 / den
    num = (A * A - w2)*(A * A - w2) + (k * A * w)*(k * A * w);
  ) : type == 2 ? (
    // High Shelf: | (1 - A^2*w^2) + j*(k*A*w) |^2 / den
    num = (1.0 - A * A * w2)*(1.0 - A * A * w2) + (k * A * w)*(k * A * w);
  ) : type == 3 ? (
    // HPF 12dB: w^4 / den
    num = w2 * w2;
  ) : (
    // LPF 12dB: 1 / den
    num = 1.0;
  );

  mag_sq = num / max(0.0000000001, den);
  4.342944819 * log(max(0.00000001, mag_sq));
);

function process_svf(x, coeff_ptr, state_ptr)
  local(ic1, ic2, v1, v2, v3)
(
  ic1 = state_ptr[0];
  ic2 = state_ptr[1];
  v3  = x - ic2;
  v1  = coeff_ptr[0] * ic1 + coeff_ptr[1] * v3;
  v2  = ic2 + coeff_ptr[1] * ic1 + coeff_ptr[2] * v3;
  state_ptr[0] = 2.0 * v1 - ic1;
  state_ptr[1] = 2.0 * v2 - ic2;
  coeff_ptr[3] * x + coeff_ptr[4] * v1 + coeff_ptr[5] * v2;
);

function update_parameters()
  local(SAFE_SRATE, q_shelf, eff_lmf_q, eff_hmf_q, air_fc, est_auto_db, pan_n)
(
  SAFE_SRATE = max(8000.0, srate);

  in_lin = DB_TO_K(in_gain_db) * (phase_inv ? -1.0 : 1.0);

  // 18 dB/oct HPF = 1st-order pole + 2nd-order SVF
  hp1_g = tan($pi * max(20.0, min(hpf_hz, SAFE_SRATE * 0.44)) / SAFE_SRATE);
  w_hp1 = 2.0 * $pi * max(20.0, min(hpf_hz, SAFE_SRATE * 0.44)) / SAFE_SRATE;
  hp1_a = 1.0 / (1.0 + w_hp1);
  svf_design(C_HPF1, 3, hpf_hz, 0.0, 0.85, SAFE_SRATE);

  // 12 dB/oct Butterworth LPF
  svf_design(C_LPF, 4, lpf_hz, 0.0, 0.7071, SAFE_SRATE);

  // Sub 10 Hz Bell (Q = 1.1)
  svf_design(C_SUB, 0, 10.0, sub_gain_db, 1.1, SAFE_SRATE);

  // E-Series vs G-Series Topology
  q_shelf = eq_mode_g ? 0.90 : 0.68;
  eff_lmf_q = eq_mode_g ? (lmf_q * (0.55 + 0.85 * (abs(lmf_gain_db) / 20.0))) : lmf_q;
  eff_hmf_q = eq_mode_g ? (hmf_q * (0.55 + 0.85 * (abs(hmf_gain_db) / 20.0))) : hmf_q;

  svf_design(C_LF,  lf_bell ? 0 : 1, lf_freq_hz,  lf_gain_db,  lf_bell ? 1.0 : q_shelf, SAFE_SRATE);
  svf_design(C_LMF, 0,               lmf_freq_hz, lmf_gain_db, eff_lmf_q,               SAFE_SRATE);
  svf_design(C_HMF, 0,               hmf_freq_hz, hmf_gain_db, eff_hmf_q,               SAFE_SRATE);
  svf_design(C_HF,  hf_bell ? 0 : 2, hf_freq_hz,  hf_gain_db,  hf_bell ? 1.0 : q_shelf, SAFE_SRATE);

  // Air Band Boost-Only Shelf
  air_fc = air_freq_tbl[air_freq_idx];
  svf_design(C_AIR, 2, air_fc, air_gain_db, 0.52, SAFE_SRATE);
  air_broadband_lin = DB_TO_K(air_gain_db * 0.12);

  // Auto-Gain Compensation
  auto_gain ? (
    est_auto_db = -(sub_gain_db * 0.10 + lf_gain_db * 0.25 + lmf_gain_db * 0.30 +
                    hmf_gain_db * 0.30 + hf_gain_db * 0.22 + air_gain_db * 0.25);
  ) : (
    est_auto_db = 0.0;
  );

  out_lin = DB_TO_K(out_gain_db + est_auto_db);

  pan_n   = out_pan * 0.01;
  pan_l   = pan_n <= 0.0 ? 1.0 : (1.0 - pan_n);
  pan_r   = pan_n >= 0.0 ? 1.0 : (1.0 + pan_n);
  width_k = stereo_width * 0.01;

  solo_band_id > 0 ? (
    solo_band_id == 1 ? svf_design(C_SOLO, 5, lf_freq_hz,  0.0, 1.4, SAFE_SRATE) :
    solo_band_id == 2 ? svf_design(C_SOLO, 5, lmf_freq_hz, 0.0, lmf_q, SAFE_SRATE) :
    solo_band_id == 3 ? svf_design(C_SOLO, 5, hmf_freq_hz, 0.0, hmf_q, SAFE_SRATE) :
    solo_band_id == 4 ? svf_design(C_SOLO, 5, hf_freq_hz,  0.0, 1.4, SAFE_SRATE) :
                        svf_design(C_SOLO, 2, air_fc,     12.0, 0.7, SAFE_SRATE);
  );

  meter_decay = exp(-1.0 / (0.15 * SAFE_SRATE));
);

!init_done ? (
  ui_zoom < 1.0 ? ui_zoom = 1.15;
  eq_active = 1;
  eq_mode_g = 1;
  char_mode = 1;
  spec_mode = 1;

  // Precompute Hann window for 2048-point FFT
  wi = 0;
  loop(FFT_SIZE,
    FFT_WIN[wi] = 0.5 - 0.5 * cos(2.0 * $pi * wi / (FFT_SIZE - 1));
    wi += 1;
  );
  si = 0;
  loop(FFT_SIZE / 2,
    SPEC_DB[si] = -90.0;
    si += 1;
  );

  update_parameters();
  init_done = 1;
);

update_parameters();

@slider
update_parameters();

@block
update_parameters();

@sample
raw_l = spl0;
raw_r = spl1;

sig_l = raw_l * in_lin;
sig_r = raw_r * in_lin;

pre_mono = (sig_l + sig_r) * 0.5;

eq_active ? (
  solo_band_id > 0 ? (
    sig_l = process_svf(sig_l, C_SOLO, S_L + 16);
    sig_r = process_svf(sig_r, C_SOLO, S_R + 16);
  ) : (
    // 1. 18 dB/oct HPF
    hpf_hz > 21.0 ? (
      hp1_l = hp1_a * (hp1_l + sig_l - hp1_prev_in_l); hp1_prev_in_l = sig_l; sig_l = hp1_l;
      hp1_r = hp1_a * (hp1_r + sig_r - hp1_prev_in_r); hp1_prev_in_r = sig_r; sig_r = hp1_r;
      sig_l = process_svf(sig_l, C_HPF1, S_L + 0);
      sig_r = process_svf(sig_r, C_HPF1, S_R + 0);
    );

    // 2. 12 dB/oct LPF
    lpf_hz < 21500.0 ? (
      sig_l = process_svf(sig_l, C_LPF, S_L + 2);
      sig_r = process_svf(sig_r, C_LPF, S_R + 2);
    );

    // 3. Sub 10 Hz Bell
    abs(sub_gain_db) > 0.05 ? (
      sig_l = process_svf(sig_l, C_SUB, S_L + 4);
      sig_r = process_svf(sig_r, C_SUB, S_R + 4);
    );

    // 4. 4-Band Console EQ (LF, LMF, HMF, HF)
    abs(lf_gain_db) > 0.05 ? (
      sig_l = process_svf(sig_l, C_LF, S_L + 6);
      sig_r = process_svf(sig_r, C_LF, S_R + 6);
    );
    abs(lmf_gain_db) > 0.05 ? (
      sig_l = process_svf(sig_l, C_LMF, S_L + 8);
      sig_r = process_svf(sig_r, C_LMF, S_R + 8);
    );
    abs(hmf_gain_db) > 0.05 ? (
      sig_l = process_svf(sig_l, C_HMF, S_L + 10);
      sig_r = process_svf(sig_r, C_HMF, S_R + 10);
    );
    abs(hf_gain_db) > 0.05 ? (
      sig_l = process_svf(sig_l, C_HF, S_L + 12);
      sig_r = process_svf(sig_r, C_HF, S_R + 12);
    );

    // 5. Air Band Shelf (2.5k .. 40k)
    air_gain_db > 0.05 ? (
      sig_l = process_svf(sig_l, C_AIR, S_L + 14) * air_broadband_lin;
      sig_r = process_svf(sig_r, C_AIR, S_R + 14) * air_broadband_lin;
    );

    // 6. Console Character Saturation
    char_mode == 1 ? (
      sig_l = sig_l - 0.08 * (sig_l * sig_l * sig_l);
      sig_r = sig_r - 0.08 * (sig_r * sig_r * sig_r);
    ) : char_mode == 2 ? (
      sig_l = (sig_l + 0.03 * sig_l * sig_l) / (1.0 + 0.18 * abs(sig_l));
      sig_r = (sig_r + 0.03 * sig_r * sig_r) / (1.0 + 0.18 * abs(sig_r));
    );
  );

  // 7. M/S Stereo Width, Output Pan & Fader Gain
  mid_s  = (sig_l + sig_r) * 0.5;
  side_s = (sig_l - sig_r) * 0.5 * width_k;
  sig_l  = (mid_s + side_s) * pan_l * out_lin;
  sig_r  = (mid_s - side_s) * pan_r * out_lin;
);

// Safety NaN/Clip protection
(sig_l != sig_l || abs(sig_l) > 4.0) ? sig_l = max(-4.0, min(4.0, sig_l));
(sig_r != sig_r || abs(sig_r) > 4.0) ? sig_r = max(-4.0, min(4.0, sig_r));

spl0 = sig_l;
spl1 = sig_r;

// Feed circular FFT buffer (Post-EQ or Pre-EQ)
FFT_RING[fft_write_idx] = (spec_mode == 2) ? pre_mono : ((sig_l + sig_r) * 0.5);
fft_write_idx = (fft_write_idx + 1) & (FFT_SIZE - 1);
fft_hop_cnt += 1;

out_pk = max(abs(sig_l), abs(sig_r));
env_out = max(out_pk, env_out * meter_decay);
out_pk > 1.0 ? peak_led_latched = 1;

@gfx 940 680
// Catppuccin Mocha Base (#1E1E2E: R=30, G=30, B=46)
gfx_clear = 30 + (30 * 256) + (46 * 65536);

W = max(800, gfx_w);
H = max(580, gfx_h);

// Responsive geometry scale & Linux X11 font multiplier
S  = min(W / 940.0, H / 680.0);
TS = S * max(1.0, ui_zoom);

f_title = max(18, floor(22 * TS));
f_sec   = max(12, floor(13 * TS));
f_val   = max(11, floor(12 * TS));
f_btn   = max(11, floor(12 * TS));
f_grid  = max(10, floor(11 * TS));

gfx_setfont(1, "sans-serif", f_title, 'b');
gfx_setfont(2, "sans-serif", f_sec,   'b');
gfx_setfont(3, "sans-serif", f_val,   0);
gfx_setfont(4, "sans-serif", f_btn,   'b');
gfx_setfont(5, "sans-serif", f_grid,  0);

// Release Band Solo if mouse button is released
!(mouse_cap & 1) && (solo_band_id > 0) ? (
  solo_band_id = 0;
  update_parameters();
);

// -------------------------------------------------------------------------
// COMPUTE 2048-POINT REAL-TIME FFT FOR SPECTRUM ANALYZER
// -------------------------------------------------------------------------
spec_mode > 0 && fft_hop_cnt >= 512 ? (
  fft_hop_cnt = 0;
  fi = 0;
  loop(FFT_SIZE,
    r_idx = (fft_write_idx + fi) & (FFT_SIZE - 1);
    FFT_WORK[fi * 2]     = FFT_RING[r_idx] * FFT_WIN[fi];
    FFT_WORK[fi * 2 + 1] = 0.0;
    fi += 1;
  );
  fft(FFT_WORK, FFT_SIZE);
  fft_permute(FFT_WORK, FFT_SIZE);

  norm_fft = 2.0 / FFT_SIZE;
  bi = 1;
  loop(FFT_SIZE / 2 - 1,
    re = FFT_WORK[bi * 2]     * norm_fft;
    im = FFT_WORK[bi * 2 + 1] * norm_fft;
    mag_db = 4.342944819 * log(max(0.000000000001, re*re + im*im));
    // Smooth attack / release ballistics per FFT bin
    mag_db > SPEC_DB[bi] ? (
      SPEC_DB[bi] = SPEC_DB[bi] * 0.45 + mag_db * 0.55;
    ) : (
      SPEC_DB[bi] = SPEC_DB[bi] * 0.84 + mag_db * 0.16;
    );
    bi += 1;
  );
);

function freq_to_x(f, x0, xw)
  local(clamped)
(
  clamped = max(MIN_FREQ, min(MAX_FREQ, f));
  x0 + ((log(clamped) - LOG_MIN) / (LOG_MAX - LOG_MIN)) * xw;
);

function x_to_freq(px, x0, xw)
  local(norm)
(
  norm = max(0.0, min(1.0, (px - x0) / xw));
  exp(LOG_MIN + norm * (LOG_MAX - LOG_MIN));
);

function draw_panel_box(bx, by, bw, bh, r_bg, g_bg, b_bg, r_bd, g_bd, b_bd)
(
  gfx_set(r_bg, g_bg, b_bg, 1.0);
  gfx_rect(bx, by, bw, bh);
  gfx_set(r_bd, g_bd, b_bd, 1.0);
  gfx_rect(bx, by, bw, bh, 0);
);

// Evaluate exact composite EQ magnitude in dB at frequency `f_eval`
function eval_total_eq_db(f_eval)
  local(tot_db, sr_v, tan_f, w1)
(
  sr_v  = max(8000.0, srate);
  tan_f = tan($pi * min(sr_v * 0.48, max(5.0, f_eval)) / sr_v);
  tot_db = 0.0;

  hpf_hz > 21.0 ? (
    tot_db += svf_exact_mag_db(C_HPF1, tan_f);
    w1 = tan_f / max(0.00001, hp1_g);
    tot_db += 4.342944819 * log((w1 * w1) / (1.0 + w1 * w1));
  );
  lpf_hz < 21500.0        ? tot_db += svf_exact_mag_db(C_LPF, tan_f);
  abs(sub_gain_db) > 0.05 ? tot_db += svf_exact_mag_db(C_SUB, tan_f);
  abs(lf_gain_db)  > 0.05 ? tot_db += svf_exact_mag_db(C_LF,  tan_f);
  abs(lmf_gain_db) > 0.05 ? tot_db += svf_exact_mag_db(C_LMF, tan_f);
  abs(hmf_gain_db) > 0.05 ? tot_db += svf_exact_mag_db(C_HMF, tan_f);
  abs(hf_gain_db)  > 0.05 ? tot_db += svf_exact_mag_db(C_HF,  tan_f);
  air_gain_db > 0.05      ? tot_db += svf_exact_mag_db(C_AIR, tan_f) + (air_gain_db * 0.12);
  tot_db;
);

// Unified Console Rotary Knob (Cohesive Sapphire/Sky or Gold Accent)
function draw_console_knob(id, cx, cy, r, val, vmin, vmax, vdef, label, val_str, bipolar, rc, gc, bc)
  local(norm, zero_norm, hit, hover, sens, delta, ang_start, ang_end, ang_val,
        steps, st, t0, t1, a0, a1, active_seg, px0, py0, px1, py1, lw, lh, vw, vh,
        pill_w, pill_h, pill_x, pill_y)
(
  norm = max(0.0, min(1.0, (val - vmin) / (vmax - vmin)));

  hit = ((mouse_x - cx)*(mouse_x - cx) + (mouse_y - cy)*(mouse_y - cy)) <= ((r + 7)*(r + 7));
  hover = hit || (drag_id == id);

  (mouse_cap & 1) && !(last_mouse_cap & 1) && hit ? (
    (time_precise() - last_click_time < 0.28) && (last_click_id == id) ? (
      val = vdef;
      drag_id = 0;
    ) : (
      drag_id = id;
      drag_start_y = mouse_y;
      drag_start_val = val;
      last_click_time = time_precise();
      last_click_id = id;
    );
  );

  drag_id == id ? (
    (mouse_cap & 1) ? (
      sens = (mouse_cap & 4) ? 550.0 : 140.0;
      delta = (drag_start_y - mouse_y) / sens;
      val = max(vmin, min(vmax, drag_start_val + delta * (vmax - vmin)));
    ) : (
      drag_id = 0;
    );
  );

  norm = max(0.0, min(1.0, (val - vmin) / (vmax - vmin)));

  // Soft drop shadow & subtle hover halo
  gfx_set(0.04, 0.04, 0.08, 0.85);
  gfx_circle(cx, cy + 2, r + 1, 1, 1);
  hover ? (
    gfx_set(rc, gc, bc, 0.16);
    gfx_circle(cx, cy, r + 4, 1, 1);
  );

  // Dark slate knob body
  gfx_set(0.11, 0.12, 0.17, 1.0);
  gfx_circle(cx, cy, r, 1, 1);
  hover ? gfx_set(rc, gc, bc, 0.95) : gfx_set(0.23, 0.25, 0.34, 1.0);
  gfx_circle(cx, cy, r, 0, 1);

  ang_start = -2.356194;
  ang_end   =  2.356194;
  ang_val   = ang_start + norm * (ang_end - ang_start);
  zero_norm = (0.0 - vmin) / (vmax - vmin);

  steps = 28;
  st = 0;
  loop(steps,
    t0 = st / steps;
    t1 = (st + 1) / steps;
    a0 = ang_start + t0 * (ang_end - ang_start);
    a1 = ang_start + t1 * (ang_end - ang_start);

    bipolar ? (
      active_seg = (t1 >= min(zero_norm, norm)) && (t0 <= max(zero_norm, norm));
    ) : (
      active_seg = (t1 <= norm);
    );

    active_seg ? (
      gfx_set(rc, gc, bc, 0.98);
    ) : (
      gfx_set(0.19, 0.20, 0.28, 0.85);
    );

    gfx_line(cx + sin(a0)*(r-3), cy - cos(a0)*(r-3), cx + sin(a1)*(r-3), cy - cos(a1)*(r-3), 1);
    gfx_line(cx + sin(a0)*(r-4), cy - cos(a0)*(r-4), cx + sin(a1)*(r-4), cy - cos(a1)*(r-4), 1);
    st += 1;
  );

  // Subtle dark center cap & crisp white pointer
  gfx_set(0.16, 0.18, 0.25, 1.0);
  gfx_circle(cx, cy, floor(r * 0.26), 1, 1);
  gfx_set(0.95, 0.97, 1.0, 1.0);
  px0 = cx + sin(ang_val) * (r * 0.22);
  py0 = cy - cos(ang_val) * (r * 0.22);
  px1 = cx + sin(ang_val) * (r - 5);
  py1 = cy - cos(ang_val) * (r - 5);
  gfx_line(px0, py0, px1, py1, 1);

  // Label
  gfx_setfont(5);
  gfx_measurestr(label, lw, lh);
  gfx_set(0.72, 0.76, 0.88, 1.0);
  gfx_x = cx - lw * 0.5;
  gfx_y = cy + r + floor(4 * S);
  gfx_drawstr(label);

  // Pill Value Readout
  gfx_setfont(3);
  gfx_measurestr(val_str, vw, vh);
  pill_w = max(vw + floor(10 * S), floor(58 * S));
  pill_h = vh + floor(4 * S);
  pill_x = cx - pill_w * 0.5;
  pill_y = cy + r + lh + floor(5 * S);

  draw_panel_box(pill_x, pill_y, pill_w, pill_h, 0.06, 0.06, 0.10, hover ? rc : 0.20, hover ? gc : 0.22, hover ? bc : 0.32);
  gfx_set(0.94, 0.96, 1.0, 1.0);
  gfx_x = cx - vw * 0.5;
  gfx_y = pill_y + (pill_h - vh) * 0.5;
  gfx_drawstr(val_str);

  val;
);

// =========================================================================
// 1. TOP HEADER BAR
// =========================================================================
hdr_h = floor(48 * S);
gfx_set(0.09, 0.09, 0.15, 1.0);
gfx_rect(0, 0, W, hdr_h);
gfx_set(0.20, 0.22, 0.30, 1.0);
gfx_line(0, hdr_h, W, hdr_h);

// Brand Title: CONSOLEQ in Catppuccin Sapphire (#74C7EC)
gfx_setfont(1);
gfx_set(0.45, 0.78, 0.98, 1.0);
gfx_x = floor(18 * S);
gfx_measurestr("CONSOLE", tw1, th1);
gfx_y = (hdr_h - th1) * 0.5;
gfx_drawstr("CONSOLE");
gfx_set(0.94, 0.96, 1.0, 1.0);
gfx_drawstr("Q");

// "?" Info Badge
gfx_setfont(5);
gfx_measurestr("?", qw, qh);
q_x = gfx_x + floor(8 * S);
q_y = (hdr_h - qh - 4) * 0.5;
gfx_set(0.18, 0.19, 0.28, 1.0);
gfx_rect(q_x, q_y, qw + 12, qh + 4);
gfx_set(0.45, 0.78, 0.98, 1.0);
gfx_x = q_x + 6; gfx_y = q_y + 2;
gfx_drawstr("?");

title_hit = mouse_x >= 16 && mouse_x <= (q_x + qw + 16) && mouse_y >= 6 && mouse_y <= (hdr_h - 6);
(mouse_cap & 1) && !(last_mouse_cap & 1) && title_hit ? (
  info_open = !info_open;
);

hb_h = floor(28 * S);
hb_y = (hdr_h - hb_h) * 0.5;

// 1. E-Series / G-Series Topology Switch
eg_w = floor(118 * S);
eg_x = floor(195 * S);
eg_hit = (mouse_x >= eg_x && mouse_x <= eg_x + eg_w && mouse_y >= hb_y && mouse_y <= hb_y + hb_h);
(mouse_cap & 1) && !(last_mouse_cap & 1) && eg_hit ? (
  eq_mode_g = !eq_mode_g;
  update_parameters();
  slider_automate(slider20);
);
eq_mode_g ? (
  draw_panel_box(eg_x, hb_y, eg_w, hb_h, 0.16, 0.36, 0.62, 0.45, 0.78, 0.98);
  strcpy(#eg_s, "MODE: G-SERIES");
) : (
  draw_panel_box(eg_x, hb_y, eg_w, hb_h, 0.14, 0.15, 0.22, 0.32, 0.36, 0.48);
  strcpy(#eg_s, "MODE: E-SERIES");
);
gfx_setfont(4); gfx_set(0.95, 0.97, 1.0, 1.0);
gfx_measurestr(#eg_s, tw, th);
gfx_x = eg_x + (eg_w - tw)*0.5; gfx_y = hb_y + (hb_h - th)*0.5;
gfx_drawstr(#eg_s);

// 2. Character Mode (Clean / Subtle / Warm)
ch_w = floor(116 * S);
ch_x = eg_x + eg_w + floor(8 * S);
ch_hit = (mouse_x >= ch_x && mouse_x <= ch_x + ch_w && mouse_y >= hb_y && mouse_y <= hb_y + hb_h);
(mouse_cap & 1) && !(last_mouse_cap & 1) && ch_hit ? (
  char_mode = (char_mode + 1) % 3;
  slider_automate(slider21);
);
char_mode == 0 ? (
  draw_panel_box(ch_x, hb_y, ch_w, hb_h, 0.14, 0.15, 0.22, 0.28, 0.30, 0.42);
  strcpy(#ch_s, "CHAR: CLEAN");
) : char_mode == 1 ? (
  draw_panel_box(ch_x, hb_y, ch_w, hb_h, 0.16, 0.36, 0.62, 0.45, 0.78, 0.98);
  strcpy(#ch_s, "CHAR: SUBTLE");
) : (
  draw_panel_box(ch_x, hb_y, ch_w, hb_h, 0.45, 0.36, 0.20, 0.98, 0.89, 0.69);
  strcpy(#ch_s, "CHAR: WARM");
);
gfx_measurestr(#ch_s, tw, th);
gfx_x = ch_x + (ch_w - tw)*0.5; gfx_y = hb_y + (hb_h - th)*0.5;
gfx_drawstr(#ch_s);

// 3. Spectrum Analyzer Mode Toggle (POST-EQ / PRE-EQ / OFF)
sp_w = floor(112 * S);
sp_x = ch_x + ch_w + floor(8 * S);
sp_hit = (mouse_x >= sp_x && mouse_x <= sp_x + sp_w && mouse_y >= hb_y && mouse_y <= hb_y + hb_h);
(mouse_cap & 1) && !(last_mouse_cap & 1) && sp_hit ? (
  spec_mode = (spec_mode + 1) % 3;
  slider_automate(slider28);
);
spec_mode > 0 ? (
  draw_panel_box(sp_x, hb_y, sp_w, hb_h, 0.16, 0.36, 0.62, 0.45, 0.78, 0.98);
  spec_mode == 1 ? strcpy(#sp_s, "SPEC: POST-EQ") : strcpy(#sp_s, "SPEC: PRE-EQ");
) : (
  draw_panel_box(sp_x, hb_y, sp_w, hb_h, 0.14, 0.15, 0.22, 0.28, 0.30, 0.42);
  strcpy(#sp_s, "SPEC: OFF");
);
gfx_measurestr(#sp_s, tw, th);
gfx_x = sp_x + (sp_w - tw)*0.5; gfx_y = hb_y + (hb_h - th)*0.5;
gfx_drawstr(#sp_s);

// 4. Auto Gain Switch
ag_w = floor(94 * S);
ag_x = sp_x + sp_w + floor(8 * S);
ag_hit = (mouse_x >= ag_x && mouse_x <= ag_x + ag_w && mouse_y >= hb_y && mouse_y <= hb_y + hb_h);
(mouse_cap & 1) && !(last_mouse_cap & 1) && ag_hit ? (
  auto_gain = !auto_gain;
  update_parameters();
  slider_automate(slider22);
);
auto_gain ? (
  draw_panel_box(ag_x, hb_y, ag_w, hb_h, 0.16, 0.36, 0.62, 0.45, 0.78, 0.98);
  gfx_set(1.0, 1.0, 1.0, 1.0);
) : (
  draw_panel_box(ag_x, hb_y, ag_w, hb_h, 0.14, 0.15, 0.22, 0.28, 0.30, 0.42);
  gfx_set(0.76, 0.80, 0.90, 1.0);
);
gfx_measurestr("AUTO GAIN", tw, th);
gfx_x = ag_x + (ag_w - tw)*0.5; gfx_y = hb_y + (hb_h - th)*0.5;
gfx_drawstr("AUTO GAIN");

// 5. Text Zoom Button
zm_w = floor(94 * S);
zm_x = W - floor(206 * S);
zm_hit = (mouse_x >= zm_x && mouse_x <= zm_x + zm_w && mouse_y >= hb_y && mouse_y <= hb_y + hb_h);
(mouse_cap & 1) && !(last_mouse_cap & 1) && zm_hit ? (
  ui_zoom < 1.1 ? ui_zoom = 1.20 :
  ui_zoom < 1.3 ? ui_zoom = 1.40 : ui_zoom = 1.0;
  slider_automate(slider27);
);
draw_panel_box(zm_x, hb_y, zm_w, hb_h, 0.14, 0.15, 0.22, 0.28, 0.30, 0.42);
gfx_set(0.82, 0.86, 0.96, 1.0);
ui_zoom < 1.1 ? strcpy(#z_lbl, "TEXT: 100%") :
ui_zoom < 1.3 ? strcpy(#z_lbl, "TEXT: 120%") : strcpy(#z_lbl, "TEXT: 140%");
gfx_measurestr(#z_lbl, tw, th);
gfx_x = zm_x + (zm_w - tw)*0.5; gfx_y = hb_y + (hb_h - th)*0.5;
gfx_drawstr(#z_lbl);

// 6. Master EQ Active Button
act_w = floor(90 * S);
act_x = W - act_w - floor(14 * S);
act_hit = (mouse_x >= act_x && mouse_x <= act_x + act_w && mouse_y >= hb_y && mouse_y <= hb_y + hb_h);
(mouse_cap & 1) && !(last_mouse_cap & 1) && act_hit ? (
  eq_active = !eq_active;
  slider_automate(slider26);
);
eq_active ? (
  draw_panel_box(act_x, hb_y, act_w, hb_h, 0.20, 0.52, 0.88, 0.54, 0.80, 1.0);
  gfx_set(1.0, 1.0, 1.0, 1.0); strcpy(#ac_s, "EQ: IN");
) : (
  draw_panel_box(act_x, hb_y, act_w, hb_h, 0.14, 0.15, 0.22, 0.28, 0.30, 0.42);
  gfx_set(0.65, 0.68, 0.78, 1.0); strcpy(#ac_s, "BYPASSED");
);
gfx_measurestr(#ac_s, tw, th);
gfx_x = act_x + (act_w - tw)*0.5; gfx_y = hb_y + (hb_h - th)*0.5;
gfx_drawstr(#ac_s);

// =========================================================================
// 2. REAL-TIME FFT SPECTRUM & EXACT EQ TRANSFER CURVE VIEWPORT
// =========================================================================
pad = floor(12 * S);
full_w = W - (pad * 2);

plot_y = hdr_h + pad;
plot_h = floor((H - plot_y - pad * 2) * 0.34);
draw_panel_box(pad, plot_y, full_w, plot_h, 0.055, 0.058, 0.092, 0.20, 0.22, 0.32);

// Frequency Grid Lines (50, 100, 200, 500, 1k, 2k, 5k, 10k, 20k)
gfx_setfont(5);
gi = 0;
loop(9,
  gi == 0 ? gf = 50 : gi == 1 ? gf = 100 : gi == 2 ? gf = 200 :
  gi == 3 ? gf = 500 : gi == 4 ? gf = 1000 : gi == 5 ? gf = 2000 :
  gi == 6 ? gf = 5000 : gi == 7 ? gf = 10000 : gf = 20000;

  gx = freq_to_x(gf, pad, full_w);
  gfx_set(0.12, 0.13, 0.20, 1.0);
  gfx_line(gx, plot_y + 1, gx, plot_y + plot_h - 1);

  gfx_set(0.46, 0.50, 0.64, 1.0);
  gf >= 1000 ? sprintf(#flbl, "%dk", gf/1000) : sprintf(#flbl, "%d", gf);
  gfx_measurestr(#flbl, tw, th);
  gfx_x = gx - tw * 0.5;
  gfx_y = plot_y + plot_h - th - 4;
  gfx_drawstr(#flbl);
  gi += 1;
);

// Horizontal dB Grid Lines (+12, +6, 0, -6, -12 dB)
zero_py = plot_y + plot_h * 0.5;
gfx_set(0.22, 0.25, 0.35, 1.0);
gfx_line(pad + 1, zero_py, pad + full_w - 1, zero_py);

di = -2;
loop(5,
  di != 0 ? (
    db_v = di * 6.0;
    gy = zero_py - (db_v / 22.0) * (plot_h * 0.46);
    gfx_set(0.12, 0.13, 0.20, 1.0);
    gfx_line(pad + 1, gy, pad + full_w - 1, gy);
    gfx_set(0.45, 0.48, 0.60, 1.0);
    sprintf(#dlbl, "%+d", db_v);
    gfx_x = pad + 6; gfx_y = gy - 6;
    gfx_drawstr(#dlbl);
  );
  di += 1;
);

// --- RENDER REAL-TIME FFT SPECTRUM BEHIND THE EQ CURVE ---
spec_mode > 0 ? (
  sr_v = max(8000.0, srate);
  si = 0;
  loop(UI_BINS + 1,
    t_n  = si / UI_BINS;
    f_ev = exp(LOG_MIN + t_n * (LOG_MAX - LOG_MIN));
    f_bin = (f_ev * FFT_SIZE) / sr_v;
    b0 = max(1, min(FFT_SIZE / 2 - 2, floor(f_bin)));
    frac_b = f_bin - b0;
    raw_spec_db = SPEC_DB[b0] * (1.0 - frac_b) + SPEC_DB[b0 + 1] * frac_b;

    // Apply +4.5 dB/octave visual tilt centered at 1 kHz so pink noise looks balanced
    tilt_db = 4.5 * (log(f_ev / 1000.0) / log(2.0));
    tilted_db = raw_spec_db + tilt_db;

    // Map -78 dB .. -6 dB to viewport height
    s_norm = max(0.0, min(1.0, (tilted_db + 78.0) / 72.0));
    sx_pt = pad + t_n * full_w;
    sy_pt = (plot_y + plot_h - 2) - s_norm * (plot_h - 10);

    // Subtle vertical sapphire fill
    s_norm > 0.01 ? (
      gfx_set(0.35, 0.62, 0.92, 0.15);
      gfx_rect(sx_pt, sy_pt, max(2, full_w / UI_BINS + 1), (plot_y + plot_h - 2) - sy_pt);
    );

    si > 0 ? (
      gfx_set(0.48, 0.76, 0.98, 0.72);
      gfx_line(prev_sx_pt, prev_sy_pt, sx_pt, sy_pt, 1);
    );
    prev_sx_pt = sx_pt;
    prev_sy_pt = sy_pt;
    si += 1;
  );
);

// --- RENDER EXACT COMPOSITE EQ RESPONSE CURVE (CHAMPAGNE GOLD #F9E2AF) ---
pts = 150;
pi = 0;
loop(pts + 1,
  t_n  = pi / pts;
  f_ev = exp(LOG_MIN + t_n * (LOG_MAX - LOG_MIN));
  db_y = eval_total_eq_db(f_ev);
  clamped_db = max(-22.0, min(22.0, db_y));

  px_c = pad + t_n * full_w;
  py_c = zero_py - (clamped_db / 22.0) * (plot_h * 0.46);

  // Soft gold fill between curve and 0 dB line
  gfx_set(0.98, 0.89, 0.69, 0.11);
  gfx_line(px_c, zero_py, px_c, py_c);

  pi > 0 ? (
    gfx_set(0.98, 0.89, 0.69, 0.98);
    gfx_line(prev_px_c, prev_py_c, px_c, py_c, 1);
    gfx_line(prev_px_c, prev_py_c + 1, px_c, py_c + 1, 1);
  );
  prev_px_c = px_c;
  prev_py_c = py_c;
  pi += 1;
);

// Interactive Draggable Nodes on the EQ Graph (LF, LMF, HMF, HF)
function draw_eq_node(node_id, freq_v, gain_v, f_min, f_max, rc, gc, bc, lbl_str)
  local(nx, ny, hit, lw, lh)
(
  nx = freq_to_x(freq_v, pad, full_w);
  ny = zero_py - (max(-20.0, min(20.0, gain_v)) / 22.0) * (plot_h * 0.46);

  hit = ((mouse_x - nx)*(mouse_x - nx) + (mouse_y - ny)*(mouse_y - ny)) <= 110;
  (mouse_cap & 1) && !(last_mouse_cap & 1) && hit && (drag_id == 0) ? (
    drag_id = node_id;
  );

  drag_id == node_id ? (
    (mouse_cap & 1) ? (
      node_out_f = max(f_min, min(f_max, x_to_freq(mouse_x, pad, full_w)));
      node_out_g = max(-20.0, min(20.0, ((zero_py - mouse_y) / (plot_h * 0.46)) * 22.0));
      node_changed = 1;
    ) : (
      drag_id = 0;
      node_changed = 0;
    );
  ) : (
    node_changed = 0;
  );

  gfx_set(rc, gc, bc, 0.25);
  gfx_circle(nx, ny, floor(9 * S), 1, 1);
  gfx_set(rc, gc, bc, 1.0);
  gfx_circle(nx, ny, floor(5 * S), 1, 1);
  gfx_set(1.0, 1.0, 1.0, 1.0);
  gfx_circle(nx, ny, floor(5 * S), 0, 1);

  // Subtle node label above handle
  gfx_setfont(5);
  gfx_measurestr(lbl_str, lw, lh);
  gfx_set(0.88, 0.92, 1.0, 0.9);
  gfx_x = nx - lw * 0.5;
  gfx_y = ny - lh - floor(6 * S);
  gfx_drawstr(lbl_str);
);

draw_eq_node(301, lf_freq_hz,  lf_gain_db,  40.0,   600.0,   0.45, 0.78, 0.98, "LF");
node_changed ? ( lf_freq_hz = node_out_f; lf_gain_db = node_out_g; update_parameters(); slider_automate(slider6); slider_automate(slider7); );

draw_eq_node(302, lmf_freq_hz, lmf_gain_db, 200.0,  2500.0,  0.54, 0.71, 0.98, "LMF");
node_changed ? ( lmf_freq_hz = node_out_f; lmf_gain_db = node_out_g; update_parameters(); slider_automate(slider9); slider_automate(slider10); );

draw_eq_node(303, hmf_freq_hz, hmf_gain_db, 600.0,  7000.0,  0.54, 0.71, 0.98, "HMF");
node_changed ? ( hmf_freq_hz = node_out_f; hmf_gain_db = node_out_g; update_parameters(); slider_automate(slider12); slider_automate(slider13); );

draw_eq_node(304, hf_freq_hz,  hf_gain_db,  1500.0, 20000.0, 0.45, 0.78, 0.98, "HF");
node_changed ? ( hf_freq_hz = node_out_f; hf_gain_db = node_out_g; update_parameters(); slider_automate(slider15); slider_automate(slider16); );

// =========================================================================
// 3. 7-COLUMN UNIFIED CONSOLE STRIP DECK (COHESIVE SAPPHIRE & GOLD THEME)
// =========================================================================
strip_y = plot_y + plot_h + pad;
strip_h = H - strip_y - pad;

col_gap = floor(8 * S);
col_w   = floor((full_w - col_gap * 6) / 7.0);

r_knb   = min(floor(23 * S), floor(strip_h * 0.088));
row1_cy = strip_y + floor(strip_h * 0.23);
row2_cy = strip_y + floor(strip_h * 0.54);
row3_cy = strip_y + floor(strip_h * 0.83);

function draw_col_header(cx_0, cw_0, title_s, rc, gc, bc, s_id)
  local(tw, th, sb_w, sb_h, sb_x, sb_y, s_hit)
(
  draw_panel_box(cx_0, strip_y, cw_0, strip_h, 0.095, 0.098, 0.145, 0.19, 0.21, 0.30);
  // Subtle top accent bar
  gfx_set(rc, gc, bc, 0.85);
  gfx_rect(cx_0 + 1, strip_y + 1, cw_0 - 2, floor(3 * S));

  gfx_setfont(2);
  gfx_set(0.84, 0.88, 0.96, 1.0);
  gfx_x = cx_0 + floor(10 * S);
  gfx_y = strip_y + floor(9 * S);
  gfx_drawstr(title_s);

  // Momentary Band Solo [S] Button
  s_id > 0 ? (
    sb_w = floor(22 * S); sb_h = floor(18 * S);
    sb_x = cx_0 + cw_0 - sb_w - floor(6 * S);
    sb_y = strip_y + floor(7 * S);
    s_hit = (mouse_x >= sb_x && mouse_x <= sb_x + sb_w && mouse_y >= sb_y && mouse_y <= sb_y + sb_h);
    (mouse_cap & 1) && s_hit ? (
      solo_band_id = s_id;
      update_parameters();
    );
    solo_band_id == s_id ? (
      draw_panel_box(sb_x, sb_y, sb_w, sb_h, 0.85, 0.35, 0.45, 1.0, 0.70, 0.75);
      gfx_set(1.0, 1.0, 1.0, 1.0);
    ) : (
      draw_panel_box(sb_x, sb_y, sb_w, sb_h, 0.14, 0.15, 0.22, 0.26, 0.28, 0.38);
      gfx_set(0.68, 0.72, 0.84, 1.0);
    );
    gfx_setfont(5);
    gfx_measurestr("S", tw, th);
    gfx_x = sb_x + (sb_w - tw)*0.5; gfx_y = sb_y + (sb_h - th)*0.5;
    gfx_drawstr("S");
  );
);

// -------------------------------------------------------------------------
// COLUMN 1: FILTERS (IN TRIM, HPF 18dB, LPF 12dB)
// -------------------------------------------------------------------------
x_c1 = pad;
draw_col_header(x_c1, col_w, "FILTERS", 0.45, 0.78, 0.98, 0);
cx_1 = x_c1 + col_w * 0.5;

ph_w = floor(34 * S); ph_h = floor(18 * S);
ph_x = x_c1 + col_w - ph_w - floor(6 * S); ph_y = strip_y + floor(7 * S);
(mouse_cap & 1) && !(last_mouse_cap & 1) &&
(mouse_x >= ph_x && mouse_x <= ph_x + ph_w && mouse_y >= ph_y && mouse_y <= ph_y + ph_h) ? (
  phase_inv = !phase_inv; update_parameters(); slider_automate(slider2);
);
phase_inv ? (
  draw_panel_box(ph_x, ph_y, ph_w, ph_h, 0.20, 0.50, 0.86, 0.54, 0.80, 1.0);
  gfx_set(1,1,1,1);
) : (
  draw_panel_box(ph_x, ph_y, ph_w, ph_h, 0.14, 0.15, 0.22, 0.26, 0.28, 0.38);
  gfx_set(0.72, 0.76, 0.86, 1);
);
gfx_setfont(5); gfx_measurestr("INV", tw, th);
gfx_x = ph_x + (ph_w - tw)*0.5; gfx_y = ph_y + (ph_h - th)*0.5; gfx_drawstr("INV");

sprintf(#ig_s, "%+.1f dB", in_gain_db);
new_ig = draw_console_knob(1, cx_1, row1_cy, r_knb, in_gain_db, -20.0, 20.0, 0.0, "IN TRIM", #ig_s, 1, 0.45, 0.78, 0.98);
abs(new_ig - in_gain_db) > 0.01 ? ( in_gain_db = new_ig; update_parameters(); slider_automate(slider1); );

hpf_hz <= 21.0 ? strcpy(#hp_s, "OUT") : sprintf(#hp_s, "%d Hz", hpf_hz);
new_hp = draw_console_knob(2, cx_1, row2_cy, r_knb, hpf_hz, 20.0, 500.0, 20.0, "HPF 18dB", #hp_s, 0, 0.45, 0.78, 0.98);
abs(new_hp - hpf_hz) > 0.1 ? ( hpf_hz = new_hp; update_parameters(); slider_automate(slider3); );

lpf_hz >= 21500.0 ? strcpy(#lp_s, "OUT") : sprintf(#lp_s, "%.1f kHz", lpf_hz * 0.001);
new_lp = draw_console_knob(3, cx_1, row3_cy, r_knb, lpf_hz, 3000.0, 22000.0, 22000.0, "LPF 12dB", #lp_s, 0, 0.45, 0.78, 0.98);
abs(new_lp - lpf_hz) > 1.0 ? ( lpf_hz = new_lp; update_parameters(); slider_automate(slider4); );

// -------------------------------------------------------------------------
// COLUMN 2: LF BAND (GAIN, FREQ 40-600Hz, SHELF/BELL)
// -------------------------------------------------------------------------
x_c2 = x_c1 + col_w + col_gap;
draw_col_header(x_c2, col_w, "LF BAND", 0.54, 0.71, 0.98, 1);
cx_2 = x_c2 + col_w * 0.5;

sprintf(#lfg_s, "%+.1f dB", lf_gain_db);
new_lfg = draw_console_knob(4, cx_2, row1_cy, r_knb, lf_gain_db, -20.0, 20.0, 0.0, "LF GAIN", #lfg_s, 1, 0.54, 0.71, 0.98);
abs(new_lfg - lf_gain_db) > 0.01 ? ( lf_gain_db = new_lfg; update_parameters(); slider_automate(slider6); );

sprintf(#lff_s, "%d Hz", lf_freq_hz);
new_lff = draw_console_knob(5, cx_2, row2_cy, r_knb, lf_freq_hz, 40.0, 600.0, 100.0, "LF FREQ", #lff_s, 0, 0.54, 0.71, 0.98);
abs(new_lff - lf_freq_hz) > 0.5 ? ( lf_freq_hz = new_lff; update_parameters(); slider_automate(slider7); );

b_btn_w = col_w - floor(20 * S); b_btn_h = floor(32 * S);
b_btn_x = x_c2 + floor(10 * S);  b_btn_y = row3_cy - b_btn_h * 0.5;
(mouse_cap & 1) && !(last_mouse_cap & 1) &&
(mouse_x >= b_btn_x && mouse_x <= b_btn_x + b_btn_w && mouse_y >= b_btn_y && mouse_y <= b_btn_y + b_btn_h) ? (
  lf_bell = !lf_bell; update_parameters(); slider_automate(slider8);
);
lf_bell ? (
  draw_panel_box(b_btn_x, b_btn_y, b_btn_w, b_btn_h, 0.16, 0.36, 0.62, 0.54, 0.78, 1.0);
  strcpy(#lfb_s, "SHAPE: BELL");
) : (
  draw_panel_box(b_btn_x, b_btn_y, b_btn_w, b_btn_h, 0.14, 0.15, 0.22, 0.26, 0.28, 0.38);
  strcpy(#lfb_s, "SHAPE: SHELF");
);
gfx_setfont(4); gfx_set(0.95, 0.96, 1.0, 1.0);
gfx_measurestr(#lfb_s, tw, th);
gfx_x = b_btn_x + (b_btn_w - tw)*0.5; gfx_y = b_btn_y + (b_btn_h - th)*0.5;
gfx_drawstr(#lfb_s);

// -------------------------------------------------------------------------
// COLUMN 3: LMF BAND (GAIN, FREQ 200-2.5k, Q)
// -------------------------------------------------------------------------
x_c3 = x_c2 + col_w + col_gap;
draw_col_header(x_c3, col_w, "LMF BAND", 0.54, 0.71, 0.98, 2);
cx_3 = x_c3 + col_w * 0.5;

sprintf(#lmg_s, "%+.1f dB", lmf_gain_db);
new_lmg = draw_console_knob(6, cx_3, row1_cy, r_knb, lmf_gain_db, -20.0, 20.0, 0.0, "LMF GAIN", #lmg_s, 1, 0.54, 0.71, 0.98);
abs(new_lmg - lmf_gain_db) > 0.01 ? ( lmf_gain_db = new_lmg; update_parameters(); slider_automate(slider9); );

lmf_freq_hz >= 1000 ? sprintf(#lmf_s, "%.2f kHz", lmf_freq_hz * 0.001) : sprintf(#lmf_s, "%d Hz", lmf_freq_hz);
new_lmf = draw_console_knob(7, cx_3, row2_cy, r_knb, lmf_freq_hz, 200.0, 2500.0, 600.0, "LMF FREQ", #lmf_s, 0, 0.54, 0.71, 0.98);
abs(new_lmf - lmf_freq_hz) > 1.0 ? ( lmf_freq_hz = new_lmf; update_parameters(); slider_automate(slider10); );

sprintf(#lmq_s, "Q: %.2f", lmf_q);
new_lmq = draw_console_knob(8, cx_3, row3_cy, r_knb, lmf_q, 0.4, 3.0, 1.0, "LMF Q", #lmq_s, 0, 0.54, 0.71, 0.98);
abs(new_lmq - lmf_q) > 0.01 ? ( lmf_q = new_lmq; update_parameters(); slider_automate(slider11); );

// -------------------------------------------------------------------------
// COLUMN 4: HMF BAND (GAIN, FREQ 600-7k, Q)
// -------------------------------------------------------------------------
x_c4 = x_c3 + col_w + col_gap;
draw_col_header(x_c4, col_w, "HMF BAND", 0.54, 0.71, 0.98, 3);
cx_4 = x_c4 + col_w * 0.5;

sprintf(#hmg_s, "%+.1f dB", hmf_gain_db);
new_hmg = draw_console_knob(9, cx_4, row1_cy, r_knb, hmf_gain_db, -20.0, 20.0, 0.0, "HMF GAIN", #hmg_s, 1, 0.54, 0.71, 0.98);
abs(new_hmg - hmf_gain_db) > 0.01 ? ( hmf_gain_db = new_hmg; update_parameters(); slider_automate(slider12); );

hmf_freq_hz >= 1000 ? sprintf(#hmf_s, "%.2f kHz", hmf_freq_hz * 0.001) : sprintf(#hmf_s, "%d Hz", hmf_freq_hz);
new_hmf = draw_console_knob(10, cx_4, row2_cy, r_knb, hmf_freq_hz, 600.0, 7000.0, 2500.0, "HMF FREQ", #hmf_s, 0, 0.54, 0.71, 0.98);
abs(new_hmf - hmf_freq_hz) > 1.0 ? ( hmf_freq_hz = new_hmf; update_parameters(); slider_automate(slider13); );

sprintf(#hmq_s, "Q: %.2f", hmf_q);
new_hmq = draw_console_knob(11, cx_4, row3_cy, r_knb, hmf_q, 0.4, 3.0, 1.0, "HMF Q", #hmq_s, 0, 0.54, 0.71, 0.98);
abs(new_hmq - hmf_q) > 0.01 ? ( hmf_q = new_hmq; update_parameters(); slider_automate(slider14); );

// -------------------------------------------------------------------------
// COLUMN 5: HF BAND (GAIN, FREQ 1.5k-20k, SHELF/BELL)
// -------------------------------------------------------------------------
x_c5 = x_c4 + col_w + col_gap;
draw_col_header(x_c5, col_w, "HF BAND", 0.54, 0.71, 0.98, 4);
cx_5 = x_c5 + col_w * 0.5;

sprintf(#hfg_s, "%+.1f dB", hf_gain_db);
new_hfg = draw_console_knob(12, cx_5, row1_cy, r_knb, hf_gain_db, -20.0, 20.0, 0.0, "HF GAIN", #hfg_s, 1, 0.54, 0.71, 0.98);
abs(new_hfg - hf_gain_db) > 0.01 ? ( hf_gain_db = new_hfg; update_parameters(); slider_automate(slider15); );

sprintf(#hff_s, "%.1f kHz", hf_freq_hz * 0.001);
new_hff = draw_console_knob(13, cx_5, row2_cy, r_knb, hf_freq_hz, 1500.0, 20000.0, 8000.0, "HF FREQ", #hff_s, 0, 0.54, 0.71, 0.98);
abs(new_hff - hf_freq_hz) > 5.0 ? ( hf_freq_hz = new_hff; update_parameters(); slider_automate(slider16); );

b_btn_x5 = x_c5 + floor(10 * S);
(mouse_cap & 1) && !(last_mouse_cap & 1) &&
(mouse_x >= b_btn_x5 && mouse_x <= b_btn_x5 + b_btn_w && mouse_y >= b_btn_y && mouse_y <= b_btn_y + b_btn_h) ? (
  hf_bell = !hf_bell; update_parameters(); slider_automate(slider17);
);
hf_bell ? (
  draw_panel_box(b_btn_x5, b_btn_y, b_btn_w, b_btn_h, 0.16, 0.36, 0.62, 0.54, 0.78, 1.0);
  strcpy(#hfb_s, "SHAPE: BELL");
) : (
  draw_panel_box(b_btn_x5, b_btn_y, b_btn_w, b_btn_h, 0.14, 0.15, 0.22, 0.26, 0.28, 0.38);
  strcpy(#hfb_s, "SHAPE: SHELF");
);
gfx_setfont(4); gfx_set(0.95, 0.96, 1.0, 1.0);
gfx_measurestr(#hfb_s, tw, th);
gfx_x = b_btn_x5 + (b_btn_w - tw)*0.5; gfx_y = b_btn_y + (b_btn_h - th)*0.5;
gfx_drawstr(#hfb_s);

// -------------------------------------------------------------------------
// COLUMN 6: AIR BAND (2.5k-40k) & SUB 10Hz — Champagne Gold Accent (#F9E2AF)
// -------------------------------------------------------------------------
x_c6 = x_c5 + col_w + col_gap;
draw_col_header(x_c6, col_w, "AIR & SUB", 0.98, 0.89, 0.69, 5);
cx_6 = x_c6 + col_w * 0.5;

sprintf(#ag_s, "+%.1f dB", air_gain_db);
new_ag = draw_console_knob(14, cx_6, row1_cy, r_knb, air_gain_db, 0.0, 20.0, 0.0, "AIR GAIN", #ag_s, 0, 0.98, 0.89, 0.69);
abs(new_ag - air_gain_db) > 0.01 ? ( air_gain_db = new_ag; update_parameters(); slider_automate(slider18); );

af_btn_y = row2_cy - floor(18 * S);
af_btn_h = floor(36 * S);
af_btn_x = x_c6 + floor(10 * S);
(mouse_cap & 1) && !(last_mouse_cap & 1) &&
(mouse_x >= af_btn_x && mouse_x <= af_btn_x + b_btn_w && mouse_y >= af_btn_y && mouse_y <= af_btn_y + af_btn_h) ? (
  air_freq_idx = (air_freq_idx + 1) % 5;
  update_parameters();
  slider_automate(slider19);
);
draw_panel_box(af_btn_x, af_btn_y, b_btn_w, af_btn_h, 0.24, 0.22, 0.16, 0.98, 0.89, 0.69);
air_freq_idx == 0 ? strcpy(#af_s, "AIR: 2.5 kHz") :
air_freq_idx == 1 ? strcpy(#af_s, "AIR: 5 kHz")   :
air_freq_idx == 2 ? strcpy(#af_s, "AIR: 10 kHz")  :
air_freq_idx == 3 ? strcpy(#af_s, "AIR: 20 kHz")  :
                    strcpy(#af_s, "AIR: 40 kHz");
gfx_setfont(4); gfx_set(0.98, 0.94, 0.82, 1.0);
gfx_measurestr(#af_s, tw, th);
gfx_x = af_btn_x + (b_btn_w - tw)*0.5; gfx_y = af_btn_y + (af_btn_h - th)*0.5;
gfx_drawstr(#af_s);

sprintf(#sb_s, "%+.1f dB", sub_gain_db);
new_sb = draw_console_knob(15, cx_6, row3_cy, r_knb, sub_gain_db, -4.5, 15.0, 0.0, "SUB 10 Hz", #sb_s, 1, 0.98, 0.89, 0.69);
abs(new_sb - sub_gain_db) > 0.01 ? ( sub_gain_db = new_sb; update_parameters(); slider_automate(slider5); );

// -------------------------------------------------------------------------
// COLUMN 7: OUTPUT SECTION (WIDTH, PAN, OUTPUT + SIGNAL/PEAK LEDS)
// -------------------------------------------------------------------------
x_c7 = x_c6 + col_w + col_gap;
draw_col_header(x_c7, col_w, "OUTPUT", 0.45, 0.78, 0.98, 0);
cx_7 = x_c7 + col_w * 0.5;

sig_on = K_TO_DB(env_out) > -40.0;
gfx_set(sig_on ? 0.40 : 0.15, sig_on ? 0.88 : 0.22, sig_on ? 0.60 : 0.18, 1.0);
gfx_circle(x_c7 + col_w - floor(26 * S), strip_y + floor(15 * S), floor(4 * S), 1, 1);

gfx_set(peak_led_latched ? 0.95 : 0.25, peak_led_latched ? 0.35 : 0.15, peak_led_latched ? 0.45 : 0.18, 1.0);
gfx_circle(x_c7 + col_w - floor(12 * S), strip_y + floor(15 * S), floor(4 * S), 1, 1);

(mouse_cap & 1) && !(last_mouse_cap & 1) &&
(mouse_x >= x_c7 && mouse_x <= x_c7 + col_w && mouse_y >= strip_y && mouse_y <= strip_y + 28) ? (
  peak_led_latched = 0;
);

sprintf(#wd_s, "%d %%", stereo_width);
new_wd = draw_console_knob(16, cx_7, row1_cy, r_knb, stereo_width, 0.0, 200.0, 100.0, "M/S WIDTH", #wd_s, 1, 0.45, 0.78, 0.98);
abs(new_wd - stereo_width) > 0.5 ? ( stereo_width = new_wd; update_parameters(); slider_automate(slider23); );

abs(out_pan) < 0.5 ? strcpy(#pn_s, "Center") :
out_pan < 0.0 ? sprintf(#pn_s, "%d L", abs(out_pan)) : sprintf(#pn_s, "%d R", out_pan);
new_pn = draw_console_knob(17, cx_7, row2_cy, r_knb, out_pan, -100.0, 100.0, 0.0, "PAN", #pn_s, 1, 0.45, 0.78, 0.98);
abs(new_pn - out_pan) > 0.5 ? ( out_pan = new_pn; update_parameters(); slider_automate(slider24); );

sprintf(#og_s, "%+.1f dB", out_gain_db);
new_og = draw_console_knob(18, cx_7, row3_cy, r_knb, out_gain_db, -20.0, 20.0, 0.0, "OUTPUT", #og_s, 1, 0.45, 0.78, 0.98);
abs(new_og - out_gain_db) > 0.01 ? ( out_gain_db = new_og; update_parameters(); slider_automate(slider25); );

// =========================================================================
// 4. INFO OVERLAY MODAL (Click CONSOLEQ Logo to Toggle)
// =========================================================================
info_open ? (
  mw = floor(W * 0.72);
  mh = floor(290 * S);
  mx = (W - mw) * 0.5;
  my = (H - mh) * 0.5;

  draw_panel_box(mx, my, mw, mh, 0.07, 0.07, 0.11, 0.45, 0.78, 0.98);

  gfx_setfont(1);
  gfx_set(0.45, 0.78, 0.98, 1.0);
  gfx_x = mx + 24; gfx_y = my + 20;
  gfx_drawstr("ConsoleQ v1.1 (Hybrid Console EQ, Air Strip & FFT Analyzer)");

  gfx_setfont(3);
  gfx_set(0.92, 0.94, 0.98, 1.0);
  lh_step = floor(27 * S);
  ty = my + 62;
  gfx_x = mx + 24; gfx_y = ty;             gfx_drawstr("• 4-Band Console EQ (LF, LMF, HMF, HF) + 18dB HPF & 12dB LPF");
  gfx_x = mx + 24; gfx_y = ty + lh_step;   gfx_drawstr("• Real-time 2048-point FFT Spectrum Analyzer (Post-EQ / Pre-EQ / Off)");
  gfx_x = mx + 24; gfx_y = ty + lh_step*2; gfx_drawstr("• Switchable E-Series (Constant Q) and G-Series (Proportional Q) curves");
  gfx_x = mx + 24; gfx_y = ty + lh_step*3; gfx_drawstr("• High-headroom AIR BAND (2.5k to 40kHz) + SUB 10Hz weight bell");
  gfx_x = mx + 24; gfx_y = ty + lh_step*4; gfx_drawstr("• Drag the LF, LMF, HMF, and HF nodes directly inside the top EQ graph");
  gfx_x = mx + 24; gfx_y = ty + lh_step*5; gfx_drawstr("• Hold any column's [S] button to solo & audition that frequency band");

  gfx_set(0.58, 0.68, 0.82, 1.0);
  gfx_x = mx + 24; gfx_y = my + mh - 34;
  gfx_drawstr("Click anywhere on this card or the header logo to close.");

  (mouse_cap & 1) && !(last_mouse_cap & 1) &&
  (mouse_x >= mx && mouse_x <= mx + mw && mouse_y >= my && mouse_y <= my + mh) ? (
    info_open = 0;
  );
);

last_mouse_cap = mouse_cap;
