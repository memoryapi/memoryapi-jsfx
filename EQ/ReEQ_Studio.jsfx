        ) : (
          Band_Group2 == 0 || Band_Group2 == 3 ? spl0 = band3.filter.svf_svf0(spl0);
          Band_Group2 == 0 || Band_Group2 == 4 ? spl1 = band3.filter.svf_svf1(spl1);
        )
      );
