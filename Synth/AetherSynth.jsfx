desc:AetherSynth (Polyphonic Unison & ZDF Analog Synthesizer)
// @description AetherSynth (Polyphonic Unison & ZDF Analog Synthesizer)
// @author MemoryAPI
// @version 1.1.0
// @changelog Initial release in repository
// @about
//   # AetherSynth
//   8-Voice polyphonic unison and Zero-Delay Feedback (ZDF) analog synthesizer with multi-wave supersaw, FM/Sync oscillator, vintage ladder filters, dual envelopes, and onboard master effects.
//
//   ### Features
//   - 8-Voice Polyphony: Polyphonic, Mono, and Legato voice allocation with portamento glide and organic analog drift/slop
//   - Dual Oscillators & Sub/Noise:
//     - Oscillator 1: Stepped octaves (-2 to +2), 1-7 Unison voices with variable detune and stereo spread
//     - Oscillator 2: Hard sync, linear FM, ring modulation, pulse width modulation (PWM), and fine tuning
//     - Dedicated sub-oscillator (-1 / -2 octaves) and analog white noise generator
//   - 3 Zero-Delay Feedback (ZDF) Filter Topologies:
//     - Ladder 24dB: Classic fat Moog-style transistor ladder with non-linear saturation
//     - Bite Screamer: Aggressive MS-20 style resonant filter with screaming feedback
//     - Uhbie Morph: Continuous multi-mode 12dB filter morphing between Low-Pass, Band-Pass, and High-Pass
//   - Interactive Filter Display: Real-time frequency response visualization
//   - Dual Modulation Envelopes:
//     - Amp ADSR and Mod ADSR with live visual envelope trace
//   - Dual LFOs: Sine, Triangle, Saw, Square, and Random S&H targeting pitch vibrato, PWM, and filter cutoff
//   - Master FX Engine: Analog distortion, stereo chorus, tempo/free ping-pong delay, and algorithmic hall reverb
//   - Built-In Factory Soundbank: 8 production-ready patches (Anthem Supersaw, Diva Ladder Bass, Acid 303, Jupiter Pad, etc.)
//   - Interactive 4-Octave Keyboard: Playable onscreen piano keys with active voice indicator
//   - Scalable HiDPI UI: Clean vector layout with selectable UI zoom (100% - 150%)
// @provides
//   [effect] AetherSynth.jsfx

options:maxmem=2097152

// Oscillator 1 (Unison Supersaw / Multi-Wave)
slider1:osc1_wave=0<0,4,1{Saw,Pulse,Triangle,Sine,TriWrap}>-Osc 1 Wave
slider2:osc1_oct=0<-2,2,1>-Osc 1 Octave
slider3:osc1_uni=5<1,7,1>-Osc 1 Unison Voices
slider4:osc1_det=28<0,100,0.1>-Osc 1 Unison Detune (%)
slider5:osc1_spr=80<0,100,0.1>-Osc 1 Stereo Spread (%)
slider6:osc1_lvl=85<0,100,0.1>-Osc 1 Level (%)

// Oscillator 2 (Sync / FM / Ring / PW)
slider7:osc2_wave=1<0,4,1{Saw,Pulse,Triangle,Sine,TriWrap}>-Osc 2 Wave
slider8:osc2_oct=0<-2,2,1>-Osc 2 Octave
slider9:osc2_semi=0<-12,12,1>-Osc 2 Semitone
slider10:osc2_fine=8<-50,50,0.1>-Osc 2 Fine (Cents)
slider11:osc2_pw=50<5,95,0.1>-Osc 2 Pulse Width (%)
slider12:osc2_lvl=60<0,100,0.1>-Osc 2 Level (%)
slider13:osc_sync=0<0,1,1{Off,Hard Sync}>-Osc 1->2 Sync
slider14:osc_fm=0<0,100,0.1>-Osc 1->2 FM (%)
slider15:osc_ring=0<0,1,1{Off,Ring Mod}>-Ring Mod

// Sub & Noise
slider16:sub_lvl=35<0,100,0.1>-Sub Osc Level (%)
slider17:sub_oct=0<0,1,1{-1 Oct,-2 Oct}>-Sub Octave
slider18:noise_lvl=8<0,100,0.1>-Noise Level (%)

// ZDF Filter Section (Ladder / Bite / Uhbie)
slider19:flt_model=0<0,2,1{Ladder 24dB,Bite Screamer,Uhbie Morph}>-Filter Model
slider20:flt_mode=0<0,2,1{Low-Pass,Band-Pass,High-Pass}>-Filter Mode / Morph
slider21:flt_cut_hz=2800<20,20000,1>-Filter Cutoff (Hz)
slider22:flt_res_pct=25<0,100,0.1>-Filter Resonance (%)
slider23:flt_drv_pct=20<0,100,0.1>-Filter Drive / Feedback (%)
slider24:flt_key_pct=40<0,100,0.1>-Filter Keytrack (%)
slider25:flt_env_amt=45<-100,100,0.1>-Filter Env 2 Mod (%)
slider26:flt_lfo_amt=0<-100,100,0.1>-Filter LFO 2 Mod (%)

// Envelopes (Env 1 = Amp, Env 2 = Filter/Mod)
slider27:env1_a=5<1,4000,1>-Amp Attack (ms)
slider28:env1_d=350<5,5000,1>-Amp Decay (ms)
slider29:env1_s=70<0,100,0.1>-Amp Sustain (%)
slider30:env1_r=280<5,8000,1>-Amp Release (ms)

slider31:env2_a=5<1,4000,1>-Mod Attack (ms)
slider32:env2_d=420<5,5000,1>-Mod Decay (ms)
slider33:env2_s=20<0,100,0.1>-Mod Sustain (%)
slider34:env2_r=320<5,8000,1>-Mod Release (ms)
slider35:env2_pitch=0<-24,24,0.1>-Mod Env -> Osc 2 Pitch (st)

// LFO 1 (Vibrato / PWM) & LFO 2 (Filter / Tremolo)
slider36:lfo1_wave=0<0,4,1{Sine,Triangle,Saw,Square,Random S&H}>-LFO 1 Wave
slider37:lfo1_rate=4.5<0.1,20,0.05>-LFO 1 Rate (Hz)
slider38:lfo1_pitch=0<0,100,0.1>-LFO 1 -> Vibrato (%)
slider39:lfo1_pwm=15<0,100,0.1>-LFO 1 -> PWM (%)

slider40:lfo2_wave=0<0,4,1{Sine,Triangle,Saw,Square,Random S&H}>-LFO 2 Wave
slider41:lfo2_rate=1.2<0.1,20,0.05>-LFO 2 Rate (Hz)

// Voice, Glide, Analog Trimmers & Master FX
slider42:voice_mode=0<0,2,1{Poly 8,Mono,Legato}>-Voice Mode
slider43:glide_ms=25<0,500,1>-Portamento Glide (ms)
slider44:slop_pct=22<0,100,0.1>-Analog Slop / Drift (%)
slider45:fx_dist_pct=15<0,100,0.1>-FX Distortion (%)
slider46:fx_chor_pct=40<0,100,0.1>-FX Stereo Chorus (%)
slider47:fx_del_pct=25<0,100,0.1>-FX Ping-Pong Delay (%)
slider48:fx_del_ms=320<30,800,1>-FX Delay Time (ms)
slider49:fx_rev_pct=28<0,100,0.1>-FX Hall Reverb (%)
slider50:fx_rev_dec=45<0,100,0.1>-FX Reverb Decay (%)
slider51:master_db=0<-24,12,0.1>-Master Output (dB)
slider52:preset_idx=0<0,7,1{1. Anthem Supersaw,2. Diva Ladder Bass,3. Acid Bite 303,4. Warm Jupiter Pad,5. Sync Screamer,6. Pluck Poly Arp,7. Neuro Sub Reese,8. Vintage Keys}>-Factory Patch
slider53:ui_zoom=1.25<1.0,1.5,0.25>-UI Scale

in_pin:Left Input
in_pin:Right Input
out_pin:Left Output
out_pin:Right Output

@init
ext_noinit = 1.0;

MAX_VOICES = 8;
MIN_FREQ   = 20.0;
MAX_FREQ   = 20000.0;
LOG_MIN    = log(MIN_FREQ);
LOG_MAX    = log(MAX_FREQ);

function DB_TO_K(x) ( 10 ^ (x / 20.0) );

// Per-Voice State Arrays (stride = 32 floats per voice, base = 1000)
V_BASE   = 1000;
V_STRIDE = 32;

uni_det_tbl = 200;
uni_det_tbl[0] =  0.00;
uni_det_tbl[1] = -0.38; uni_det_tbl[2] =  0.38;
uni_det_tbl[3] = -0.74; uni_det_tbl[4] =  0.74;
uni_det_tbl[5] = -1.00; uni_det_tbl[6] =  1.00;

uni_pan_tbl = 220;
uni_pan_tbl[0] =  0.00;
uni_pan_tbl[1] = -0.55; uni_pan_tbl[2] =  0.55;
uni_pan_tbl[3] = -0.85; uni_pan_tbl[4] =  0.85;
uni_pan_tbl[5] = -1.00; uni_pan_tbl[6] =  1.00;

SCOPE_LEN = 256;
SCOPE_BUF = 3000;

CHOR_LEN  = 4096;
CHOR_MASK = CHOR_LEN - 1;
CHOR_BASE = 8192;

DEL_LEN   = 131072;
DEL_MASK  = DEL_LEN - 1;
DEL_BASE  = CHOR_BASE + (CHOR_LEN * 2);

REV_LEN   = 16384;
REV_MASK  = REV_LEN - 1;
RV_L1 = DEL_BASE + (DEL_LEN * 2);
RV_L2 = RV_L1 + REV_LEN;
RV_L3 = RV_L2 + REV_LEN;
RV_L4 = RV_L3 + REV_LEN;
RV_R1 = RV_L4 + REV_LEN;
RV_R2 = RV_R1 + REV_LEN;
RV_R3 = RV_R2 + REV_LEN;
RV_R4 = RV_R3 + REV_LEN;

function poly_blep(t, dt) (
  t < dt ? (
    t = t / dt;
    t + t - t * t - 1.0;
  ) : (t > 1.0 - dt) ? (
    t = (t - 1.0) / dt;
    t * t + t + t + 1.0;
  ) : 0.0;
);

function osc_eval(ph, dt, wave_type, pw)
  local(y, p2, tri_raw)
(
  wave_type == 0 ? (
    y = 2.0 * ph - 1.0;
    y -= poly_blep(ph, dt);
  ) : wave_type == 1 ? (
    y = (ph < pw) ? 1.0 : -1.0;
    y += poly_blep(ph, dt);
    p2 = ph - pw; p2 < 0.0 ? p2 += 1.0;
    y -= poly_blep(p2, dt);
  ) : wave_type == 2 ? (
    y = 1.0 - 4.0 * abs(ph - 0.5);
  ) : wave_type == 3 ? (
    y = sin(2.0 * $pi * ph);
  ) : (
    tri_raw = (1.0 - 4.0 * abs(ph - 0.5)) * 1.65;
    y = tri_raw > 1.0 ? (2.0 - tri_raw) : tri_raw < -1.0 ? (-2.0 - tri_raw) : tri_raw;
  );
  y;
);

function fast_tanh(x) local(x2) (
  x = max(-3.0, min(3.0, x));
  x2 = x * x;
  x * (27.0 + x2) / (27.0 + 9.0 * x2);
);

function notify_all_sliders() (
  slider_automate(slider1);  slider_automate(slider2);  slider_automate(slider3);
  slider_automate(slider4);  slider_automate(slider5);  slider_automate(slider6);
  slider_automate(slider7);  slider_automate(slider8);  slider_automate(slider9);
  slider_automate(slider10); slider_automate(slider11); slider_automate(slider12);
  slider_automate(slider13); slider_automate(slider14); slider_automate(slider15);
  slider_automate(slider16); slider_automate(slider17); slider_automate(slider18);
  slider_automate(slider19); slider_automate(slider20); slider_automate(slider21);
  slider_automate(slider22); slider_automate(slider23); slider_automate(slider24);
  slider_automate(slider25); slider_automate(slider26); slider_automate(slider27);
  slider_automate(slider28); slider_automate(slider29); slider_automate(slider30);
  slider_automate(slider31); slider_automate(slider32); slider_automate(slider33);
  slider_automate(slider34); slider_automate(slider35); slider_automate(slider36);
  slider_automate(slider37); slider_automate(slider38); slider_automate(slider39);
  slider_automate(slider40); slider_automate(slider41); slider_automate(slider42);
  slider_automate(slider43); slider_automate(slider44); slider_automate(slider45);
  slider_automate(slider46); slider_automate(slider47); slider_automate(slider48);
  slider_automate(slider49); slider_automate(slider50); slider_automate(slider51);
  slider_automate(slider52);
);

