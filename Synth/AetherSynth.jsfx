    osc_sync=0; osc_fm=0; osc_ring=0; sub_lvl=35; sub_oct=0; noise_lvl=10;
    flt_model=0; flt_mode=0; flt_cut_hz=5500; flt_res_pct=18; flt_drv_pct=22; flt_key_pct=50;
    flt_env_amt=40; flt_lfo_amt=0;
    env1_a=5; env1_d=600; env1_s=80; env1_r=420;
    env2_a=5; env2_d=450; env2_s=25; env2_r=350; env2_pitch=0;
    voice_mode=0; glide_ms=20; slop_pct=20;
    fx_dist_pct=12; fx_chor_pct=45; fx_del_pct=30; fx_rev_pct=35;
