    flt_model=1; flt_mode=0; flt_cut_hz=420; flt_res_pct=82; flt_drv_pct=65; flt_key_pct=40;
    flt_env_amt=72; flt_lfo_amt=15;
    env1_a=2; env1_d=240; env1_s=20; env1_r=80;
    env2_a=3; env2_d=190; env2_s=0; env2_r=90; env2_pitch=0;
    voice_mode=2; glide_ms=65; slop_pct=25;
