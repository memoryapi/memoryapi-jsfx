    osc2_wave=1; osc2_oct=-1; osc2_semi=0; osc2_fine=7; osc2_pw=32; osc2_lvl=80;
    osc_sync=0; osc_fm=0; osc_ring=0; sub_lvl=65; sub_oct=0; noise_lvl=4;
    flt_model=0; flt_mode=0; flt_cut_hz=320; flt_res_pct=42; flt_drv_pct=45; flt_key_pct=35;
    flt_env_amt=62; flt_lfo_amt=0;
    env1_a=2; env1_d=280; env1_s=45; env1_r=110;
    env2_a=2; env2_d=220; env2_s=10; env2_r=120; env2_pitch=0;
