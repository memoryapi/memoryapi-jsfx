draw_panel_box(eq_btn_x, slp_btn_y, eq_btn_w, eq_btn_h, 0.14, 0.15, 0.22, 0.30, 0.34, 0.46);
m_slope_hard ? strcpy(#sl_s, "CUT: HARD") : strcpy(#sl_s, "CUT: SOFT");
gfx_measurestr(#sl_s, tw, th); gfx_x = eq_btn_x + (eq_btn_w - tw)*0.5; gfx_y = slp_btn_y + (eq_btn_h - th)*0.5; gfx_drawstr(#sl_s);

draw_panel_box(eq_btn_x, tm_btn_y, eq_btn_w, eq_btn_h, 0.14, 0.15, 0.22, 0.30, 0.34, 0.46);
m_tone_mode == 0 ? strcpy(#tm_s, "TONE: TILT") : strcpy(#tm_s, "TONE: MID");
gfx_measurestr(#tm_s, tw, th); gfx_x = eq_btn_x + (eq_btn_w - tw)*0.5; gfx_y = tm_btn_y + (eq_btn_h - th)*0.5; gfx_drawstr(#tm_s);

// Low-Cut, High-Cut, and Tone Knobs
sprintf(#v_s, "%d Hz", m_locut_hz);
new_v = draw_vf_knob(702, pad + full_w * 0.34, mst_cy, r_mst, m_locut_hz, 20, 1000, 20, "LOW CUT", #v_s, 0, 0.54, 0.71, 0.98, eq_on);
abs(new_v - m_locut_hz) > 1.0 ? ( m_locut_hz = new_v; update_parameters(); slider_automate(slider46); );

sprintf(#v_s, "%.1f kHz", m_hicut_hz * 0.001);
new_v = draw_vf_knob(703, pad + full_w * 0.48, mst_cy, r_mst, m_hicut_hz, 1000, 20000, 20000, "HIGH CUT", #v_s, 0, 0.54, 0.71, 0.98, eq_on);
abs(new_v - m_hicut_hz) > 5.0 ? ( m_hicut_hz = new_v; update_parameters(); slider_automate(slider47); );

sprintf(#v_s, "%+.0f", m_tone_val);
new_v = draw_vf_knob(704, pad + full_w * 0.62, mst_cy, r_mst, m_tone_val, -100, 100, 0, "TONE", #v_s, 1, 0.54, 0.71, 0.98, eq_on);
abs(new_v - m_tone_val) > 0.1 ? ( m_tone_val = new_v; update_parameters(); slider_automate(slider49); );

// Vertical Divider
gfx_set(0.18, 0.20, 0.28, 1.0);
gfx_line(pad + full_w * 0.71, mst_y + 10, pad + full_w * 0.71, mst_y + mst_h - 10);

// 3. OUTPUT WIDTH & GAIN
sprintf(#v_s, "%d %%", m_width_pct);
new_v = draw_vf_knob(705, pad + full_w * 0.80, mst_cy, r_mst, m_width_pct, 0, 200, 100, "WIDTH", #v_s, 1, 0.54, 0.71, 0.98, 1);
abs(new_v - m_width_pct) > 0.5 ? ( m_width_pct = new_v; slider_automate(slider51); );

sprintf(#v_s, "%+.1f dB", out_gain_db);
new_v = draw_vf_knob(706, pad + full_w * 0.92, mst_cy, r_mst, out_gain_db, -18, 18, 0, "OUT GAIN", #v_s, 1, 0.54, 0.71, 0.98, 1);
abs(new_v - out_gain_db) > 0.05 ? ( out_gain_db = new_v; update_parameters(); slider_automate(slider52); );

// =========================================================================
// 4. INFO OVERLAY MODAL (Click VINTAGEFLUX Logo to Toggle)
// =========================================================================
info_open ? (
  mw = floor(W * 0.72);
  mh = floor(290 * S);
  mx = (W - mw) * 0.5;
  my = (H - mh) * 0.5;

  draw_panel_box(mx, my, mw, mh, 0.07, 0.07, 0.11, 0.98, 0.70, 0.53);

  gfx_setfont(1);
  gfx_set(0.98, 0.70, 0.53, 1.0);
  gfx_x = mx + 24; gfx_y = my + 20;
  gfx_drawstr("VintageFlux v1.0 (6-Module Lo-Fi & Retro Multi-FX)");

  gfx_setfont(3);
  gfx_set(0.92, 0.94, 0.98, 1.0);
  lh_step = floor(26 * S);
  ty = my + 60;
  gfx_x = mx + 24; gfx_y = ty;             gfx_drawstr("• MAGNITUDE slider scales all 6 modules & master tone simultaneously");
  gfx_x = mx + 24; gfx_y = ty + lh_step;   gfx_drawstr("• 6 Modules: Noise, Wobble, Distort, Digital, Space, and Magnetic");
  gfx_x = mx + 24; gfx_y = ty + lh_step*2; gfx_drawstr("• Click any module header (1-6) to toggle bypass; moving its Big Knob auto-enables");
  gfx_x = mx + 24; gfx_y = ty + lh_step*3; gfx_drawstr("• FLUX knobs add organic, non-repeating random drift to each module");
  gfx_x = mx + 24; gfx_y = ty + lh_step*4; gfx_drawstr("• Master Section includes Soft/Hard Low & High Cuts + Tilt/Mid Tone EQ");
  gfx_x = mx + 24; gfx_y = ty + lh_step*5; gfx_drawstr("• Drag knobs vertically (hold Ctrl for fine adjustment, double-click to reset)");

  gfx_set(0.72, 0.66, 0.60, 1.0);
  gfx_x = mx + 24; gfx_y = my + mh - 32;
  gfx_drawstr("Click anywhere on this card or the header logo to close.");

  (mouse_cap & 1) && !(last_mouse_cap & 1) &&
  (mouse_x >= mx && mouse_x <= mx + mw && mouse_y >= my && mouse_y <= my + mh) ? (
    info_open = 0;
  );
);

last_mouse_cap = mouse_cap;
