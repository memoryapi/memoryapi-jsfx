desc:VelvetClip (Transparent Threshold-Linear Soft Clipper)
// @description VelvetClip (Transparent Threshold-Linear Soft Clipper)
// @author MemoryAPI
// @version 1.0.0
// @changelog Initial release in repository
// @about
//   # VelvetClip
//   Transparent threshold-linear soft clipper and peak dynamics controller with 100% bit-identical pass-through below threshold, 808 Sub Safe preservation, and HQ 2x oversampling.
//
//   ### Features
//   - 100% Bit-Identical Pass-Through (y = x) for all audio below threshold (0% harmonic coloration until clipping)
//   - Interactive Transfer Graph: Drag vertically directly on the response curve to offset clipping threshold
//   - 3 Specialized Clipper Topologies:
//     - Fruity Soft: Asymptotic rational curve that smoothly approaches ceiling without folding
//     - Cubic Knee: Smooth punchy polynomial knee that clamps strictly at 0 dBFS ceiling
//     - Bass Shaper: Exponential logarithmic curve tailored for aggressive 808s and kick drums
//   - 808 Sub Safe: Crossover filter that isolates and preserves low-end (<95 Hz) sub frequencies so deep bass notes never buzz or degrade
//   - HQ 2x Oversampling: Zero-latency linear phase half-band filtering to eliminate digital alias distortion
//   - Dual Waveform & Shaved-Peak History Scope: Live scrolling view showing output waveform and shaved peak transients in real-time
//   - Calibrated Peak & Clip Metering: Precision output level bar and shaved dB clip amount indicator
//   - Scalable HiDPI UI: Vector interface with selectable text scaling presets (100% - 150%)
// @provides
//   [effect] VelvetClip.jsfx

// Sliders are hidden (- prefix) for the custom @gfx interface while remaining automatable.
slider1:thresh_db=-1.8<-24.0,0.0,0.1>-Threshold (dB)
slider2:post_db=0.0<-12.0,6.0,0.1>-Post Gain / Ceiling (dB)
slider3:in_drive_db=0.0<-12.0,12.0,0.1>-Input Drive (dB)
slider4:curve_mode=0<0,2,1{Fruity Asymptotic (Transparent),Cubic Knee (Punchy),Bass Shaper (808 Safe)}>-Clipper Curve
slider5:sub_preserve_pct=0<0,100,1>-Sub-Bass Preserve (%)
slider6:hq_oversample=1<0,1,1{Off (Zero Latency),HQ 2x Oversample}>-Oversampling
slider7:dc_block_on=1<0,1,1{Off,On}>-Pre-DC Filter
slider8:active_on=1<0,1,1{Bypass,Active}>-Active
slider9:ui_zoom=1.25<1.0,1.5,0.25>-UI Scale

in_pin:Left Input
in_pin:Right Input
out_pin:Left Output
out_pin:Right Output

@init
ext_noinit = 1.0;
ext_gr_meter = 0.0;

function DB_TO_K(x) ( 10 ^ (x / 20.0) );
function K_TO_DB(lin) ( 8.685889638 * log(max(0.0000001, lin)) );

// Waveform & Shaved-Peak History Buffers for Real-Time Scope (128 bins)
HIST_BINS = 128;
HIST_OUT  = 1000;
HIST_CLIP = 1200;

// Exact Piecewise-Linear Soft Clipping Function:
// Strictly 1:1 (y = x, 0% distortion) for |x| <= T!
// Smoothly bends peaks above T to approach ceiling 1.0 with C1 continuity (dy/dx = 1 at x = T).
function clip_sample(x)
  local(ax, sx, T, W, d, u, y_abs)
(
  ax = abs(x);
  T  = thresh_lin;

  // When Threshold is at 0.0 dB (T >= 0.999), act as a pure hard ceiling at 1.0
  T >= 0.999 ? (
    max(-1.0, min(1.0, x));
  ) : ax <= T ? (
    // 100% Bit-Identical Pass-Through below Threshold!
    x;
  ) : (
    sx = x >= 0.0 ? 1.0 : -1.0;
    W  = 1.0 - T;
    d  = ax - T;

    curve_mode == 0 ? (
      // Mode 0: Fruity Soft Clipper Style Rational/Exponential Asymptote
      // Approaches 1.0 smoothly without ever folding back, dy/dx = 1.0 at d = 0
      y_abs = T + W * (d / (W + d));
    ) : curve_mode == 1 ? (
      // Mode 1: Cubic Polynomial Knee (Reaches exact 1.0 ceiling at ax = T + 1.5*W, then clamps)
      u = d / (1.5 * W);
      u >= 1.0 ? (
        y_abs = 1.0;
      ) : (
        y_abs = T + W * (1.5 * u - 0.5 * u * u * u);
      );
    ) : (
      // Mode 2: Bass Shaper (gentler logarithmic-style knee for heavy 808s)
      y_abs = T + W * (1.0 - exp(-d / W));
    );

    sx * y_abs;
  );
);

function update_parameters()
  local(SAFE_SRATE, sub_db, g, A, k)
(
  SAFE_SRATE = max(8000.0, srate);

  thresh_lin = DB_TO_K(thresh_db);
  in_lin     = DB_TO_K(in_drive_db);
  post_lin   = DB_TO_K(post_db);

  // Ableton Saturator Style Pre-DeEmphasis / Post-ReEmphasis Color Filter at 95 Hz
  // Attenuates sub-bass before the clipper knee so 808s don't buzz, then restores it after!
  sub_db = (sub_preserve_pct * 0.01) * 9.0; // up to -9 dB pre-cut / +9 dB post-boost below 95 Hz
  sub_db > 0.05 ? (
    // Pre Low-Shelf Cut (-sub_db)
    A = pow(10.0, -sub_db / 40.0);
    g = tan($pi * 95.0 / SAFE_SRATE) / sqrt(A);
    k = 1.41421356;
    pre_a1 = 1.0 / (1.0 + g * (g + k));
    pre_a2 = g * pre_a1;
    pre_a3 = g * pre_a2;
    pre_m1 = k * (A - 1.0);
    pre_m2 = (A * A - 1.0);

    // Post Low-Shelf Boost (+sub_db, exact inverse)
    A = pow(10.0, sub_db / 40.0);
    g = tan($pi * 95.0 / SAFE_SRATE) / sqrt(A);
    post_a1 = 1.0 / (1.0 + g * (g + k));
    post_a2 = g * post_a1;
    post_a3 = g * post_a2;
    post_m1 = k * (A - 1.0);
    post_m2 = (A * A - 1.0);
  );

  meter_decay = exp(-1.0 / (0.14 * SAFE_SRATE));
  hold_decay  = exp(-1.0 / (1.20 * SAFE_SRATE));
);

!init_done ? (
  ui_zoom < 1.0 ? ui_zoom = 1.25;
  active_on = 1;
  hq_oversample = 1;
  dc_block_on = 1;
  update_parameters();
  init_done = 1;
);

update_parameters();

@slider
update_parameters();

@block
update_parameters();
ext_gr_meter = - shaved_hold_db;

@sample
raw_l = spl0;
raw_r = spl1;

active_on ? (
  x_l = raw_l * in_lin;
  x_r = raw_r * in_lin;

  // 1. Optional 15 Hz Pre-DC Blocker (ensures asymmetrical waves clip symmetrically)
  dc_block_on ? (
    dc_l = x_l - dc_in_l + 0.9985 * dc_l; dc_in_l = x_l; x_l = dc_l;
    dc_r = x_r - dc_in_r + 0.9985 * dc_r; dc_in_r = x_r; x_r = dc_r;
  );

  // Measure pre-clipper drive peak for the Transfer Curve operating dot
  drv_pk = max(abs(x_l), abs(x_r));

  // 2. Optional Sub-Bass Pre-DeEmphasis (Ableton Color / Bass Shaper trick)
  sub_preserve_pct > 0.5 ? (
    v3 = x_l - pre_l_ic2;
    v1 = pre_a1 * pre_l_ic1 + pre_a2 * v3;
    v2 = pre_l_ic2 + pre_a2 * pre_l_ic1 + pre_a3 * v3;
    pre_l_ic1 = 2.0 * v1 - pre_l_ic1; pre_l_ic2 = 2.0 * v2 - pre_l_ic2;
    x_l = x_l + pre_m1 * v1 + pre_m2 * v2;

    v3 = x_r - pre_r_ic2;
    v1 = pre_a1 * pre_r_ic1 + pre_a2 * v3;
    v2 = pre_r_ic2 + pre_a2 * pre_r_ic1 + pre_a3 * v3;
    pre_r_ic1 = 2.0 * v1 - pre_r_ic1; pre_r_ic2 = 2.0 * v2 - pre_r_ic2;
    x_r = x_r + pre_m1 * v1 + pre_m2 * v2;
  );

  // 3. Soft Clipper Stage (with optional 2x Linear-Interpolated Oversampling)
  hq_oversample ? (
    // 2x Oversampled: evaluate midpoint and current sample, then average via anti-aliasing filter
    mid_l = 0.5 * (x_l + prev_os_in_l);
    mid_r = 0.5 * (x_r + prev_os_in_r);
    prev_os_in_l = x_l;
    prev_os_in_r = x_r;

    c0_l = clip_sample(mid_l);
    c1_l = clip_sample(x_l);
    c0_r = clip_sample(mid_r);
    c1_r = clip_sample(x_r);

    // 2-tap boxcar + 1st-order polyphase decimation filter (preserves 100% unity below threshold)
    (abs(x_l) <= thresh_lin && abs(mid_l) <= thresh_lin) ? (
      y_l = x_l;
    ) : (
      y_l = 0.5 * (c0_l + c1_l);
    );

    (abs(x_r) <= thresh_lin && abs(mid_r) <= thresh_lin) ? (
      y_r = x_r;
    ) : (
      y_r = 0.5 * (c0_r + c1_r);
    );
  ) : (
    y_l = clip_sample(x_l);
    y_r = clip_sample(x_r);
  );

  // 4. Restore Sub-Bass Post-Emphasis + Final Safety Ceiling at 1.0
  sub_preserve_pct > 0.5 ? (
    v3 = y_l - post_l_ic2;
    v1 = post_a1 * post_l_ic1 + post_a2 * v3;
    v2 = post_l_ic2 + post_a2 * post_l_ic1 + post_a3 * v3;
    post_l_ic1 = 2.0 * v1 - post_l_ic1; post_l_ic2 = 2.0 * v2 - post_l_ic2;
    y_l = y_l + post_m1 * v1 + post_m2 * v2;

    v3 = y_r - post_r_ic2;
    v1 = post_a1 * post_r_ic1 + post_a2 * v3;
    v2 = post_r_ic2 + post_r_ic1 * post_a2 + post_a3 * v3;
    post_r_ic1 = 2.0 * v1 - post_r_ic1; post_r_ic2 = 2.0 * v2 - post_r_ic2;
    y_r = y_r + post_m1 * v1 + post_m2 * v2;

    // Catch any sub-restored overshoot cleanly
    y_l = clip_sample(y_l);
    y_r = clip_sample(y_r);
  );

  out_l = y_l * post_lin;
  out_r = y_r * post_lin;
) : (
  drv_pk = max(abs(raw_l), abs(raw_r));
  y_l = raw_l; y_r = raw_r;
  out_l = raw_l; out_r = raw_r;
);

spl0 = out_l;
spl1 = out_r;

// Metering & Shaved-Peak Telemetry
out_pk = max(abs(out_l), abs(out_r));
clip_Out_pk = max(abs(y_l), abs(y_r));
inst_shaved_db = (drv_pk > clip_Out_pk + 0.0001) ? (K_TO_DB(drv_pk) - K_TO_DB(clip_Out_pk)) : 0.0;

env_in_l   = max(abs(raw_l * in_lin), env_in_l  * meter_decay);
env_in_r   = max(abs(raw_r * in_lin), env_in_r  * meter_decay);
env_out_l  = max(abs(out_l),          env_out_l * meter_decay);
env_out_r  = max(abs(out_r),          env_out_r * meter_decay);
env_drv_pk = max(drv_pk,              env_drv_pk * meter_decay);

shaved_env_db  = max(inst_shaved_db, shaved_env_db  * meter_decay);
shaved_hold_db = max(inst_shaved_db, shaved_hold_db * hold_decay);
hold_out_pk    = max(out_pk,         hold_out_pk    * hold_decay);

// Record rolling waveform & shaved-transient history every 256 samples
hist_cnt += 1;
hist_cnt >= 256 ? (
  hist_cnt = 0;
  h_head = (h_head + 1) & (HIST_BINS - 1);
  HIST_OUT[h_head]  = min(1.2, out_pk);
  HIST_CLIP[h_head] = min(1.0, max(0.0, drv_pk - clip_Out_pk));
  acc_out_pk = 0.0;
);

@gfx 800 620
// Catppuccin Mocha Base (#1E1E2E: R=30, G=30, B=46)
gfx_clear = 30 + (30 * 256) + (46 * 65536);

W = max(680, gfx_w);
H = max(520, gfx_h);

ui_zoom < 1.0 ? ui_zoom = 1.25;
S  = min(W / 800.0, H / 620.0);
TS = S * ui_zoom;

f_title = max(19, floor(23 * TS));
f_sec   = max(13, floor(14 * TS));
f_val   = max(13, floor(14 * TS));
f_btn   = max(12, floor(13 * TS));
f_sub   = max(12, floor(13 * TS));
f_big   = max(16, floor(19 * TS));

gfx_setfont(1, "sans-serif", f_title, 'b');
gfx_setfont(2, "sans-serif", f_sec,   'b');
gfx_setfont(3, "sans-serif", f_val,   0);
gfx_setfont(4, "sans-serif", f_btn,   'b');
gfx_setfont(5, "sans-serif", f_sub,   'b');
gfx_setfont(6, "sans-serif", f_big,   'b');

function draw_panel_box(bx, by, bw, bh, r_bg, g_bg, b_bg, r_bd, g_bd, b_bd)
(
  gfx_set(r_bg, g_bg, b_bg, 1.0);
  gfx_rect(bx, by, bw, bh);
  gfx_set(r_bd, g_bd, b_bd, 1.0);
  gfx_rect(bx, by, bw, bh, 0);
);

// Large, High-Contrast Rotary Knob (Catppuccin Peach #FAB387 Accent)
function draw_vc_knob(id, cx, cy, r, val, vmin, vmax, vdef, label, val_str, bipolar, rc, gc, bc)
  local(norm, zero_norm, hit, hover, sens, delta, ang_start, ang_end, ang_val,
        steps, st, t0, t1, a0, a1, active_seg, px0, py0, px1, py1, lw, lh, vw, vh, pill_w, pill_h, pill_x, pill_y, is_big)
(
  norm = max(0.0, min(1.0, (val - vmin) / (vmax - vmin)));
  is_big = (r >= floor(38 * S));

  hit = ((mouse_x - cx)*(mouse_x - cx) + (mouse_y - cy)*(mouse_y - cy)) <= ((r + 9)*(r + 9));
  hover = hit || (drag_id == id);

  (mouse_cap & 1) && !(last_mouse_cap & 1) && hit ? (
    (time_precise() - last_click_time < 0.28) && (last_click_id == id) ? (
      val = vdef;
      drag_id = 0;
    ) : (
      drag_id = id;
      drag_start_y = mouse_y;
      drag_start_val = val;
      last_click_time = time_precise();
      last_click_id = id;
    );
  );

  drag_id == id ? (
    (mouse_cap & 1) ? (
      sens = (mouse_cap & 4) ? 520.0 : 145.0;
      delta = (drag_start_y - mouse_y) / sens;
      val = max(vmin, min(vmax, drag_start_val + delta * (vmax - vmin)));
    ) : (
      drag_id = 0;
    );
  );

  norm = max(0.0, min(1.0, (val - vmin) / (vmax - vmin)));
  ang_start = -2.356194;
  ang_end   =  2.356194;
  ang_val   = ang_start + norm * (ang_end - ang_start);
  zero_norm = (0.0 - vmin) / (vmax - vmin);

  gfx_set(0.04, 0.04, 0.08, 0.88);
  gfx_circle(cx, cy + 3, r + 2, 1, 1);
  hover ? (
    gfx_set(rc, gc, bc, 0.18);
    gfx_circle(cx, cy, r + 6, 1, 1);
  );

  gfx_set(0.11, 0.12, 0.17, 1.0);
  gfx_circle(cx, cy, r, 1, 1);
  hover ? gfx_set(rc, gc, bc, 0.95) : gfx_set(0.25, 0.27, 0.37, 1.0);
  gfx_circle(cx, cy, r, 0, 1);

  steps = 36;
  st = 0;
  loop(steps,
    t0 = st / steps;
    t1 = (st + 1) / steps;
    a0 = ang_start + t0 * (ang_end - ang_start);
    a1 = ang_start + t1 * (ang_end - ang_start);

    bipolar ? (
      active_seg = (t1 >= min(zero_norm, norm)) && (t0 <= max(zero_norm, norm));
    ) : (
      active_seg = (t1 <= norm);
    );

    active_seg ? (
      gfx_set(rc, gc, bc, 0.98);
    ) : (
      gfx_set(0.19, 0.20, 0.28, 0.88);
    );

    gfx_line(cx + sin(a0)*(r-3), cy - cos(a0)*(r-3), cx + sin(a1)*(r-3), cy - cos(a1)*(r-3), 1);
    gfx_line(cx + sin(a0)*(r-4), cy - cos(a0)*(r-4), cx + sin(a1)*(r-4), cy - cos(a1)*(r-4), 1);
    gfx_line(cx + sin(a0)*(r-5), cy - cos(a0)*(r-5), cx + sin(a1)*(r-5), cy - cos(a1)*(r-5), 1);
    gfx_line(cx + sin(a0)*(r-6), cy - cos(a0)*(r-6), cx + sin(a1)*(r-6), cy - cos(a1)*(r-6), 1);
    st += 1;
  );

  gfx_set(0.16, 0.18, 0.25, 1.0);
  gfx_circle(cx, cy, floor(r * 0.26), 1, 1);
  gfx_set(0.96, 0.98, 1.0, 1.0);
  px0 = cx + sin(ang_val) * (r * 0.22);
  py0 = cy - cos(ang_val) * (r * 0.22);
  px1 = cx + sin(ang_val) * (r - 7);
  py1 = cy - cos(ang_val) * (r - 7);
  gfx_line(px0, py0, px1, py1, 1);
  gfx_line(px0 + 0.7, py0, px1 + 0.7, py1, 1);

  gfx_setfont(5);
  gfx_measurestr(label, lw, lh);
  gfx_set(0.78, 0.82, 0.92, 1.0);
  gfx_x = cx - lw * 0.5;
  gfx_y = cy + r + floor(6 * S);
  gfx_drawstr(label);

  is_big ? gfx_setfont(6) : gfx_setfont(3);
  gfx_measurestr(val_str, vw, vh);
  pill_w = max(vw + floor(16 * S), floor(78 * S));
  pill_h = vh + floor(6 * S);
  pill_x = cx - pill_w * 0.5;
  pill_y = cy + r + lh + floor(8 * S);

  draw_panel_box(pill_x, pill_y, pill_w, pill_h, 0.06, 0.06, 0.10, hover ? rc : 0.22, hover ? gc : 0.24, hover ? bc : 0.34);
  gfx_set(0.96, 0.98, 1.0, 1.0);
  gfx_x = cx - vw * 0.5;
  gfx_y = pill_y + (pill_h - vh) * 0.5;
  gfx_drawstr(val_str);

  val;
);

// =========================================================================
// 1. TOP HEADER BAR (CURVE MODE, HQ 2X OVERSAMPLE, DC FILTER, UI ZOOM, ACTIVE)
// =========================================================================
hdr_h = floor(50 * S);
gfx_set(0.09, 0.09, 0.15, 1.0);
gfx_rect(0, 0, W, hdr_h);
gfx_set(0.22, 0.20, 0.28, 1.0);
gfx_line(0, hdr_h, W, hdr_h);

// Brand Title: VELVETCLIP in Catppuccin Peach (#FAB387)
gfx_setfont(1);
gfx_set(0.98, 0.70, 0.53, 1.0);
gfx_x = floor(18 * S);
gfx_measurestr("VELVET", tw1, th1);
gfx_y = (hdr_h - th1) * 0.5;
gfx_drawstr("VELVET");
gfx_set(0.94, 0.96, 1.0, 1.0);
gfx_drawstr("CLIP");

// "?" Info Badge
gfx_setfont(5);
gfx_measurestr("?", qw, qh);
q_x = gfx_x + floor(8 * S);
q_y = (hdr_h - qh - 4) * 0.5;
gfx_set(0.18, 0.19, 0.28, 1.0);
gfx_rect(q_x, q_y, qw + 10, qh + 4);
gfx_set(0.98, 0.70, 0.53, 1.0);
gfx_x = q_x + 5; gfx_y = q_y + 2;
gfx_drawstr("?");

title_hit = mouse_x >= 14 && mouse_x <= (q_x + qw + 14) && mouse_y >= 6 && mouse_y <= (hdr_h - 6);
(mouse_cap & 1) && !(last_mouse_cap & 1) && title_hit ? (
  info_open = !info_open;
);

hb_h = floor(28 * S);
hb_y = (hdr_h - hb_h) * 0.5;

// 1. Clipper Curve Selector (FRUITY ASYMPTOTIC / CUBIC KNEE / BASS SHAPER)
cm_w = floor(145 * S);
cm_x = floor(195 * S);
(mouse_cap & 1) && !(last_mouse_cap & 1) &&
(mouse_x >= cm_x && mouse_x <= cm_x + cm_w && mouse_y >= hb_y && mouse_y <= hb_y + hb_h) ? (
  curve_mode = (curve_mode + 1) % 3;
  slider_automate(slider4);
);
draw_panel_box(cm_x, hb_y, cm_w, hb_h, 0.45, 0.28, 0.18, 0.98, 0.70, 0.53);
curve_mode == 0 ? strcpy(#cm_s, "CURVE: FRUITY SOFT") :
curve_mode == 1 ? strcpy(#cm_s, "CURVE: CUBIC KNEE")  :
                  strcpy(#cm_s, "CURVE: BASS SHAPER");
gfx_setfont(4); gfx_set(1.0, 0.98, 0.95, 1.0);
gfx_measurestr(#cm_s, tw, th); gfx_x = cm_x + (cm_w - tw)*0.5; gfx_y = hb_y + (hb_h - th)*0.5; gfx_drawstr(#cm_s);

// 2. HQ 2x Oversampling Toggle
os_w = floor(86 * S);
os_x = cm_x + cm_w + floor(8 * S);
(mouse_cap & 1) && !(last_mouse_cap & 1) &&
(mouse_x >= os_x && mouse_x <= os_x + os_w && mouse_y >= hb_y && mouse_y <= hb_y + hb_h) ? (
  hq_oversample = !hq_oversample;
  slider_automate(slider6);
);
hq_oversample ? (
  draw_panel_box(os_x, hb_y, os_w, hb_h, 0.45, 0.28, 0.18, 0.98, 0.70, 0.53);
  strcpy(#os_s, "HQ: 2x OS");
) : (
  draw_panel_box(os_x, hb_y, os_w, hb_h, 0.14, 0.15, 0.22, 0.28, 0.30, 0.42);
  strcpy(#os_s, "HQ: OFF");
);
gfx_measurestr(#os_s, tw, th); gfx_x = os_x + (os_w - tw)*0.5; gfx_y = hb_y + (hb_h - th)*0.5; gfx_drawstr(#os_s);

// 3. Pre-DC Filter Toggle
dc_w = floor(82 * S);
dc_x = os_x + os_w + floor(8 * S);
(mouse_cap & 1) && !(last_mouse_cap & 1) &&
(mouse_x >= dc_x && mouse_x <= dc_x + dc_w && mouse_y >= hb_y && mouse_y <= hb_y + hb_h) ? (
  dc_block_on = !dc_block_on;
  slider_automate(slider7);
);
dc_block_on ? (
  draw_panel_box(dc_x, hb_y, dc_w, hb_h, 0.18, 0.36, 0.56, 0.45, 0.78, 0.98);
  strcpy(#dc_s, "DC FLT: ON");
) : (
  draw_panel_box(dc_x, hb_y, dc_w, hb_h, 0.14, 0.15, 0.22, 0.28, 0.30, 0.42);
  strcpy(#dc_s, "DC FLT: OFF");
);
gfx_measurestr(#dc_s, tw, th); gfx_x = dc_x + (dc_w - tw)*0.5; gfx_y = hb_y + (hb_h - th)*0.5; gfx_drawstr(#dc_s);

// 4. UI Scale Toggle Button
zm_w = floor(80 * S);
zm_x = W - floor(176 * S);
(mouse_cap & 1) && !(last_mouse_cap & 1) &&
(mouse_x >= zm_x && mouse_x <= zm_x + zm_w && mouse_y >= hb_y && mouse_y <= hb_y + hb_h) ? (
  ui_zoom < 1.1 ? ui_zoom = 1.25 : ui_zoom < 1.38 ? ui_zoom = 1.50 : ui_zoom = 1.0;
  slider_automate(slider9);
);
draw_panel_box(zm_x, hb_y, zm_w, hb_h, 0.14, 0.15, 0.22, 0.28, 0.30, 0.42);
ui_zoom < 1.1 ? strcpy(#z_s, "UI: 100%") : ui_zoom < 1.38 ? strcpy(#z_s, "UI: 125%") : strcpy(#z_s, "UI: 150%");
gfx_measurestr(#z_s, tw, th); gfx_x = zm_x + (zm_w - tw)*0.5; gfx_y = hb_y + (hb_h - th)*0.5; gfx_drawstr(#z_s);

// 5. Master Active Button
act_w = floor(80 * S);
act_x = W - act_w - floor(10 * S);
(mouse_cap & 1) && !(last_mouse_cap & 1) &&
(mouse_x >= act_x && mouse_x <= act_x + act_w && mouse_y >= hb_y && mouse_y <= hb_y + hb_h) ? (
  active_on = !active_on;
  slider_automate(slider8);
);
active_on ? (
  draw_panel_box(act_x, hb_y, act_w, hb_h, 0.78, 0.42, 0.22, 0.98, 0.70, 0.53);
  strcpy(#ac_s, "ACTIVE");
) : (
  draw_panel_box(act_x, hb_y, act_w, hb_h, 0.14, 0.15, 0.22, 0.28, 0.30, 0.42);
  strcpy(#ac_s, "BYP");
);
gfx_measurestr(#ac_s, tw, th); gfx_x = act_x + (act_w - tw)*0.5; gfx_y = hb_y + (hb_h - th)*0.5; gfx_drawstr(#ac_s);

// =========================================================================
// 2. TOP VISUALIZER DECK: [LEFT: INTERACTIVE FRUITY TRANSFER GRAPH]
//                         [CENTER: ROLLING WAVEFORM & SHAVED PEAKS]
//                         [RIGHT: OUTPUT & SHAVED dB METERS]
// =========================================================================
pad     = floor(12 * S);
full_w  = W - (pad * 2);
avail_h = H - hdr_h - (pad * 3);

vis_y = hdr_h + pad;
vis_h = floor(avail_h * 0.56);
knb_y = vis_y + vis_h + pad;
knb_h = avail_h - vis_h;

// 3 Columns in Top Visualizer Deck
v1_w = floor((full_w - pad * 2) * 0.42);
v2_w = floor((full_w - pad * 2) * 0.40);
v3_w = full_w - (pad * 2) - v1_w - v2_w;

v1_x = pad;
v2_x = v1_x + v1_w + pad;
v3_x = v2_x + v2_w + pad;

// -------------------------------------------------------------------------
// PANEL 1: INTERACTIVE FRUITY SOFT CLIPPER TRANSFER GRAPH (DRAG THRESHOLD!)
// -------------------------------------------------------------------------
draw_panel_box(v1_x, vis_y, v1_w, vis_h, 0.055, 0.058, 0.092, 0.22, 0.24, 0.34);

// Quarter grid lines
gi = 1;
loop(3,
  gx = v1_x + (gi * 0.25) * v1_w;
  gy = vis_y + (gi * 0.25) * vis_h;
  gfx_set(0.13, 0.14, 0.21, 1.0);
  gfx_line(gx, vis_y + 1, gx, vis_y + vis_h - 1);
  gfx_line(v1_x + 1, gy, v1_x + v1_w - 1, gy);
  gi += 1;
);

// Domain: X axis = Input 0.0 .. 1.5 (+3.5 dBFS), Y axis = Output 0.0 .. 1.05 (0 dBFS ceiling)
MAX_X_DOM = 1.5;
MAX_Y_DOM = 1.05;

// 1:1 Linear Reference Diagonal
x_1to1 = v1_x + (1.0 / MAX_X_DOM) * v1_w;
y_1to1 = (vis_y + vis_h) - (1.0 / MAX_Y_DOM) * vis_h;
gfx_set(0.28, 0.30, 0.42, 0.75);
gfx_line(v1_x + 2, vis_y + vis_h - 2, x_1to1, y_1to1, 1);

// 0 dBFS Ceiling Horizontal Line
gfx_set(0.95, 0.55, 0.66, 0.55);
gfx_line(v1_x + 2, y_1to1, v1_x + v1_w - 2, y_1to1);

// Bright Interactive Threshold Horizontal Line (Fruity Soft Clipper Style)
thr_y = (vis_y + vis_h) - (thresh_lin / MAX_Y_DOM) * vis_h;
thr_x = v1_x + (thresh_lin / MAX_X_DOM) * v1_w;

// Shaded Non-Linear Soft-Knee Region above Threshold Line
thresh_lin < 0.995 ? (
  gfx_set(0.98, 0.70, 0.53, 0.12);
  gfx_rect(v1_x + 1, y_1to1, v1_w - 2, max(1, thr_y - y_1to1));
);

// Bright Threshold Line + Grab Handle
gfx_set(0.98, 0.89, 0.69, 0.90);
gfx_line(v1_x + 2, thr_y, v1_x + v1_w - 2, thr_y);
gfx_line(v1_x + 2, thr_y + 1, v1_x + v1_w - 2, thr_y + 1);

// Drag anywhere inside the Transfer Graph to adjust Threshold directly!
in_graph = (mouse_x >= v1_x && mouse_x <= v1_x + v1_w && mouse_y >= vis_y && mouse_y <= vis_y + vis_h);
(mouse_cap & 1) && !(last_mouse_cap & 1) && in_graph && (drag_id == 0) ? (
  drag_id = 400;
);
drag_id == 400 ? (
  (mouse_cap & 1) ? (
    new_t_lin = max(0.0631, min(1.0, ((vis_y + vis_h - mouse_y) / vis_h) * MAX_Y_DOM));
    thresh_db = max(-24.0, min(0.0, K_TO_DB(new_t_lin)));
    update_parameters();
    slider_automate(slider1);
  ) : drag_id = 0;
);

// Plot Piecewise Transfer Curve:
// Sapphire Blue below Threshold (100% Linear 1:1), Warm Peach above Threshold (Soft Knee)
steps = 80;
st = 0;
loop(steps + 1,
  t_n  = st / steps;
  x_in = t_n * MAX_X_DOM;
  y_cl = clip_sample(x_in);

  px = v1_x + 2 + (x_in / MAX_X_DOM) * (v1_w - 4);
  py = (vis_y + vis_h - 2) - (y_cl / MAX_Y_DOM) * (vis_h - 4);

  st > 0 ? (
    x_in <= thresh_lin ? (
      // 100% Linear Untouched Region in Sapphire Blue
      gfx_set(0.45, 0.78, 0.98, 0.98);
    ) : (
      // Soft-Clipped Region in Catppuccin Peach
      gfx_set(0.98, 0.70, 0.53, 0.98);
    );
    gfx_line(prev_px, prev_py, px, py, 1);
    gfx_line(prev_px, prev_py + 1, px, py + 1, 1);
  );
  prev_px = px; prev_py = py;
  st += 1;
);

// Exact Knee Inflection Point Circle at (T, T)
gfx_set(0.98, 0.89, 0.69, 1.0);
gfx_circle(thr_x, thr_y, floor(5 * S), 1, 1);

// Live Audio Peak Operating Dot riding the Transfer Curve
cur_x_pk = min(MAX_X_DOM, env_drv_pk);
cur_y_pk = clip_sample(cur_x_pk);
dot_px = v1_x + 2 + (cur_x_pk / MAX_X_DOM) * (v1_w - 4);
dot_py = (vis_y + vis_h - 2) - (cur_y_pk / MAX_Y_DOM) * (vis_h - 4);

cur_x_pk > 0.01 ? (
  cur_x_pk > thresh_lin ? gfx_set(0.95, 0.55, 0.66, 1.0) : gfx_set(0.65, 0.89, 0.63, 1.0);
  gfx_circle(dot_px, dot_py, floor(6 * S), 1, 1);
  gfx_set(1.0, 1.0, 1.0, 1.0);
  gfx_circle(dot_px, dot_py, floor(6 * S), 0, 1);
);

// Graph Labels & Hover Input->Output dB Mapping Readout (just like Fruity Soft Clipper hint bar)
gfx_setfont(5);
gfx_set(0.75, 0.80, 0.92, 1.0);
gfx_x = v1_x + 10; gfx_y = vis_y + 8;
gfx_drawstr("LINEAR 1:1 BELOW THRESHOLD (DRAG GRAPH)");

in_graph ? (
  hov_x = max(0.001, ((mouse_x - v1_x) / v1_w) * MAX_X_DOM);
  hov_y = clip_sample(hov_x);
  sprintf(#hov_s, "IN: %+.1f dB -> OUT: %+.1f dB", K_TO_DB(hov_x), K_TO_DB(hov_y));
  gfx_set(0.98, 0.89, 0.69, 1.0);
  gfx_x = v1_x + 10; gfx_y = vis_y + vis_h - floor(20 * S);
  gfx_drawstr(#hov_s);
);

// -------------------------------------------------------------------------
// PANEL 2: REAL-TIME WAVEFORM & SHAVED TRANSIENT PEAK MONITOR
// -------------------------------------------------------------------------
draw_panel_box(v2_x, vis_y, v2_w, vis_h, 0.055, 0.058, 0.092, 0.22, 0.24, 0.34);

// Threshold reference line inside Waveform Scope
wf_thr_y = (vis_y + vis_h) - (thresh_lin / MAX_Y_DOM) * vis_h;
gfx_set(0.98, 0.89, 0.69, 0.35);
gfx_line(v2_x + 2, wf_thr_y, v2_x + v2_w - 2, wf_thr_y);

col_w = (v2_w - 6) / HIST_BINS;
hi = 0;
loop(HIST_BINS,
  h_idx = (h_head + 1 + hi) & (HIST_BINS - 1);
  v_out = HIST_OUT[h_idx];
  v_shv = HIST_CLIP[h_idx];

  hx = v2_x + 3 + hi * col_w;
  h_out_px = min(vis_h - 6, (v_out / MAX_Y_DOM) * (vis_h - 6));
  h_shv_px = min(vis_h * 0.45, (v_shv / MAX_Y_DOM) * (vis_h - 6));

  // Output Waveform Bars from bottom up (Sapphire Blue)
  h_out_px > 1 ? (
    gfx_set(0.45, 0.78, 0.98, 0.60);
    gfx_rect(hx, (vis_y + vis_h - 2) - h_out_px, max(1, col_w - 1), h_out_px);
  );

  // Shaved Peaks from top down (Catppuccin Red/Peach shows only what was clipped!)
  h_shv_px > 0.5 ? (
    gfx_set(0.95, 0.55, 0.66, 0.90);
    gfx_rect(hx, vis_y + 2, max(1, col_w - 1), max(2, h_shv_px));
  );
  hi += 1;
);

gfx_setfont(5);
gfx_set(0.75, 0.80, 0.92, 1.0);
gfx_x = v2_x + 10; gfx_y = vis_y + 8;
gfx_drawstr("OUTPUT WAVE (BOT) & SHAVED PEAKS (TOP)");

// -------------------------------------------------------------------------
// PANEL 3: STEREO OUTPUT METER & SHAVED GAIN REDUCTION METER
// -------------------------------------------------------------------------
draw_panel_box(v3_x, vis_y, v3_w, vis_h, 0.095, 0.098, 0.145, 0.20, 0.22, 0.31);

m_top = vis_y + floor(28 * S);
m_h   = vis_h - floor(58 * S);
m_w   = floor((v3_w - floor(28 * S)) * 0.45);
m1_x  = v3_x + floor(10 * S);
m2_x  = m1_x + m_w + floor(8 * S);

gfx_setfont(5);
gfx_set(0.75, 0.80, 0.92, 1.0);
gfx_x = m1_x; gfx_y = vis_y + floor(8 * S); gfx_drawstr("OUT");
gfx_x = m2_x; gfx_y = vis_y + floor(8 * S); gfx_drawstr("CLIP");

// Output Meter Box (Bottom-Up)
draw_panel_box(m1_x, m_top, m_w, m_h, 0.05, 0.05, 0.08, 0.20, 0.22, 0.32);
out_db_now = K_TO_DB(max(env_out_l, env_out_r));
out_norm   = max(0.0, min(1.0, (out_db_now + 48.0) / 48.0));
out_fill_h = floor(out_norm * (m_h - 4));
out_fill_h > 0 ? (
  out_db_now > -0.2 ? gfx_set(0.98, 0.70, 0.53, 0.95) : gfx_set(0.45, 0.78, 0.98, 0.92);
  gfx_rect(m1_x + 2, (m_top + m_h - 2) - out_fill_h, m_w - 4, out_fill_h);
);

// Shaved Peak Meter Box (Top-Down, 0 to 12 dB shaved)
draw_panel_box(m2_x, m_top, m_w, m_h, 0.05, 0.05, 0.08, 0.20, 0.22, 0.32);
shv_norm   = max(0.0, min(1.0, shaved_env_db / 12.0));
shv_fill_h = floor(shv_norm * (m_h - 4));
shv_fill_h > 0 ? (
  gfx_set(0.95, 0.55, 0.66, 0.95);
  gfx_rect(m2_x + 2, m_top + 2, m_w - 4, shv_fill_h);
);

// Numeric Peak Readouts at Bottom of Meters (Click to reset)
gfx_setfont(3);
gfx_set(0.95, 0.97, 1.0, 1.0);
sprintf(#shv_s, "-%.1fdB", shaved_hold_db);
gfx_measurestr(#shv_s, tw, th);
gfx_x = v3_x + (v3_w - tw)*0.5;
gfx_y = m_top + m_h + floor(6 * S);
gfx_drawstr(#shv_s);

(mouse_cap & 1) && !(last_mouse_cap & 1) &&
(mouse_x >= v3_x && mouse_x <= v3_x + v3_w && mouse_y >= vis_y && mouse_y <= vis_y + vis_h) ? (
  shaved_hold_db = 0.0;
  hold_out_pk = 0.0;
);

// =========================================================================
// 3. BOTTOM KNOB DECK: 4 LARGE PRIMARY KNOBS (DRIVE | THRESHOLD | SUB SAFE | POST GAIN)
// =========================================================================
draw_panel_box(pad, knb_y, full_w, knb_h, 0.095, 0.098, 0.145, 0.20, 0.22, 0.31);

cell_w = full_w / 4.0;
r_knb  = min(floor(40 * S), floor(knb_h * 0.23));
r_hero = min(floor(46 * S), floor(knb_h * 0.26));
k_cy   = knb_y + floor(knb_h * 0.38);

// 1. INPUT DRIVE (-12 to +12 dB)
sprintf(#v_s, "%+.1f dB", in_drive_db);
new_v = draw_vc_knob(1, pad + cell_w * 0.5, k_cy, r_knb, in_drive_db, -12.0, 12.0, 0.0, "INPUT DRIVE", #v_s, 1, 0.45, 0.78, 0.98);
abs(new_v - in_drive_db) > 0.05 ? ( in_drive_db = new_v; update_parameters(); slider_automate(slider3); );

// 2. HERO THRESHOLD KNOB (-24 to 0.0 dB) — Matches Fruity Soft Clipper THRES
sprintf(#v_s, "%.1f dB", thresh_db);
new_v = draw_vc_knob(2, pad + cell_w * 1.5, k_cy, r_hero, thresh_db, -24.0, 0.0, -1.8, "THRESHOLD (THRES)", #v_s, 0, 0.98, 0.70, 0.53);
abs(new_v - thresh_db) > 0.05 ? ( thresh_db = new_v; update_parameters(); slider_automate(slider1); );

// 3. SUB-BASS PRESERVE (0 to 100%) — Prevents 808s from buzzing when clipped hard
sprintf(#v_s, "%.0f %%", sub_preserve_pct);
new_v = draw_vc_knob(3, pad + cell_w * 2.5, k_cy, r_knb, sub_preserve_pct, 0.0, 100.0, 0.0, "808 SUB SAFE", #v_s, 0, 0.98, 0.89, 0.69);
abs(new_v - sub_preserve_pct) > 0.1 ? ( sub_preserve_pct = new_v; update_parameters(); slider_automate(slider5); );

// 4. POST GAIN / CEILING (-12 to +6 dB) — Matches Fruity Soft Clipper POST
sprintf(#v_s, "%+.1f dB", post_db);
new_v = draw_vc_knob(4, pad + cell_w * 3.5, k_cy, r_hero, post_db, -12.0, 6.0, 0.0, "POST GAIN (POST)", #v_s, 1, 0.98, 0.70, 0.53);
abs(new_v - post_db) > 0.05 ? ( post_db = new_v; update_parameters(); slider_automate(slider2); );

// =========================================================================
// 4. INFO OVERLAY MODAL (Click VELVETCLIP Logo to Toggle)
// =========================================================================
info_open ? (
  mw = floor(W * 0.76);
  mh = floor(295 * S);
  mx = (W - mw) * 0.5;
  my = (H - mh) * 0.5;

  draw_panel_box(mx, my, mw, mh, 0.07, 0.07, 0.11, 0.98, 0.70, 0.53);

  gfx_setfont(1);
  gfx_set(0.98, 0.70, 0.53, 1.0);
  gfx_x = mx + 24; gfx_y = my + 20;
  gfx_drawstr("VelvetClip v1.0 (Transparent Master Soft Clipper)");

  gfx_setfont(3);
  gfx_set(0.92, 0.94, 0.98, 1.0);
  lh_step = floor(26 * S);
  ty = my + 60;
  gfx_x = mx + 24; gfx_y = ty;             gfx_drawstr("• 100% Bit-Identical Pass-Through (y = x) for all signals below Threshold");
  gfx_x = mx + 24; gfx_y = ty + lh_step;   gfx_drawstr("• Drag vertically inside the left Transfer Graph to adjust Threshold directly");
  gfx_x = mx + 24; gfx_y = ty + lh_step*2; gfx_drawstr("• 3 Curves: Fruity Soft (Asymptotic), Cubic Knee (Punchy), and Bass Shaper");
  gfx_x = mx + 24; gfx_y = ty + lh_step*3; gfx_drawstr("• 808 SUB SAFE pre-cuts & post-restores <95 Hz so sub-bass never buzzes");
  gfx_x = mx + 24; gfx_y = ty + lh_step*4; gfx_drawstr("• HQ 2x Oversampling suppresses aliasing on sharp transient peaks");
  gfx_x = mx + 24; gfx_y = ty + lh_step*5; gfx_drawstr("• Click the right meter panel to clear Peak Hold readouts");

  gfx_set(0.72, 0.66, 0.60, 1.0);
  gfx_x = mx + 24; gfx_y = my + mh - 32;
  gfx_drawstr("Click anywhere on this card or the header logo to close.");

  (mouse_cap & 1) && !(last_mouse_cap & 1) &&
  (mouse_x >= mx && mouse_x <= mx + mw && mouse_y >= my && mouse_y <= my + mh) ? (
    info_open = 0;
  );
);

last_mouse_cap = mouse_cap;
