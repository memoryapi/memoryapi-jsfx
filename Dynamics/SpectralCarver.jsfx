desc:SpectralCarver (32-Band Dynamic Spectral Ducker)
// @description SpectralCarver (32-Band Dynamic Spectral Ducker)
// @author MemoryAPI
// @version 1.3.0
// @changelog Replaced shifting bottom drawer with zero-shift in-place spectrum overlay panel
// @about
//   # SpectralCarver
//   32-Band Dynamic Spectral Ducker using Cytomic SVF filters.
//
//   ### Features
//   - 32-band Cytomic SVF dynamic spectral ducking
//   - High-contrast visualizer with smooth animated controls and hover halos
//   - Zero-shift In-Place Advanced Overlay over the spectrum analyzer
//   - Stereo (L/R) and Mid/Side (M/S) processing modes
//   - Low-cut and high-cut sidechain filtering with interactive spectrum display
//   - Sidechain audition mode, freeze function, and scalable UI text zoom
//   - Safe ceiling and NaN/Inf protection
//
//   ### Routing
//   Route sidechain control audio to Channels 3/4.
// @provides
//   [effect] SpectralCarver.jsfx

slider1:amount_pct=25<0,100,0.1>-Amount (%)
slider2:low_cut_hz=20<20,20000,1>-Low Cut (Hz)
slider3:high_cut_hz=20000<20,20000,1>-High Cut (Hz)
slider4:attack_ms=10<0.1,200,0.1>-Attack (ms)
slider5:release_ms=80<5,1000,1>-Release (ms)
slider6:proc_mode=0<0,1,1{L/R,M/S}>-Processing Mode
slider7:pan_val=0<-100,100,1>-Pan / M-S Balance (%)
slider8:freeze_on=0<0,1,1{Off,On}>-Freeze
slider9:audition_on=0<0,1,1{Off,On}>-SC Audition
slider10:adv_open=0<0,1,1{Closed,Open}>-Advanced Panel
slider11:ui_zoom=1.15<1.0,1.5,0.25>-UI Text Zoom

in_pin:Main Left
in_pin:Main Right
in_pin:Sidechain Left
in_pin:Sidechain Right
out_pin:Output Left
out_pin:Output Right

@init
ext_noinit = 1.0;

NUM_BANDS = 32;
MIN_FREQ = 20.0;
MAX_FREQ = 20000.0;
LOG_MIN = log(MIN_FREQ);
LOG_MAX = log(MAX_FREQ);
SAFE_SRATE = max(8000.0, srate);

// Memory allocation map (non-overlapping blocks of 64 floats)
freq_table  = 100;
svf_g       = 200;
sc_a1       = 300;
sc_a2       = 400;
sc_ic1      = 500;
sc_ic2      = 600;

env_state   = 700;
env_db_arr  = 800;
red_db_arr  = 900;

eq0_a1 = 1000; eq0_a2 = 1100; eq0_m1 = 1200;
eq1_a1 = 1300; eq1_a2 = 1400; eq1_m1 = 1500;

eq0_ic1 = 1600; eq0_ic2 = 1700;
eq1_ic1 = 1800; eq1_ic2 = 1900;

ui_sc_norm  = 2000;
ui_red_norm = 2100;

function update_parameters()
  local(g_hp, k_hp, g_lp, k_lp, pan_norm)
(
  SAFE_SRATE = max(8000.0, srate);

  low_cut_hz > high_cut_hz - 20.0 ? (
    low_cut_hz = max(20.0, high_cut_hz - 20.0);
  );

  // Sidechain High-Pass (Cytomic SVF 12dB/oct Butterworth)
  g_hp = tan($pi * max(20.0, min(low_cut_hz, SAFE_SRATE * 0.45)) / SAFE_SRATE);
  k_hp = 1.41421356;
  hp_a1 = 1.0 / (1.0 + g_hp * (g_hp + k_hp));
  hp_a2 = g_hp * hp_a1;
  hp_a3 = g_hp * hp_a2;
  hp_k  = k_hp;

  // Sidechain Low-Pass (Cytomic SVF 12dB/oct Butterworth)
  g_lp = tan($pi * max(20.0, min(high_cut_hz, SAFE_SRATE * 0.45)) / SAFE_SRATE);
  k_lp = 1.41421356;
  lp_a1 = 1.0 / (1.0 + g_lp * (g_lp + k_lp));
  lp_a2 = g_lp * lp_a1;
  lp_a3 = g_lp * lp_a2;

  // Envelope time constants
  att_coeff = exp(-1.0 / max(1.0, (attack_ms * 0.001) * SAFE_SRATE));
  rel_coeff = exp(-1.0 / max(1.0, (release_ms * 0.001) * SAFE_SRATE));

  // Pan / M-S channel weighting
  pan_norm = pan_val * 0.01;
  weight_ch0 = pan_norm <= 0.0 ? 1.0 : (1.0 - pan_norm);
  weight_ch1 = pan_norm >= 0.0 ? 1.0 : (1.0 + pan_norm);
);

function init_filterbank()
  local(i, pct, fc, g, k_bp, a1_bp)
(
  SAFE_SRATE = max(8000.0, srate);
  EQ_Q = 4.3;

  i = 0;
  loop(NUM_BANDS,
    pct = (i + 0.5) / NUM_BANDS;
    fc = exp(LOG_MIN + pct * (LOG_MAX - LOG_MIN));
    fc = min(fc, SAFE_SRATE * 0.44);
    freq_table[i] = fc;

    g = tan($pi * fc / SAFE_SRATE);
    svf_g[i] = g;

    k_bp = 1.0 / EQ_Q;
    a1_bp = 1.0 / (1.0 + g * (g + k_bp));
    sc_a1[i] = a1_bp;
    sc_a2[i] = g * a1_bp;

    eq0_a1[i] = a1_bp; eq0_a2[i] = g * a1_bp; eq0_m1[i] = 0.0;
    eq1_a1[i] = a1_bp; eq1_a2[i] = g * a1_bp; eq1_m1[i] = 0.0;

    i += 1;
  );
  last_srate = SAFE_SRATE;
);

!dsp_initialized || (last_srate != srate) ? (
  ui_zoom < 1.0 ? ui_zoom = 1.15;
  adv_anim = adv_open ? 1.0 : 0.0;
  init_filterbank();
  update_parameters();
  dsp_initialized = 1;
);

@slider
update_parameters();

@block
last_srate != srate ? init_filterbank();
update_parameters();

i = 0;
loop(NUM_BANDS,
  fc = freq_table[i];

  mask = 1.0;
  fc < low_cut_hz ? (
    oct_below = log(low_cut_hz / fc) / log(2.0);
    mask = max(0.0, 1.0 - oct_below * 1.5);
  );
  fc > high_cut_hz ? (
    oct_above = log(fc / high_cut_hz) / log(2.0);
    mask = min(mask, max(0.0, 1.0 - oct_above * 1.5));
  );

  env_lin = max(0.000001, env_state[i]);
  env_db = 8.685889638 * log(env_lin);
  env_db_arr[i] = env_db;

  excess_db = max(0.0, env_db + 54.0);
  raw_red_db = -(excess_db * (amount_pct * 0.01) * 0.55) * mask;
  target_red_db = max(-24.0, min(0.0, raw_red_db));
  red_db_arr[i] = target_red_db;

  g = svf_g[i];

  // Channel 0 (Left or Mid)
  g0_db = target_red_db * weight_ch0;
  A0 = exp(g0_db * 0.0575646273);
  k0 = 1.0 / (EQ_Q * A0);
  a1_0 = 1.0 / (1.0 + g * (g + k0));
  eq0_a1[i] = a1_0;
  eq0_a2[i] = g * a1_0;
  eq0_m1[i] = k0 * (A0 * A0 - 1.0);

  // Channel 1 (Right or Side)
  g1_db = target_red_db * weight_ch1;
  A1 = exp(g1_db * 0.0575646273);
  k1 = 1.0 / (EQ_Q * A1);
  a1_1 = 1.0 / (1.0 + g * (g + k1));
  eq1_a1[i] = a1_1;
  eq1_a2[i] = g * a1_1;
  eq1_m1[i] = k1 * (A1 * A1 - 1.0);

  i += 1;
);

@sample
in_l = spl0;
in_r = spl1;
sc_l = spl2;
sc_r = spl3;

sc_mono = (sc_l + sc_r) * 0.5;

low_cut_hz > 21.0 ? (
  v3 = sc_mono - hp_ic2;
  v1 = hp_a1 * hp_ic1 + hp_a2 * v3;
  v2 = hp_ic2 + hp_a2 * hp_ic1 + hp_a3 * v3;
  hp_ic1 = 2.0 * v1 - hp_ic1;
  hp_ic2 = 2.0 * v2 - hp_ic2;
  sc_mono = sc_mono - hp_k * v1 - v2;
);

high_cut_hz < 19900.0 ? (
  v3 = sc_mono - lp_ic2;
  v1 = lp_a1 * lp_ic1 + lp_a2 * v3;
  v2 = lp_ic2 + lp_a2 * lp_ic1 + lp_a3 * v3;
  lp_ic1 = 2.0 * v1 - lp_ic1;
  lp_ic2 = 2.0 * v2 - lp_ic2;
  sc_mono = v2;
);

!freeze_on ? (
  k_bp = 1.0 / EQ_Q;
  b = 0;
  loop(NUM_BANDS,
    ic1 = sc_ic1[b];
    ic2 = sc_ic2[b];
    a1  = sc_a1[b];
    a2  = sc_a2[b];

    v3 = sc_mono - ic2;
    v1 = a1 * ic1 + a2 * v3;
    v2 = ic2 + a2 * ic1 + (svf_g[b] * a2) * v3;
    sc_ic1[b] = 2.0 * v1 - ic1;
    sc_ic2[b] = 2.0 * v2 - ic2;

    rect = abs(k_bp * v1);
    curr_env = env_state[b];
    rect > curr_env ? (
      env_state[b] = att_coeff * curr_env + (1.0 - att_coeff) * rect;
    ) : (
      env_state[b] = rel_coeff * curr_env + (1.0 - rel_coeff) * rect;
    );
    b += 1;
  );
);

audition_on ? (
  spl0 = sc_mono;
  spl1 = sc_mono;
) : (
  proc_mode == 1 ? (
    ch0 = (in_l + in_r) * 0.70710678;
    ch1 = (in_l - in_r) * 0.70710678;
  ) : (
    ch0 = in_l;
    ch1 = in_r;
  );

  b = 0;
  loop(NUM_BANDS,
    g_b = svf_g[b];

    ic1 = eq0_ic1[b]; ic2 = eq0_ic2[b];
    a1  = eq0_a1[b];  a2  = eq0_a2[b];
    v3  = ch0 - ic2;
    v1  = a1 * ic1 + a2 * v3;
    v2  = ic2 + a2 * ic1 + (g_b * a2) * v3;
    eq0_ic1[b] = 2.0 * v1 - ic1;
    eq0_ic2[b] = 2.0 * v2 - ic2;
    ch0 = ch0 + eq0_m1[b] * v1;

    ic1 = eq1_ic1[b]; ic2 = eq1_ic2[b];
    a1  = eq1_a1[b];  a2  = eq1_a2[b];
    v3  = ch1 - ic2;
    v1  = a1 * ic1 + a2 * v3;
    v2  = ic2 + a2 * ic1 + (g_b * a2) * v3;
    eq1_ic1[b] = 2.0 * v1 - ic1;
    eq1_ic2[b] = 2.0 * v2 - ic2;
    ch1 = ch1 + eq1_m1[b] * v1;

    b += 1;
  );

  proc_mode == 1 ? (
    out_l = (ch0 + ch1) * 0.70710678;
    out_r = (ch0 - ch1) * 0.70710678;
  ) : (
    out_l = ch0;
    out_r = ch1;
  );

  (out_l != out_l || abs(out_l) > 2.0) ? (
    out_l = max(-2.0, min(2.0, out_l));
  );
  (out_r != out_r || abs(out_r) > 2.0) ? (
    out_r = max(-2.0, min(2.0, out_r));
  );

  spl0 = out_l;
  spl1 = out_r;
);

@gfx 700 640
// Solid dark base (#1E1E2E: R=30, G=30, B=46)
gfx_clear = 30 + (30 * 256) + (46 * 65536);

W = max(560, gfx_w);
H = max(520, gfx_h);

// Responsive geometry scale & user text scale for Linux X11
S  = min(W / 700.0, H / 640.0);
TS = S * max(1.0, ui_zoom);

// Configure crisp readable fonts (scaled automatically)
f_title = max(18, floor(22 * TS));
f_sec   = max(14, floor(15 * TS));
f_val   = max(14, floor(15 * TS));
f_btn   = max(13, floor(14 * TS));
f_grid  = max(12, floor(13 * TS));
f_big   = max(18, floor(21 * TS));

gfx_setfont(1, "sans-serif", f_title, 'b');
gfx_setfont(2, "sans-serif", f_sec,   'b');
gfx_setfont(3, "sans-serif", f_val,   0);
gfx_setfont(4, "sans-serif", f_btn,   'b');
gfx_setfont(5, "sans-serif", f_grid,  0);
gfx_setfont(6, "sans-serif", f_big,   'b');

// Smooth fade animation for the In-Place Viewport Overlay (Zero Geometry Shift!)
target_adv = adv_open ? 1.0 : 0.0;
adv_anim = adv_anim + (target_adv - adv_anim) * 0.40;
abs(target_adv - adv_anim) < 0.005 ? adv_anim = target_adv;

function freq_to_x(f, x0, xw)
  local(clamped)
(
  clamped = max(MIN_FREQ, min(MAX_FREQ, f));
  x0 + ((log(clamped) - LOG_MIN) / (LOG_MAX - LOG_MIN)) * xw;
);

function x_to_freq(px, x0, xw)
  local(norm)
(
  norm = max(0.0, min(1.0, (px - x0) / xw));
  exp(LOG_MIN + norm * (LOG_MAX - LOG_MIN));
);

function draw_panel_box(bx, by, bw, bh, r_bg, g_bg, b_bg, r_bd, g_bd, b_bd)
(
  gfx_set(r_bg, g_bg, b_bg, 1.0);
  gfx_rect(bx, by, bw, bh);
  gfx_set(r_bd, g_bd, b_bd, 1.0);
  gfx_rect(bx, by, bw, bh, 0);
);

function draw_rotary_knob(id, cx, cy, r, val, vmin, vmax, vdef, label, val_str, is_hero)
  local(norm, hit, hover, sens, delta, ang_start, ang_end, ang_val, steps, st, t0, t1, a0, a1,
        px0, py0, px1, py1, lw, lh, vw, vh, pill_w, pill_h, pill_x, pill_y)
(
  norm = max(0.0, min(1.0, (val - vmin) / (vmax - vmin)));

  hit = ((mouse_x - cx)*(mouse_x - cx) + (mouse_y - cy)*(mouse_y - cy)) <= ((r + 10)*(r + 10));
  hover = hit || (drag_id == id);

  (mouse_cap & 1) && !(last_mouse_cap & 1) && hit ? (
    (time_precise() - last_click_time < 0.28) && (last_click_id == id) ? (
      val = vdef;
      drag_id = 0;
    ) : (
      drag_id = id;
      drag_start_y = mouse_y;
      drag_start_val = val;
      last_click_time = time_precise();
      last_click_id = id;
    );
  );

  drag_id == id ? (
    (mouse_cap & 1) ? (
      sens = (mouse_cap & 4) ? 550.0 : 160.0;
      delta = (drag_start_y - mouse_y) / sens;
      val = max(vmin, min(vmax, drag_start_val + delta * (vmax - vmin)));
    ) : (
      drag_id = 0;
    );
  );

  norm = max(0.0, min(1.0, (val - vmin) / (vmax - vmin)));

  // Soft outer drop shadow & hover halo
  gfx_set(0.05, 0.05, 0.09, 0.85);
  gfx_circle(cx, cy + 3, r + 1, 1, 1);
  hover ? (
    gfx_set(0.54, 0.71, 0.98, 0.16);
    gfx_circle(cx, cy, r + 6, 1, 1);
  );

  // Knob body (#181825 inner, #313244 rim)
  gfx_set(0.11, 0.11, 0.17, 1.0);
  gfx_circle(cx, cy, r, 1, 1);
  hover ? gfx_set(0.45, 0.55, 0.75, 1.0) : gfx_set(0.24, 0.25, 0.35, 1.0);
  gfx_circle(cx, cy, r, 0, 1);

  ang_start = -2.356194;
  ang_end   =  2.356194;
  ang_val   = ang_start + norm * (ang_end - ang_start);

  // Thick value arc (3 radial passes so it looks bold on unscaled X11)
  steps = 36;
  st = 0;
  loop(steps,
    t0 = st / steps;
    t1 = (st + 1) / steps;
    a0 = ang_start + t0 * (ang_end - ang_start);
    a1 = ang_start + t1 * (ang_end - ang_start);
    t1 <= norm ? (
      is_hero ? gfx_set(0.45, 0.78, 0.98, 1.0) : gfx_set(0.54, 0.71, 0.98, 0.95);
    ) : (
      gfx_set(0.20, 0.21, 0.29, 0.9);
    );
    gfx_line(cx + sin(a0)*(r-4), cy - cos(a0)*(r-4), cx + sin(a1)*(r-4), cy - cos(a1)*(r-4), 1);
    gfx_line(cx + sin(a0)*(r-5), cy - cos(a0)*(r-5), cx + sin(a1)*(r-5), cy - cos(a1)*(r-5), 1);
    gfx_line(cx + sin(a0)*(r-6), cy - cos(a0)*(r-6), cx + sin(a1)*(r-6), cy - cos(a1)*(r-6), 1);
    st += 1;
  );

  // Crisp double-line pointer indicator + center cap dot
  gfx_set(0.95, 0.96, 1.0, 1.0);
  px0 = cx + sin(ang_val) * (r * 0.25);
  py0 = cy - cos(ang_val) * (r * 0.25);
  px1 = cx + sin(ang_val) * (r - 8);
  py1 = cy - cos(ang_val) * (r - 8);
  gfx_line(px0, py0, px1, py1, 1);
  gfx_line(px0 + 0.6, py0, px1 + 0.6, py1, 1);
  is_hero ? (
    gfx_set(0.45, 0.78, 0.98, 1.0);
    gfx_circle(px1, py1, 2.5, 1, 1);
  );

  // Upper/Lower Section Label
  gfx_setfont(2);
  gfx_measurestr(label, lw, lh);
  is_hero ? gfx_set(0.85, 0.90, 1.0, 1.0) : gfx_set(0.68, 0.72, 0.84, 1.0);
  gfx_x = cx - lw * 0.5;
  gfx_y = cy + r + floor(8 * S);
  gfx_drawstr(label);

  // High-contrast Value Readout Pill Badge
  is_hero ? gfx_setfont(6) : gfx_setfont(3);
  gfx_measurestr(val_str, vw, vh);
  pill_w = max(vw + floor(18 * S), floor(76 * S));
  pill_h = vh + floor(8 * S);
  pill_x = cx - pill_w * 0.5;
  pill_y = cy + r + lh + floor(13 * S);

  gfx_set(0.07, 0.07, 0.11, 1.0);
  gfx_rect(pill_x, pill_y, pill_w, pill_h);
  hover ? gfx_set(0.45, 0.78, 0.98, 0.85) : gfx_set(0.22, 0.24, 0.33, 1.0);
  gfx_rect(pill_x, pill_y, pill_w, pill_h, 0);

  gfx_set(0.95, 0.97, 1.0, 1.0);
  gfx_x = cx - vw * 0.5;
  gfx_y = pill_y + (pill_h - vh) * 0.5;
  gfx_drawstr(val_str);

  val;
);

// =========================================================================
// 1. TOP HEADER BAR
// =========================================================================
hdr_h = floor(52 * S);
gfx_set(0.09, 0.09, 0.15, 1.0);
gfx_rect(0, 0, W, hdr_h);
gfx_set(0.20, 0.21, 0.30, 1.0);
gfx_line(0, hdr_h, W, hdr_h);

// Brand Title (click to toggle Info modal)
gfx_setfont(1);
gfx_set(0.54, 0.71, 0.98, 1.0);
gfx_x = floor(22 * S);
gfx_measurestr("SPECTRAL", tw1, th1);
gfx_y = (hdr_h - th1) * 0.5;
gfx_drawstr("SPECTRAL");
gfx_set(0.92, 0.94, 0.98, 1.0);
gfx_drawstr("CARVER");

// Subtle "INFO" badge next to logo
gfx_setfont(5);
gfx_measurestr("?", qw, qh);
q_x = gfx_x + floor(10 * S);
q_y = (hdr_h - qh - 4) * 0.5;
gfx_set(0.18, 0.19, 0.28, 1.0);
gfx_rect(q_x, q_y, qw + 12, qh + 4);
gfx_set(0.65, 0.70, 0.85, 1.0);
gfx_x = q_x + 6; gfx_y = q_y + 2;
gfx_drawstr("?");

title_hit = mouse_x >= 16 && mouse_x <= (q_x + qw + 16) && mouse_y >= 6 && mouse_y <= (hdr_h - 6);
(mouse_cap & 1) && !(last_mouse_cap & 1) && title_hit ? (
  info_open = !info_open;
);

// UI Text Scale Toggle Button (1x / 1.2x / 1.4x) for Linux X11 convenience
zm_w = floor(96 * S); zm_h = floor(30 * S);
zm_x = W - floor(238 * S); zm_y = (hdr_h - zm_h) * 0.5;
zm_hit = mouse_x >= zm_x && mouse_x <= zm_x + zm_w && mouse_y >= zm_y && mouse_y <= zm_y + zm_h;
(mouse_cap & 1) && !(last_mouse_cap & 1) && zm_hit ? (
  ui_zoom < 1.1 ? ui_zoom = 1.20 :
  ui_zoom < 1.3 ? ui_zoom = 1.40 : ui_zoom = 1.0;
  slider_automate(slider11);
);
draw_panel_box(zm_x, zm_y, zm_w, zm_h, 0.15, 0.16, 0.23, 0.28, 0.30, 0.42);
gfx_setfont(4);
gfx_set(0.80, 0.84, 0.96, 1.0);
ui_zoom < 1.1 ? strcpy(#z_lbl, "TEXT: 100%") :
ui_zoom < 1.3 ? strcpy(#z_lbl, "TEXT: 120%") : strcpy(#z_lbl, "TEXT: 140%");
gfx_measurestr(#z_lbl, zw, zh);
gfx_x = zm_x + (zm_w - zw) * 0.5; gfx_y = zm_y + (zm_h - zh) * 0.5;
gfx_drawstr(#z_lbl);

// Freeze Button in Header
frz_w = floor(104 * S); frz_h = floor(30 * S);
frz_x = W - frz_w - floor(22 * S); frz_y = (hdr_h - frz_h) * 0.5;
frz_hit = mouse_x >= frz_x && mouse_x <= frz_x + frz_w && mouse_y >= frz_y && mouse_y <= frz_y + frz_h;
(mouse_cap & 1) && !(last_mouse_cap & 1) && frz_hit ? (
  freeze_on = !freeze_on;
  slider_automate(slider8);
);
freeze_on ? (
  draw_panel_box(frz_x, frz_y, frz_w, frz_h, 0.22, 0.58, 0.92, 0.55, 0.82, 1.0);
  gfx_set(1.0, 1.0, 1.0, 1.0);
) : (
  draw_panel_box(frz_x, frz_y, frz_w, frz_h, 0.15, 0.16, 0.23, 0.28, 0.30, 0.42);
  gfx_set(0.80, 0.84, 0.96, 1.0);
);
gfx_setfont(4);
gfx_measurestr("FREEZE", fw, fh);
gfx_x = frz_x + (frz_w - fw) * 0.5; gfx_y = frz_y + (frz_h - fh) * 0.5;
gfx_drawstr("FREEZE");

// =========================================================================
// 2. STATIC GEOMETRY CALCULATION (ZERO UI SHIFT WHEN TOGGLING ADVANCED)
// =========================================================================
pad = floor(18 * S);
avail_h = H - hdr_h - (pad * 3);

spec_x  = pad;
spec_y  = hdr_h + pad;
spec_w  = W - (pad * 2);
spec_h  = floor(avail_h * 0.53);

ctrl_x  = pad;
ctrl_y  = spec_y + spec_h + pad;
ctrl_w  = spec_w;
ctrl_h  = avail_h - spec_h;

// Pre-compute ADV button coordinates so they stay 100% locked
adv_btn_w = floor(78 * S);
adv_btn_h = floor(28 * S);
adv_btn_x = spec_x + spec_w - adv_btn_w - floor(10 * S);
adv_btn_y = spec_y + spec_h - adv_btn_h - floor(10 * S);
adv_hit   = mouse_x >= adv_btn_x && mouse_x <= (adv_btn_x + adv_btn_w) &&
            mouse_y >= adv_btn_y && mouse_y <= (adv_btn_y + adv_btn_h);

// =========================================================================
// 3. SPECTRUM ANALYZER VIEWPORT (WITH IN-PLACE ADVANCED OVERLAY)
// =========================================================================
draw_panel_box(spec_x, spec_y, spec_w, spec_h, 0.067, 0.067, 0.106, 0.22, 0.24, 0.34);

// Frequency Grid Lines & Large Readable Labels
gfx_setfont(5);
f_idx = 0;
loop(8,
  f_idx == 0 ? gf = 50 :
  f_idx == 1 ? gf = 100 :
  f_idx == 2 ? gf = 200 :
  f_idx == 3 ? gf = 500 :
  f_idx == 4 ? gf = 1000 :
  f_idx == 5 ? gf = 2000 :
  f_idx == 6 ? gf = 5000 : gf = 10000;

  gx = freq_to_x(gf, spec_x, spec_w);
  gfx_set(0.14, 0.15, 0.22, 1.0);
  gfx_line(gx, spec_y + 1, gx, spec_y + spec_h - 1);

  gfx_set(0.58, 0.62, 0.75, 1.0 - 0.65 * adv_anim);
  gf >= 1000 ? sprintf(#flbl, "%dk", gf/1000) : sprintf(#flbl, "%d", gf);
  gfx_measurestr(#flbl, flw, flh);
  gfx_x = gx - flw * 0.5;
  gfx_y = spec_y + spec_h - flh - 6;
  gfx_drawstr(#flbl);
  f_idx += 1;
);

// Horizontal dB Grid Lines (-6, -12, -18 dB)
db_idx = 1;
loop(3,
  gy = spec_y + (db_idx / 4.0) * spec_h;
  gfx_set(0.14, 0.15, 0.22, 1.0);
  gfx_line(spec_x + 1, gy, spec_x + spec_w - 1, gy);
  gfx_set(0.55, 0.59, 0.72, 1.0 - 0.65 * adv_anim);
  sprintf(#dblbl, "-%d dB", db_idx * 6);
  gfx_x = spec_x + 8;
  gfx_y = gy + 3;
  gfx_drawstr(#dblbl);
  db_idx += 1;
);

// Smooth Sidechain (bottom-up blue) and Gain Reduction (top-down white)
ui_b = 0;
loop(NUM_BANDS,
  target_sc = max(0.0, min(1.0, (env_db_arr[ui_b] + 60.0) / 60.0));
  ui_sc_norm[ui_b] = ui_sc_norm[ui_b] * 0.62 + target_sc * 0.38;

  target_red = max(0.0, min(1.0, abs(red_db_arr[ui_b]) / 24.0));
  ui_red_norm[ui_b] = ui_red_norm[ui_b] * 0.62 + target_red * 0.38;
  ui_b += 1;
);

ui_b = 0;
loop(NUM_BANDS,
  bx = freq_to_x(freq_table[ui_b], spec_x, spec_w);
  by_sc  = spec_y + spec_h - ui_sc_norm[ui_b] * (spec_h - 24);
  by_red = spec_y + 2 + ui_red_norm[ui_b] * (spec_h * 0.85);

  // Sidechain bar fill
  col_w = (spec_w / NUM_BANDS) * 0.82;
  gfx_set(0.35, 0.65, 0.98, 0.24);
  gfx_rect(bx - col_w*0.5, by_sc, col_w, (spec_y + spec_h) - by_sc);

  // Top-down Gain Reduction subtle white tint
  ui_red_norm[ui_b] > 0.005 ? (
    gfx_set(0.92, 0.95, 1.0, 0.12);
    gfx_rect(bx - col_w*0.5, spec_y + 1, col_w, by_red - spec_y);
  );

  ui_b > 0 ? (
    // Sidechain Blue Curve (2px thick)
    gfx_set(0.45, 0.78, 0.98, 0.95);
    gfx_line(prev_bx, prev_by_sc, bx, by_sc, 1);
    gfx_line(prev_bx, prev_by_sc + 1, bx, by_sc + 1, 1);

    // Gain Reduction White Curve (2px thick)
    gfx_set(0.98, 0.99, 1.0, 0.98);
    gfx_line(prev_bx, prev_by_red, bx, by_red, 1);
    gfx_line(prev_bx, prev_by_red + 1, bx, by_red + 1, 1);
  );

  prev_bx = bx;
  prev_by_sc = by_sc;
  prev_by_red = by_red;
  ui_b += 1;
);

// Interactive Low-Cut & High-Cut Curtains + Labeled Grab Flags
lc_x = freq_to_x(low_cut_hz, spec_x, spec_w);
hc_x = freq_to_x(high_cut_hz, spec_x, spec_w);

gfx_set(0.03, 0.03, 0.06, 0.62);
lc_x > spec_x ? gfx_rect(spec_x + 1, spec_y + 1, lc_x - spec_x, spec_h - 2);
hc_x < spec_x + spec_w ? gfx_rect(hc_x, spec_y + 1, (spec_x + spec_w) - hc_x - 1, spec_h - 2);

gfx_set(0.54, 0.71, 0.98, 0.9 * (1.0 - 0.6 * adv_anim));
gfx_line(lc_x, spec_y + 1, lc_x, spec_y + spec_h - 2);
gfx_line(lc_x + 1, spec_y + 1, lc_x + 1, spec_y + spec_h - 2);
gfx_line(hc_x, spec_y + 1, hc_x, spec_y + spec_h - 2);
gfx_line(hc_x - 1, spec_y + 1, hc_x - 1, spec_y + spec_h - 2);

// Only allow LC/HC curtain dragging and hover badge when Advanced Overlay is closed
!adv_open ? (
  // "LC" and "HC" grab tabs at top of curtains
  gfx_setfont(5);
  tab_w = floor(28 * S); tab_h = floor(20 * S);
  gfx_set(0.22, 0.48, 0.85, 1.0);
  gfx_rect(lc_x, spec_y + 8, tab_w, tab_h);
  gfx_rect(hc_x - tab_w, spec_y + 8, tab_w, tab_h);
  gfx_set(0.95, 0.97, 1.0, 1.0);
  gfx_measurestr("LC", lcw, lch);
  gfx_x = lc_x + (tab_w - lcw)*0.5; gfx_y = spec_y + 8 + (tab_h - lch)*0.5;
  gfx_drawstr("LC");
  gfx_measurestr("HC", hcw, hch);
  gfx_x = hc_x - tab_w + (tab_w - hcw)*0.5; gfx_y = spec_y + 8 + (tab_h - hch)*0.5;
  gfx_drawstr("HC");

  // Dragging Low-Cut / High-Cut lines directly in analyzer
  (mouse_cap & 1) && !(last_mouse_cap & 1) && drag_id == 0 && !adv_hit ? (
    mouse_y >= spec_y && mouse_y <= spec_y + spec_h ? (
      abs(mouse_x - lc_x) < 16 ? drag_id = 101 :
      abs(mouse_x - hc_x) < 16 ? drag_id = 102;
    );
  );
  drag_id == 101 ? (
    (mouse_cap & 1) ? (
      low_cut_hz = min(high_cut_hz - 20, max(20, x_to_freq(mouse_x, spec_x, spec_w)));
      update_parameters();
      slider_automate(slider2);
    ) : drag_id = 0;
  );
  drag_id == 102 ? (
    (mouse_cap & 1) ? (
      high_cut_hz = max(low_cut_hz + 20, min(20000, x_to_freq(mouse_x, spec_x, spec_w)));
      update_parameters();
      slider_automate(slider3);
    ) : drag_id = 0;
  );

  // Hover Frequency & dB Readout Badge (Top-Right of Spectrum Analyzer)
  (mouse_x >= spec_x && mouse_x <= spec_x + spec_w && mouse_y >= spec_y && mouse_y <= spec_y + spec_h && !adv_hit) ? (
    hover_freq = x_to_freq(mouse_x, spec_x, spec_w);
    hover_db   = -((mouse_y - spec_y) / spec_h) * 24.0;
    hover_freq >= 1000 ? (
      sprintf(#hover_str, "%.2f kHz   %.1f dB", hover_freq * 0.001, hover_db);
    ) : (
      sprintf(#hover_str, "%d Hz   %.1f dB", hover_freq, hover_db);
    );
    gfx_setfont(3);
    gfx_measurestr(#hover_str, hw, hh);
    hb_w = hw + 20; hb_h = hh + 10;
    hb_x = spec_x + spec_w - hb_w - 12;
    hb_y = spec_y + 10;
    draw_panel_box(hb_x, hb_y, hb_w, hb_h, 0.10, 0.11, 0.16, 0.32, 0.36, 0.50);
    gfx_set(0.92, 0.95, 1.0, 1.0);
    gfx_x = hb_x + 10; gfx_y = hb_y + 5;
    gfx_drawstr(#hover_str);
  );
);

// =========================================================================
// 3B. IN-PLACE ADVANCED OVERLAY (REPLACES SPECTRUM VIEWPORT WHEN ACTIVE)
// =========================================================================
adv_anim > 0.05 ? (
  // Translucent dark backdrop over the spectrum analyzer (keeps live GR curves subtly visible)
  gfx_set(0.075, 0.078, 0.122, 0.90 * adv_anim);
  gfx_rect(spec_x + 1, spec_y + 1, spec_w - 2, spec_h - 2);

  // Highlighted cyan-blue inner border when Advanced Overlay is active
  gfx_set(0.45, 0.78, 0.98, 0.65 * adv_anim);
  gfx_rect(spec_x, spec_y, spec_w, spec_h, 0);

  // Overlay Header Strip
  ov_hdr_h = floor(34 * S);
  gfx_set(0.11, 0.12, 0.18, 0.95 * adv_anim);
  gfx_rect(spec_x + 1, spec_y + 1, spec_w - 2, ov_hdr_h);
  gfx_set(0.22, 0.25, 0.36, 0.95 * adv_anim);
  gfx_line(spec_x + 1, spec_y + ov_hdr_h, spec_x + spec_w - 2, spec_y + ov_hdr_h);

  gfx_setfont(2);
  gfx_set(0.54, 0.78, 1.0, adv_anim);
  gfx_x = spec_x + floor(16 * S);
  gfx_y = spec_y + floor(8 * S);
  gfx_drawstr("ADVANCED SETTINGS  —  STEREO ROUTING & ENVELOPE BALLISTICS");

  adv_open ? (
    adv_body_y = spec_y + ov_hdr_h;
    adv_body_h = spec_h - ov_hdr_h;
    adv_cy     = adv_body_y + adv_body_h * 0.39;
    r_adv      = min(floor(35 * S), floor(adv_body_h * 0.23));

    // Vertical divider separating Rotary Knobs (left 63%) and Mode/Audition Toggles (right 37%)
    div_x = spec_x + floor(spec_w * 0.63);
    gfx_set(0.20, 0.22, 0.32, 1.0);
    gfx_line(div_x, adv_body_y + floor(14 * S), div_x, spec_y + spec_h - floor(14 * S));

    // 1. Pan / M-S Balance Knob
    proc_mode == 0 ? (
      pan_val < -0.5 ? sprintf(#pan_str, "%d %% L", abs(pan_val)) :
      pan_val >  0.5 ? sprintf(#pan_str, "%d %% R", pan_val) : strcpy(#pan_str, "Center");
      strcpy(#pan_lbl, "PAN (L/R)");
    ) : (
      pan_val < -0.5 ? sprintf(#pan_str, "%d %% Mid", abs(pan_val)) :
      pan_val >  0.5 ? sprintf(#pan_str, "%d %% Side", pan_val) : strcpy(#pan_str, "Even M/S");
      strcpy(#pan_lbl, "M/S BALANCE");
    );
    new_pan = draw_rotary_knob(4, spec_x + spec_w * 0.115, adv_cy, r_adv, pan_val, -100.0, 100.0, 0.0, #pan_lbl, #pan_str, 0);
    abs(new_pan - pan_val) > 0.01 ? (
      pan_val = new_pan;
      update_parameters();
      slider_automate(slider7);
    );

    // 2. Attack Knob
    sprintf(#att_str, "%.1f ms", attack_ms);
    new_att = draw_rotary_knob(5, spec_x + spec_w * 0.315, adv_cy, r_adv, attack_ms, 0.1, 200.0, 10.0, "ATTACK", #att_str, 0);
    abs(new_att - attack_ms) > 0.01 ? (
      attack_ms = new_att;
      update_parameters();
      slider_automate(slider4);
    );

    // 3. Release Knob
    sprintf(#rel_str, "%d ms", release_ms);
    new_rel = draw_rotary_knob(6, spec_x + spec_w * 0.515, adv_cy, r_adv, release_ms, 5.0, 1000.0, 80.0, "RELEASE", #rel_str, 0);
    abs(new_rel - release_ms) > 0.01 ? (
      release_ms = new_rel;
      update_parameters();
      slider_automate(slider5);
    );

    // Right-side Segmented Mode & SC Audition Buttons inside Overlay
    btn_x = div_x + floor(18 * S);
    btn_w = (spec_x + spec_w) - btn_x - floor(18 * S);
    btn_h = floor(38 * S);

    // Mode Toggle (L/R vs M/S)
    mode_y = adv_body_y + floor(adv_body_h * 0.17);
    mode_hit = mouse_x >= btn_x && mouse_x <= (btn_x + btn_w) && mouse_y >= mode_y && mouse_y <= (mode_y + btn_h);
    (mouse_cap & 1) && !(last_mouse_cap & 1) && mode_hit ? (
      proc_mode = !proc_mode;
      slider_automate(slider6);
    );
    draw_panel_box(btn_x, mode_y, btn_w, btn_h, 0.14, 0.16, 0.24, 0.32, 0.38, 0.54);
    gfx_setfont(4);
    gfx_set(0.54, 0.78, 1.0, 1.0);
    proc_mode == 0 ? strcpy(#m_str, "MODE: STEREO (L/R)") : strcpy(#m_str, "MODE: MID / SIDE");
    gfx_measurestr(#m_str, mw, mh);
    gfx_x = btn_x + (btn_w - mw) * 0.5; gfx_y = mode_y + (btn_h - mh) * 0.5;
    gfx_drawstr(#m_str);

    // SC Audition Toggle
    aud_y = mode_y + btn_h + floor(14 * S);
    aud_hit = mouse_x >= btn_x && mouse_x <= (btn_x + btn_w) && mouse_y >= aud_y && mouse_y <= (aud_y + btn_h);
    (mouse_cap & 1) && !(last_mouse_cap & 1) && aud_hit ? (
      audition_on = !audition_on;
      slider_automate(slider9);
    );
    audition_on ? (
      draw_panel_box(btn_x, aud_y, btn_w, btn_h, 0.85, 0.48, 0.14, 1.0, 0.75, 0.35);
      gfx_set(1.0, 1.0, 1.0, 1.0);
    ) : (
      draw_panel_box(btn_x, aud_y, btn_w, btn_h, 0.14, 0.16, 0.24, 0.32, 0.38, 0.54);
      gfx_set(0.82, 0.86, 0.96, 1.0);
    );
    gfx_setfont(4);
    gfx_measurestr("SIDECHAIN AUDITION", aw, ah);
    gfx_x = btn_x + (btn_w - aw) * 0.5; gfx_y = aud_y + (btn_h - ah) * 0.5;
    gfx_drawstr("SIDECHAIN AUDITION");
  );
);

// =========================================================================
// 3C. PINNED "ADV" TOGGLE PILL BUTTON (ALWAYS ON TOP, NEVER SHIFTS POSITION)
// =========================================================================
(mouse_cap & 1) && !(last_mouse_cap & 1) && adv_hit ? (
  adv_open = !adv_open;
  drag_id = 0;
  slider_automate(slider10);
);

adv_open ? (
  draw_panel_box(adv_btn_x, adv_btn_y, adv_btn_w, adv_btn_h, 0.20, 0.42, 0.72, 0.55, 0.84, 1.0);
) : (
  draw_panel_box(adv_btn_x, adv_btn_y, adv_btn_w, adv_btn_h, 0.13, 0.14, 0.21, 0.30, 0.33, 0.46);
);

dot_cx = adv_btn_x + floor(15 * S);
dot_cy = adv_btn_y + adv_btn_h * 0.5;
adv_open ? gfx_set(0.55, 0.92, 1.0, 1.0) : gfx_set(0.32, 0.65, 0.95, 0.9);
gfx_circle(dot_cx, dot_cy, floor(5 * S), 1, 1);

gfx_setfont(4);
gfx_set(0.95, 0.97, 1.0, 1.0);
gfx_measurestr("ADV", adw, adh);
gfx_x = dot_cx + floor(10 * S);
gfx_y = adv_btn_y + (adv_btn_h - adh) * 0.5;
gfx_drawstr("ADV");

// =========================================================================
// 4. MAIN CONTROLS CARD (CONSTANT POSITION & SIZE)
// =========================================================================
draw_panel_box(ctrl_x, ctrl_y, ctrl_w, ctrl_h, 0.095, 0.098, 0.145, 0.20, 0.22, 0.31);

knob_cy = ctrl_y + ctrl_h * 0.39;
r_side  = min(floor(40 * S), floor(ctrl_h * 0.22));
r_hero  = min(floor(62 * S), floor(ctrl_h * 0.31));

// Low-Cut Knob
lc_norm = (log(max(MIN_FREQ, low_cut_hz)) - LOG_MIN) / (LOG_MAX - LOG_MIN);
low_cut_hz >= 1000 ? sprintf(#lc_str, "%.2f kHz", low_cut_hz*0.001) : sprintf(#lc_str, "%d Hz", low_cut_hz);
new_lc_norm = draw_rotary_knob(1, ctrl_x + ctrl_w * 0.20, knob_cy, r_side, lc_norm, 0.0, 1.0, 0.0, "LOW CUT", #lc_str, 0);
abs(new_lc_norm - lc_norm) > 0.0001 ? (
  low_cut_hz = min(high_cut_hz - 20, exp(LOG_MIN + new_lc_norm * (LOG_MAX - LOG_MIN)));
  update_parameters();
  slider_automate(slider2);
);

// Central Hero AMOUNT Knob
sprintf(#amt_str, "%.1f %%", amount_pct);
new_amt = draw_rotary_knob(2, ctrl_x + ctrl_w * 0.50, knob_cy - floor(4 * S), r_hero, amount_pct, 0.0, 100.0, 25.0, "AMOUNT", #amt_str, 1);
abs(new_amt - amount_pct) > 0.001 ? (
  amount_pct = new_amt;
  slider_automate(slider1);
);

// High-Cut Knob
hc_norm = (log(max(MIN_FREQ, high_cut_hz)) - LOG_MIN) / (LOG_MAX - LOG_MIN);
high_cut_hz >= 1000 ? sprintf(#hc_str, "%.2f kHz", high_cut_hz*0.001) : sprintf(#hc_str, "%d Hz", high_cut_hz);
new_hc_norm = draw_rotary_knob(3, ctrl_x + ctrl_w * 0.80, knob_cy, r_side, hc_norm, 0.0, 1.0, 1.0, "HIGH CUT", #hc_str, 0);
abs(new_hc_norm - hc_norm) > 0.0001 ? (
  high_cut_hz = max(low_cut_hz + 20, exp(LOG_MIN + new_hc_norm * (LOG_MAX - LOG_MIN)));
  update_parameters();
  slider_automate(slider3);
);

// =========================================================================
// 5. INFO OVERLAY MODAL
// =========================================================================
info_open ? (
  mw = floor(W * 0.74);
  mh = floor(280 * S);
  mx = (W - mw) * 0.5;
  my = (H - mh) * 0.5;

  draw_panel_box(mx, my, mw, mh, 0.07, 0.07, 0.11, 0.54, 0.71, 0.98);

  gfx_setfont(1);
  gfx_set(0.54, 0.71, 0.98, 1.0);
  gfx_x = mx + 24; gfx_y = my + 20;
  gfx_drawstr("SpectralCarver JSFX v1.3");

  gfx_setfont(3);
  gfx_set(0.90, 0.93, 0.98, 1.0);
  lh_step = floor(28 * S);
  ty = my + 64;
  gfx_x = mx + 24; gfx_y = ty;             gfx_drawstr("• 32-Band Cytomic SVF dynamic spectral ducker");
  gfx_x = mx + 24; gfx_y = ty + lh_step;   gfx_drawstr("• Route your priority track to Sidechain Channels 3/4");
  gfx_x = mx + 24; gfx_y = ty + lh_step*2; gfx_drawstr("• Click ADV in the analyzer corner for zero-shift ballistics & M/S routing");
  gfx_x = mx + 24; gfx_y = ty + lh_step*3; gfx_drawstr("• Drag knobs vertically (hold Ctrl for fine adjustment, double-click reset)");
  gfx_x = mx + 24; gfx_y = ty + lh_step*4; gfx_drawstr("• Drag the LC and HC flags directly inside the spectrum");
  gfx_x = mx + 24; gfx_y = ty + lh_step*5; gfx_drawstr("• Use TEXT: 100%/120%/140% in the top bar for Linux DPI scaling");

  gfx_set(0.58, 0.64, 0.78, 1.0);
  gfx_x = mx + 24; gfx_y = my + mh - 34;
  gfx_drawstr("Click anywhere on the Info card or header logo to close.");

  (mouse_cap & 1) && !(last_mouse_cap & 1) &&
  (mouse_x >= mx && mouse_x <= mx + mw && mouse_y >= my && mouse_y <= my + mh) ? (
    info_open = 0;
  );
);

last_mouse_cap = mouse_cap;
