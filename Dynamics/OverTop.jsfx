desc:OverTop (3-Band Upward/Downward Multiband Compressor)
// @description OverTop (3-Band Upward/Downward Multiband Compressor)
// @author MemoryAPI
// @version 1.2.0
// @changelog
//   - Applied exact OTT 0.15x Attack and 0.25x Release internal time multipliers
//   - Corrected High Band makeup gain to +10.3 dB (1.0 + 2.27304697 * Depth)
//   - Eliminated destructive dry/wet phase cancellation: Depth now scales compression slopes & makeup directly
//   - Switched from Peak detection to true stereo RMS power detection (L^2 + R^2)
//   - Moved Attack/Release smoothing into the dB gain-reduction domain
//   - Upgraded crossover to phase-aligned 4th-Order Linkwitz-Riley (LR4, 24 dB/oct)
// @about
//   # OverTop
//   3-Band Upward and Downward Multiband Dynamics Processor (OTT style) for aggressive presence, punch, and detail leveling.
//
//   ### Features
//   - Phase-aligned 4th-Order Linkwitz-Riley (LR4, 24 dB/oct) crossover at 88.3 Hz and 2.5 kHz
//   - True stereo RMS power detection (L^2 + R^2) with Attack/Release smoothing in the dB gain domain
//   - Authentic OTT nominal time constants with 0.15x Attack and 0.25x Release multipliers
//   - Calibrated +10.3 dB High Band linear makeup gain (1.0 + 2.27304697 * Depth)
//   - Phase-coherent Depth scaling directly modulating compression slopes and makeup without comb filtering
//   - Interactive threshold bar editing: drag horizontally to shift thresholds per band
//   - Per-band bypass switches and dedicated band output gain trims
//   - Global Depth, Time scaling, and In/Out gain controls
//   - Dedicated Upward % and Downward % intensity knobs
//   - Modern animated vector UI with real-time level meters and gain reduction traces
//   - Scalable HiDPI text zoom (100% - 140%)
// @provides
//   [effect] OverTop.jsfx

// Sliders are hidden (- prefix) for the custom @gfx interface while remaining automatable.
slider1:depth_pct=100<0,100,0.1>-Depth (%)
slider2:time_pct=100<1,1000,1>-Time (%)
slider3:in_gain_db=0<-24,24,0.1>-Input Gain (dB)
slider4:out_gain_db=0<-24,24,0.1>-Output Gain (dB)
slider5:up_str_pct=100<0,200,0.1>-Upward Strength (%)
slider6:dn_str_pct=100<0,200,0.1>-Downward Strength (%)
slider7:gain_l_db=0<-24,24,0.1>-Low Band Gain (dB)
slider8:gain_m_db=0<-24,24,0.1>-Mid Band Gain (dB)
slider9:gain_h_db=0<-24,24,0.1>-High Band Gain (dB)
slider10:thresh_offset_l=0<-24,24,0.1>-Low Threshold Offset (dB)
slider11:thresh_offset_m=0<-24,24,0.1>-Mid Threshold Offset (dB)
slider12:thresh_offset_h=0<-24,24,0.1>-High Threshold Offset (dB)
slider13:byp_l=0<0,1,1{Active,Bypass}>-Bypass Low
slider14:byp_m=0<0,1,1{Active,Bypass}>-Bypass Mid
slider15:byp_h=0<0,1,1{Active,Bypass}>-Bypass High
slider16:active_on=1<0,1,1{Bypass,Active}>-Master Active
slider17:ui_zoom=1.20<1.0,1.4,0.2>-UI Text Zoom

in_pin:Left Input
in_pin:Right Input
out_pin:Left Output
out_pin:Right Output

@init
ext_noinit = 1.0;

function DB_TO_K(x)
(
  exp((x) * 0.11512925464970229)
);

function K_TO_DB(lin)
(
  8.685889638065036 * log(max(0.000000000001, lin))
);

// Crossover Frequencies
XOVER_LOW_HZ  = 88.3;
XOVER_HIGH_HZ = 2500.0;

// Factory Base Thresholds (dB)
BASE_DN_L = -33.8; BASE_UP_L = -40.8;
BASE_DN_M = -30.2; BASE_UP_M = -41.8;
BASE_DN_H = -35.5; BASE_UP_H = -40.8;

// Exact OTT Linear Makeup Multipliers at 100% Depth:
// Low:  1 + 0.81970084 = 1.8197 (+5.20 dB)
// Mid:  1 + 0.92752498 = 1.9275 (+5.70 dB)
// High: 1 + 2.27304697 = 3.2730 (+10.30 dB)
MAKEUP_MULT_L = 0.81970084;
MAKEUP_MULT_M = 0.927524984;
MAKEUP_MULT_H = 2.27304697;

// Factory Base Ratios
RATIO_DN_L = 66.7; RATIO_UP_L = 4.17;
RATIO_DN_M = 66.7; RATIO_UP_M = 4.17;
RATIO_DN_H = 99.0; RATIO_UP_H = 4.17;

// Factory Base Nominal Time Constants (ms)
// Multiplied internally by 0.15 (Attack) and 0.25 (Release) per OTT.vst3
ATT_L_MS = 47.8; REL_L_MS = 282.0;
ATT_M_MS = 22.4; REL_M_MS = 282.0;
ATT_H_MS = 13.5; REL_H_MS = 132.0;

function update_parameters()
  local(SAFE_SRATE, depth, k_bw, g_lo, g_hi, t_scale,
        att_scale, rel_scale, dn_eff, up_eff,
        att_l_s, rel_l_s, att_m_s, rel_m_s, att_h_s, rel_h_s)
(
  SAFE_SRATE = max(8000.0, srate);
  depth      = depth_pct * 0.01;

  in_lin  = DB_TO_K(in_gain_db);
  out_lin = DB_TO_K(out_gain_db);

  // Exact OTT linear makeup scaling + user band gain knob
  band_lin_l = (1.0 + depth * MAKEUP_MULT_L) * DB_TO_K(gain_l_db);
  band_lin_m = (1.0 + depth * MAKEUP_MULT_M) * DB_TO_K(gain_m_db);
  band_lin_h = (1.0 + depth * MAKEUP_MULT_H) * DB_TO_K(gain_h_db);

  // Effective thresholds (shifted by interactive bar drag offsets)
  dn_thr_l = BASE_DN_L + thresh_offset_l;
  up_thr_l = BASE_UP_L + thresh_offset_l;
  dn_thr_m = BASE_DN_M + thresh_offset_m;
  up_thr_m = BASE_UP_M + thresh_offset_m;
  dn_thr_h = BASE_DN_H + thresh_offset_h;
  up_thr_h = BASE_UP_H + thresh_offset_h;

  // Depth directly scales upward and downward compression intensity (no dry/wet comb filtering)
  dn_eff = min(1.5, depth * (dn_str_pct * 0.01));
  up_eff = depth * (up_str_pct * 0.01);

  dn_slope_l = (1.0 - (1.0 / RATIO_DN_L)) * dn_eff;
  dn_slope_m = (1.0 - (1.0 / RATIO_DN_M)) * dn_eff;
  dn_slope_h = (1.0 - (1.0 / RATIO_DN_H)) * dn_eff;

  up_slope_l = (1.0 - (1.0 / RATIO_UP_L)) * up_eff;
  up_slope_m = (1.0 - (1.0 / RATIO_UP_M)) * up_eff;
  up_slope_h = (1.0 - (1.0 / RATIO_UP_H)) * up_eff;

  // Exact OTT internal time scaling: 0.15x Attack, 0.25x Release
  t_scale   = max(0.01, time_pct * 0.01);
  att_scale = t_scale * 0.150000006;
  rel_scale = t_scale * 0.25;

  att_l_s = max(0.0001, (ATT_L_MS * 0.001) * att_scale);
  rel_l_s = max(0.0005, (REL_L_MS * 0.001) * rel_scale);
  att_m_s = max(0.0001, (ATT_M_MS * 0.001) * att_scale);
  rel_m_s = max(0.0005, (REL_M_MS * 0.001) * rel_scale);
  att_h_s = max(0.0001, (ATT_H_MS * 0.001) * att_scale);
  rel_h_s = max(0.0005, (REL_H_MS * 0.001) * rel_scale);

  att_coeff_l = exp(-1.0 / (att_l_s * SAFE_SRATE));
  rel_coeff_l = exp(-1.0 / (rel_l_s * SAFE_SRATE));
  att_coeff_m = exp(-1.0 / (att_m_s * SAFE_SRATE));
  rel_coeff_m = exp(-1.0 / (rel_m_s * SAFE_SRATE));
  att_coeff_h = exp(-1.0 / (att_h_s * SAFE_SRATE));
  rel_coeff_h = exp(-1.0 / (rel_h_s * SAFE_SRATE));

  // Fast 2.0 ms RMS power window coefficient (tracks stereo energy L^2 + R^2)
  rms_coeff = exp(-1.0 / (0.0020 * SAFE_SRATE));

  // Cytomic SVF Butterworth (Q = 0.7071) cascaded twice -> 4th-Order Linkwitz-Riley (LR4)
  k_bw = 1.4142135623730951;

  g_lo  = tan($pi * XOVER_LOW_HZ / SAFE_SRATE);
  lo_a1 = 1.0 / (1.0 + g_lo * (g_lo + k_bw));
  lo_a2 = g_lo * lo_a1;
  lo_a3 = g_lo * lo_a2;
  lo_k  = k_bw;

  g_hi  = tan($pi * min(XOVER_HIGH_HZ, SAFE_SRATE * 0.44) / SAFE_SRATE);
  hi_a1 = 1.0 / (1.0 + g_hi * (g_hi + k_bw));
  hi_a2 = g_hi * hi_a1;
  hi_a3 = g_hi * hi_a2;
  hi_k  = k_bw;
);

function compute_ott_gain_db(in_db, up_thr, dn_thr, up_slope, dn_slope)
  local(g_db, below_db)
(
  g_db = 0.0;
  in_db > dn_thr ? (
    g_db = -(in_db - dn_thr) * dn_slope;
  ) : (in_db < up_thr && in_db > -80.0) ? (
    // OTT upward knee clamps maximum boost below -70 dB noise floor
    below_db = up_thr - max(-70.0, in_db);
    in_db < -60.0 ? (
      below_db *= max(0.0, (in_db + 80.0) * 0.05);
    );
    g_db = below_db * up_slope;
  );
  g_db;
);

!init_done ? (
  ui_zoom < 1.0 ? ui_zoom = 1.20;
  active_on = 1;
  rms_sq_l = 0.000001; rms_sq_m = 0.000001; rms_sq_h = 0.000001;
  gr_db_l  = 0.0;      gr_db_m  = 0.0;      gr_db_h  = 0.0;
  db_in_l  = -60.0;    db_in_m  = -60.0;    db_in_h  = -60.0;
  update_parameters();
  init_done = 1;
);

update_parameters();

@slider
update_parameters();

@block
update_parameters();

@sample
raw_l = spl0;
raw_r = spl1;

x_l = raw_l * in_lin;
x_r = raw_r * in_lin;

// =========================================================================
// 1. 4TH-ORDER LINKWITZ-RILEY (LR4, 24 dB/oct) 3-BAND CROSSOVER
// =========================================================================
// --- LEFT CHANNEL: LOW SPLIT (88.3 Hz LR4) ---
v3 = x_l - lo1_l_ic2;
v1 = lo_a1 * lo1_l_ic1 + lo_a2 * v3;
v2 = lo1_l_ic2 + lo_a2 * lo1_l_ic1 + lo_a3 * v3;
lo1_l_ic1 = 2.0 * v1 - lo1_l_ic1; lo1_l_ic2 = 2.0 * v2 - lo1_l_ic2;
lp1_l = v2;
hp1_l = x_l - lo_k * v1 - v2;

v3 = lp1_l - lo2_l_ic2;
v1 = lo_a1 * lo2_l_ic1 + lo_a2 * v3;
v2 = lo2_l_ic2 + lo_a2 * lo2_l_ic1 + lo_a3 * v3;
lo2_l_ic1 = 2.0 * v1 - lo2_l_ic1; lo2_l_ic2 = 2.0 * v2 - lo2_l_ic2;
raw_low_L = v2;

v3 = hp1_l - lo3_l_ic2;
v1 = lo_a1 * lo3_l_ic1 + lo_a2 * v3;
v2 = lo3_l_ic2 + lo_a2 * lo3_l_ic1 + lo_a3 * v3;
lo3_l_ic1 = 2.0 * v1 - lo3_l_ic1; lo3_l_ic2 = 2.0 * v2 - lo3_l_ic2;
mh_L = hp1_l - lo_k * v1 - v2;

// Allpass on Low Band at 2.5 kHz to keep Low phase-aligned with Mid + High
v3 = raw_low_L - ap_l_ic2;
v1 = hi_a1 * ap_l_ic1 + hi_a2 * v3;
v2 = ap_l_ic2 + hi_a2 * ap_l_ic1 + hi_a3 * v3;
ap_l_ic1 = 2.0 * v1 - ap_l_ic1; ap_l_ic2 = 2.0 * v2 - ap_l_ic2;
band_l_L = raw_low_L - 2.0 * hi_k * v1;

// --- LEFT CHANNEL: HIGH SPLIT (2500 Hz LR4) ---
v3 = mh_L - hi1_l_ic2;
v1 = hi_a1 * hi1_l_ic1 + hi_a2 * v3;
v2 = hi1_l_ic2 + hi_a2 * hi1_l_ic1 + hi_a3 * v3;
hi1_l_ic1 = 2.0 * v1 - hi1_l_ic1; hi1_l_ic2 = 2.0 * v2 - hi1_l_ic2;
lp_hi1_l = v2;
hp_hi1_l = mh_L - hi_k * v1 - v2;

v3 = lp_hi1_l - hi2_l_ic2;
v1 = hi_a1 * hi2_l_ic1 + hi_a2 * v3;
v2 = hi2_l_ic2 + hi_a2 * hi2_l_ic1 + hi_a3 * v3;
hi2_l_ic1 = 2.0 * v1 - hi2_l_ic1; hi2_l_ic2 = 2.0 * v2 - hi2_l_ic2;
band_m_L = v2;

v3 = hp_hi1_l - hi3_l_ic2;
v1 = hi_a1 * hi3_l_ic1 + hi_a2 * v3;
v2 = hi3_l_ic2 + hi_a2 * hi3_l_ic1 + hi_a3 * v3;
hi3_l_ic1 = 2.0 * v1 - hi3_l_ic1; hi3_l_ic2 = 2.0 * v2 - hi3_l_ic2;
band_h_L = hp_hi1_l - hi_k * v1 - v2;

// --- RIGHT CHANNEL: LOW SPLIT (88.3 Hz LR4) ---
v3 = x_r - lo1_r_ic2;
v1 = lo_a1 * lo1_r_ic1 + lo_a2 * v3;
v2 = lo1_r_ic2 + lo_a2 * lo1_r_ic1 + lo_a3 * v3;
lo1_r_ic1 = 2.0 * v1 - lo1_r_ic1; lo1_r_ic2 = 2.0 * v2 - lo1_r_ic2;
lp1_r = v2;
hp1_r = x_r - lo_k * v1 - v2;

v3 = lp1_r - lo2_r_ic2;
v1 = lo_a1 * lo2_r_ic1 + lo_a2 * v3;
v2 = lo2_r_ic2 + lo_a2 * lo2_r_ic1 + lo_a3 * v3;
lo2_r_ic1 = 2.0 * v1 - lo2_r_ic1; lo2_r_ic2 = 2.0 * v2 - lo2_r_ic2;
raw_low_R = v2;

v3 = hp1_r - lo3_r_ic2;
v1 = lo_a1 * lo3_r_ic1 + lo_a2 * v3;
v2 = lo3_r_ic2 + lo_a2 * lo3_r_ic1 + lo_a3 * v3;
lo3_r_ic1 = 2.0 * v1 - lo3_r_ic1; lo3_r_ic2 = 2.0 * v2 - lo3_r_ic2;
mh_R = hp1_r - lo_k * v1 - v2;

// Allpass on Low Band at 2.5 kHz (Right Channel)
v3 = raw_low_R - ap_r_ic2;
v1 = hi_a1 * ap_r_ic1 + hi_a2 * v3;
v2 = ap_r_ic2 + hi_a2 * ap_r_ic1 + hi_a3 * v3;
ap_r_ic1 = 2.0 * v1 - ap_r_ic1; ap_r_ic2 = 2.0 * v2 - ap_r_ic2;
band_l_R = raw_low_R - 2.0 * hi_k * v1;

// --- RIGHT CHANNEL: HIGH SPLIT (2500 Hz LR4) ---
v3 = mh_R - hi1_r_ic2;
v1 = hi_a1 * hi1_r_ic1 + hi_a2 * v3;
v2 = hi1_r_ic2 + hi_a2 * hi1_r_ic1 + hi_a3 * v3;
hi1_r_ic1 = 2.0 * v1 - hi1_r_ic1; hi1_r_ic2 = 2.0 * v2 - hi1_r_ic2;
lp_hi1_r = v2;
hp_hi1_r = mh_R - hi_k * v1 - v2;

v3 = lp_hi1_r - hi2_r_ic2;
v1 = hi_a1 * hi2_r_ic1 + hi_a2 * v3;
v2 = hi2_r_ic2 + hi_a2 * hi2_r_ic1 + hi_a3 * v3;
hi2_r_ic1 = 2.0 * v1 - hi2_r_ic1; hi2_r_ic2 = 2.0 * v2 - hi2_r_ic2;
band_m_R = v2;

v3 = hp_hi1_r - hi3_r_ic2;
v1 = hi_a1 * hi3_r_ic1 + hi_a2 * v3;
v2 = hi3_r_ic2 + hi_a2 * hi3_r_ic1 + hi_a3 * v3;
hi3_r_ic1 = 2.0 * v1 - hi3_r_ic1; hi3_r_ic2 = 2.0 * v2 - hi3_r_ic2;
band_h_R = hp_hi1_r - hi_k * v1 - v2;

// =========================================================================
// 2. STEREO RMS POWER DETECTION (L^2 + R^2) & dB-DOMAIN GAIN SMOOTHING
// =========================================================================
// Stereo power = (L^2 + R^2) * 0.5 (normalized so 0 dBFS stereo = 0 dB)
pwr_l = 0.5 * (band_l_L * band_l_L + band_l_R * band_l_R) + 0.000000000000000000000001;
pwr_m = 0.5 * (band_m_L * band_m_L + band_m_R * band_m_R) + 0.000000000000000000000001;
pwr_h = 0.5 * (band_h_L * band_h_L + band_h_R * band_h_R) + 0.000000000000000000000001;

rms_sq_l = (rms_sq_l - pwr_l) * rms_coeff + pwr_l;
rms_sq_m = (rms_sq_m - pwr_m) * rms_coeff + pwr_m;
rms_sq_h = (rms_sq_h - pwr_h) * rms_coeff + pwr_h;

// 0.5 * 8.685889638 * log(rms_sq) == 8.685889638 * log(sqrt(rms_sq))
raw_db_l = 4.342944819032518 * log(max(0.000000000000000000000001, rms_sq_l));
raw_db_m = 4.342944819032518 * log(max(0.000000000000000000000001, rms_sq_m));
raw_db_h = 4.342944819032518 * log(max(0.000000000000000000000001, rms_sq_h));

// Smooth UI input level meters slightly for visual readability
db_in_l = max(raw_db_l, db_in_l - 0.15);
db_in_m = max(raw_db_m, db_in_m - 0.15);
db_in_h = max(raw_db_h, db_in_h - 0.15);

// --- LOW BAND GAIN SMOOTHING IN dB DOMAIN ---
!byp_l ? (
  tgt_gr_l = compute_ott_gain_db(raw_db_l, up_thr_l, dn_thr_l, up_slope_l, dn_slope_l);
  tgt_gr_l < gr_db_l ? (
    gr_db_l = att_coeff_l * gr_db_l + (1.0 - att_coeff_l) * tgt_gr_l;
  ) : (
    gr_db_l = rel_coeff_l * gr_db_l + (1.0 - rel_coeff_l) * tgt_gr_l;
  );
  lin_gr_l = DB_TO_K(gr_db_l) * band_lin_l;
) : (
  gr_db_l  = 0.0;
  lin_gr_l = 1.0;
);

// --- MID BAND GAIN SMOOTHING IN dB DOMAIN ---
!byp_m ? (
  tgt_gr_m = compute_ott_gain_db(raw_db_m, up_thr_m, dn_thr_m, up_slope_m, dn_slope_m);
  tgt_gr_m < gr_db_m ? (
    gr_db_m = att_coeff_m * gr_db_m + (1.0 - att_coeff_m) * tgt_gr_m;
  ) : (
    gr_db_m = rel_coeff_m * gr_db_m + (1.0 - rel_coeff_m) * tgt_gr_m;
  );
  lin_gr_m = DB_TO_K(gr_db_m) * band_lin_m;
) : (
  gr_db_m  = 0.0;
  lin_gr_m = 1.0;
);

// --- HIGH BAND GAIN SMOOTHING IN dB DOMAIN ---
!byp_h ? (
  tgt_gr_h = compute_ott_gain_db(raw_db_h, up_thr_h, dn_thr_h, up_slope_h, dn_slope_h);
  tgt_gr_h < gr_db_h ? (
    gr_db_h = att_coeff_h * gr_db_h + (1.0 - att_coeff_h) * tgt_gr_h;
  ) : (
    gr_db_h = rel_coeff_h * gr_db_h + (1.0 - rel_coeff_h) * tgt_gr_h;
  );
  lin_gr_h = DB_TO_K(gr_db_h) * band_lin_h;
) : (
  gr_db_h  = 0.0;
  lin_gr_h = 1.0;
);

// 100% Wet Phase-Coherent Sum (Depth is already baked into slopes and band_lin makeup!)
wet_l = band_l_L * lin_gr_l + band_m_L * lin_gr_m + band_h_L * lin_gr_h;
wet_r = band_l_R * lin_gr_l + band_m_R * lin_gr_m + band_h_R * lin_gr_h;

active_on ? (
  out_l = wet_l * out_lin;
  out_r = wet_r * out_lin;
) : (
  out_l = raw_l;
  out_r = raw_r;
);

(out_l != out_l || abs(out_l) > 4.0) ? out_l = max(-4.0, min(4.0, out_l));
(out_r != out_r || abs(out_r) > 4.0) ? out_r = max(-4.0, min(4.0, out_r));

spl0 = out_l;
spl1 = out_r;

@gfx 720 680
// Catppuccin Mocha Base (#1E1E2E: R=30, G=30, B=46)
gfx_clear = 30 + (30 * 256) + (46 * 65536);

W = max(620, gfx_w);
H = max(580, gfx_h);

// Responsive geometry scale & Linux X11 font multiplier
S  = min(W / 720.0, H / 680.0);
TS = S * max(1.0, ui_zoom);

f_title = max(18, floor(22 * TS));
f_sec   = max(12, floor(13 * TS));
f_val   = max(13, floor(14 * TS));
f_btn   = max(12, floor(13 * TS));
f_grid  = max(11, floor(12 * TS));
f_band  = max(16, floor(19 * TS));

gfx_setfont(1, "sans-serif", f_title, 'b');
gfx_setfont(2, "sans-serif", f_sec,   'b');
gfx_setfont(3, "sans-serif", f_val,   0);
gfx_setfont(4, "sans-serif", f_btn,   'b');
gfx_setfont(5, "sans-serif", f_grid,  0);
gfx_setfont(6, "sans-serif", f_band,  'b');

function draw_panel_box(bx, by, bw, bh, r_bg, g_bg, b_bg, r_bd, g_bd, b_bd)
(
  gfx_set(r_bg, g_bg, b_bg, 1.0);
  gfx_rect(bx, by, bw, bh);
  gfx_set(r_bd, g_bd, b_bd, 1.0);
  gfx_rect(bx, by, bw, bh, 0);
);

// Standard Rotary Knob (Label + Pill Badge underneath)
function draw_rotary_knob(id, cx, cy, r, val, vmin, vmax, vdef, label, val_str, is_hero, bipolar)
  local(norm, zero_norm, hit, hover, sens, delta, ang_start, ang_end, ang_val,
        steps, st, t0, t1, a0, a1, active_seg, px0, py0, px1, py1, lw, lh, vw, vh, pill_w, pill_h, pill_x, pill_y)
(
  norm = max(0.0, min(1.0, (val - vmin) / (vmax - vmin)));

  hit = ((mouse_x - cx)*(mouse_x - cx) + (mouse_y - cy)*(mouse_y - cy)) <= ((r + 9)*(r + 9));
  hover = hit || (drag_id == id);

  (mouse_cap & 1) && !(last_mouse_cap & 1) && hit ? (
    (time_precise() - last_click_time < 0.28) && (last_click_id == id) ? (
      val = vdef;
      drag_id = 0;
    ) : (
      drag_id = id;
      drag_start_y = mouse_y;
      drag_start_val = val;
      last_click_time = time_precise();
      last_click_id = id;
    );
  );

  drag_id == id ? (
    (mouse_cap & 1) ? (
      sens = (mouse_cap & 4) ? 550.0 : 150.0;
      delta = (drag_start_y - mouse_y) / sens;
      val = max(vmin, min(vmax, drag_start_val + delta * (vmax - vmin)));
    ) : (
      drag_id = 0;
    );
  );

  norm = max(0.0, min(1.0, (val - vmin) / (vmax - vmin)));

  gfx_set(0.05, 0.05, 0.09, 0.85);
  gfx_circle(cx, cy + 3, r + 1, 1, 1);
  hover ? (
    gfx_set(0.54, 0.71, 0.98, 0.16);
    gfx_circle(cx, cy, r + 5, 1, 1);
  );

  gfx_set(0.11, 0.11, 0.17, 1.0);
  gfx_circle(cx, cy, r, 1, 1);
  hover ? gfx_set(0.54, 0.71, 0.98, 0.95) : gfx_set(0.24, 0.25, 0.35, 1.0);
  gfx_circle(cx, cy, r, 0, 1);

  ang_start = -2.356194;
  ang_end   =  2.356194;
  ang_val   = ang_start + norm * (ang_end - ang_start);
  zero_norm = (0.0 - vmin) / (vmax - vmin);

  steps = 32;
  st = 0;
  loop(steps,
    t0 = st / steps;
    t1 = (st + 1) / steps;
    a0 = ang_start + t0 * (ang_end - ang_start);
    a1 = ang_start + t1 * (ang_end - ang_start);

    bipolar ? (
      active_seg = (t1 >= min(zero_norm, norm)) && (t0 <= max(zero_norm, norm));
    ) : (
      active_seg = (t1 <= norm);
    );

    active_seg ? (
      is_hero ? gfx_set(0.45, 0.78, 0.98, 1.0) : gfx_set(0.54, 0.71, 0.98, 0.95);
    ) : (
      gfx_set(0.20, 0.21, 0.29, 0.9);
    );

    gfx_line(cx + sin(a0)*(r-4), cy - cos(a0)*(r-4), cx + sin(a1)*(r-4), cy - cos(a1)*(r-4), 1);
    gfx_line(cx + sin(a0)*(r-5), cy - cos(a0)*(r-5), cx + sin(a1)*(r-5), cy - cos(a1)*(r-5), 1);
    st += 1;
  );

  gfx_set(0.95, 0.97, 1.0, 1.0);
  px0 = cx + sin(ang_val) * (r * 0.25);
  py0 = cy - cos(ang_val) * (r * 0.25);
  px1 = cx + sin(ang_val) * (r - 7);
  py1 = cy - cos(ang_val) * (r - 7);
  gfx_line(px0, py0, px1, py1, 1);
  gfx_line(px0 + 0.6, py0, px1 + 0.6, py1, 1);

  gfx_setfont(2);
  gfx_measurestr(label, lw, lh);
  is_hero ? gfx_set(0.84, 0.90, 1.0, 1.0) : gfx_set(0.70, 0.75, 0.88, 1.0);
  gfx_x = cx - lw * 0.5;
  gfx_y = cy + r + floor(6 * S);
  gfx_drawstr(label);

  gfx_setfont(3);
  gfx_measurestr(val_str, vw, vh);
  pill_w = max(vw + floor(16 * S), floor(74 * S));
  pill_h = vh + floor(6 * S);
  pill_x = cx - pill_w * 0.5;
  pill_y = cy + r + lh + floor(8 * S);

  draw_panel_box(pill_x, pill_y, pill_w, pill_h, 0.06, 0.06, 0.10, hover ? 0.45 : 0.22, hover ? 0.78 : 0.24, hover ? 0.98 : 0.34);
  gfx_set(0.95, 0.97, 1.0, 1.0);
  gfx_x = cx - vw * 0.5;
  gfx_y = pill_y + (pill_h - vh) * 0.5;
  gfx_drawstr(val_str);

  val;
);

// Compact Inline Band Gain Knob (Fits cleanly inside each H/M/L strip row)
function draw_inline_band_knob(id, cx, cy, r, val, vmin, vmax, vdef, val_str, is_byp)
  local(norm, zero_norm, hit, hover, sens, delta, ang_start, ang_end, ang_val,
        steps, st, t0, t1, a0, a1, active_seg, px0, py0, px1, py1, vw, vh, pill_w, pill_h, pill_x, pill_y)
(
  norm = max(0.0, min(1.0, (val - vmin) / (vmax - vmin)));

  hit = ((mouse_x - cx)*(mouse_x - cx) + (mouse_y - cy)*(mouse_y - cy)) <= ((r + 8)*(r + 8));
  hover = hit || (drag_id == id);

  (mouse_cap & 1) && !(last_mouse_cap & 1) && hit ? (
    (time_precise() - last_click_time < 0.28) && (last_click_id == id) ? (
      val = vdef;
      drag_id = 0;
    ) : (
      drag_id = id;
      drag_start_y = mouse_y;
      drag_start_val = val;
      last_click_time = time_precise();
      last_click_id = id;
    );
  );

  drag_id == id ? (
    (mouse_cap & 1) ? (
      sens = (mouse_cap & 4) ? 550.0 : 140.0;
      delta = (drag_start_y - mouse_y) / sens;
      val = max(vmin, min(vmax, drag_start_val + delta * (vmax - vmin)));
    ) : (
      drag_id = 0;
    );
  );

  norm = max(0.0, min(1.0, (val - vmin) / (vmax - vmin)));

  gfx_set(0.05, 0.05, 0.09, 0.85);
  gfx_circle(cx, cy + 2, r + 1, 1, 1);
  gfx_set(0.11, 0.11, 0.17, 1.0);
  gfx_circle(cx, cy, r, 1, 1);
  hover ? gfx_set(0.54, 0.71, 0.98, 0.95) : gfx_set(0.24, 0.25, 0.35, 1.0);
  gfx_circle(cx, cy, r, 0, 1);

  ang_start = -2.356194;
  ang_end   =  2.356194;
  ang_val   = ang_start + norm * (ang_end - ang_start);
  zero_norm = (0.0 - vmin) / (vmax - vmin);

  steps = 28;
  st = 0;
  loop(steps,
    t0 = st / steps;
    t1 = (st + 1) / steps;
    a0 = ang_start + t0 * (ang_end - ang_start);
    a1 = ang_start + t1 * (ang_end - ang_start);
    active_seg = (t1 >= min(zero_norm, norm)) && (t0 <= max(zero_norm, norm));

    active_seg && !is_byp ? (
      gfx_set(0.45, 0.78, 0.98, 1.0);
    ) : (
      gfx_set(0.20, 0.21, 0.29, 0.9);
    );

    gfx_line(cx + sin(a0)*(r-3), cy - cos(a0)*(r-3), cx + sin(a1)*(r-3), cy - cos(a1)*(r-3), 1);
    gfx_line(cx + sin(a0)*(r-4), cy - cos(a0)*(r-4), cx + sin(a1)*(r-4), cy - cos(a1)*(r-4), 1);
    st += 1;
  );

  gfx_set(is_byp ? 0.50 : 0.95, is_byp ? 0.53 : 0.97, is_byp ? 0.62 : 1.0, 1.0);
  px0 = cx + sin(ang_val) * (r * 0.25);
  py0 = cy - cos(ang_val) * (r * 0.25);
  px1 = cx + sin(ang_val) * (r - 6);
  py1 = cy - cos(ang_val) * (r - 6);
  gfx_line(px0, py0, px1, py1, 1);

  // Value readout directly below the inline knob
  gfx_setfont(5);
  gfx_measurestr(val_str, vw, vh);
  pill_w = max(vw + floor(12 * S), floor(62 * S));
  pill_h = vh + floor(4 * S);
  pill_x = cx - pill_w * 0.5;
  pill_y = cy + r + floor(5 * S);

  draw_panel_box(pill_x, pill_y, pill_w, pill_h, 0.06, 0.06, 0.10, hover ? 0.45 : 0.20, hover ? 0.78 : 0.22, hover ? 0.98 : 0.32);
  gfx_set(is_byp ? 0.55 : 0.94, is_byp ? 0.58 : 0.96, is_byp ? 0.68 : 1.0, 1.0);
  gfx_x = cx - vw * 0.5;
  gfx_y = pill_y + (pill_h - vh) * 0.5;
  gfx_drawstr(val_str);

  val;
);

// =========================================================================
// 1. TOP HEADER BAR
// =========================================================================
hdr_h = floor(50 * S);
gfx_set(0.09, 0.09, 0.15, 1.0);
gfx_rect(0, 0, W, hdr_h);
gfx_set(0.20, 0.21, 0.30, 1.0);
gfx_line(0, hdr_h, W, hdr_h);

// Brand Title: OVERTOP in Catppuccin Blue (#89B4FA)
gfx_setfont(1);
gfx_set(0.54, 0.71, 0.98, 1.0);
gfx_x = floor(22 * S);
gfx_measurestr("OVER", tw1, th1);
gfx_y = (hdr_h - th1) * 0.5;
gfx_drawstr("OVER");
gfx_set(0.92, 0.94, 0.98, 1.0);
gfx_drawstr("TOP");

// "?" Info Badge
gfx_setfont(5);
gfx_measurestr("?", qw, qh);
q_x = gfx_x + floor(10 * S);
q_y = (hdr_h - qh - 4) * 0.5;
gfx_set(0.18, 0.19, 0.28, 1.0);
gfx_rect(q_x, q_y, qw + 12, qh + 4);
gfx_set(0.65, 0.72, 0.90, 1.0);
gfx_x = q_x + 6; gfx_y = q_y + 2;
gfx_drawstr("?");

title_hit = mouse_x >= 16 && mouse_x <= (q_x + qw + 16) && mouse_y >= 6 && mouse_y <= (hdr_h - 6);
(mouse_cap & 1) && !(last_mouse_cap & 1) && title_hit ? (
  info_open = !info_open;
);

// UI Text Scale Toggle Button (TEXT: 100% / 120% / 140%)
zm_w = floor(100 * S); zm_h = floor(28 * S);
zm_x = W - floor(242 * S); zm_y = (hdr_h - zm_h) * 0.5;
zm_hit = mouse_x >= zm_x && mouse_x <= zm_x + zm_w && mouse_y >= zm_y && mouse_y <= zm_y + zm_h;
(mouse_cap & 1) && !(last_mouse_cap & 1) && zm_hit ? (
  ui_zoom < 1.1 ? ui_zoom = 1.20 :
  ui_zoom < 1.3 ? ui_zoom = 1.40 : ui_zoom = 1.0;
  slider_automate(slider17);
);
draw_panel_box(zm_x, zm_y, zm_w, zm_h, 0.15, 0.16, 0.23, 0.28, 0.30, 0.42);
gfx_setfont(4);
gfx_set(0.80, 0.84, 0.96, 1.0);
ui_zoom < 1.1 ? strcpy(#z_lbl, "TEXT: 100%") :
ui_zoom < 1.3 ? strcpy(#z_lbl, "TEXT: 120%") : strcpy(#z_lbl, "TEXT: 140%");
gfx_measurestr(#z_lbl, zw, zh);
gfx_x = zm_x + (zm_w - zw) * 0.5; gfx_y = zm_y + (zm_h - zh) * 0.5;
gfx_drawstr(#z_lbl);

// Master ACTIVE / BYPASS Button
act_w = floor(104 * S); act_h = floor(28 * S);
act_x = W - act_w - floor(22 * S); act_y = (hdr_h - act_h) * 0.5;
act_hit = mouse_x >= act_x && mouse_x <= act_x + act_w && mouse_y >= act_y && mouse_y <= act_y + act_h;
(mouse_cap & 1) && !(last_mouse_cap & 1) && act_hit ? (
  active_on = !active_on;
  slider_automate(slider16);
);
active_on ? (
  draw_panel_box(act_x, act_y, act_w, act_h, 0.22, 0.58, 0.92, 0.55, 0.82, 1.0);
  gfx_set(1.0, 1.0, 1.0, 1.0);
  strcpy(#act_str, "ACTIVE");
) : (
  draw_panel_box(act_x, act_y, act_w, act_h, 0.15, 0.16, 0.23, 0.28, 0.30, 0.42);
  gfx_set(0.65, 0.68, 0.78, 1.0);
  strcpy(#act_str, "BYPASSED");
);
gfx_setfont(4);
gfx_measurestr(#act_str, acw, ach);
gfx_x = act_x + (act_w - acw) * 0.5; gfx_y = act_y + (act_h - ach) * 0.5;
gfx_drawstr(#act_str);

// =========================================================================
// 2. TIER 1 (TOP): 4 PRIMARY KNOBS (DEPTH, TIME, IN GAIN, OUT GAIN)
// =========================================================================
pad    = floor(16 * S);
full_w = W - (pad * 2);
avail_h = H - hdr_h - (pad * 4);

top_y = hdr_h + pad;
top_h = floor(avail_h * 0.27);
mid_h = floor(avail_h * 0.46);
bot_h = avail_h - top_h - mid_h;

draw_panel_box(pad, top_y, full_w, top_h, 0.095, 0.098, 0.145, 0.20, 0.22, 0.31);

r_top  = min(floor(33 * S), floor(top_h * 0.24));
top_cy = top_y + top_h * 0.36;

// 1. DEPTH (0..100%)
sprintf(#dp_s, "%.0f %%", depth_pct);
new_dp = draw_rotary_knob(1, pad + full_w * 0.14, top_cy, r_top + 2, depth_pct, 0.0, 100.0, 100.0, "DEPTH", #dp_s, 1, 0);
abs(new_dp - depth_pct) > 0.01 ? ( depth_pct = new_dp; update_parameters(); slider_automate(slider1); );

// 2. TIME (1..1000%)
sprintf(#tm_s, "%.0f %%", time_pct);
new_tm = draw_rotary_knob(2, pad + full_w * 0.38, top_cy, r_top, time_pct, 1.0, 1000.0, 100.0, "TIME", #tm_s, 0, 0);
abs(new_tm - time_pct) > 0.01 ? ( time_pct = new_tm; update_parameters(); slider_automate(slider2); );

// 3. IN GAIN (-24..+24 dB)
sprintf(#ig_s, "%+.1f dB", in_gain_db);
new_ig = draw_rotary_knob(3, pad + full_w * 0.62, top_cy, r_top, in_gain_db, -24.0, 24.0, 0.0, "IN GAIN", #ig_s, 0, 1);
abs(new_ig - in_gain_db) > 0.01 ? ( in_gain_db = new_ig; update_parameters(); slider_automate(slider3); );

// 4. OUT GAIN (-24..+24 dB)
sprintf(#og_s, "%+.1f dB", out_gain_db);
new_og = draw_rotary_knob(4, pad + full_w * 0.86, top_cy, r_top, out_gain_db, -24.0, 24.0, 0.0, "OUT GAIN", #og_s, 0, 1);
abs(new_og - out_gain_db) > 0.01 ? ( out_gain_db = new_og; update_parameters(); slider_automate(slider4); );

// =========================================================================
// 3. TIER 2 (MIDDLE): 3 HORIZONTAL BAND STRIPS WITH INLINE GAIN KNOBS (H / M / L)
// =========================================================================
mid_y = top_y + top_h + pad;
draw_panel_box(pad, mid_y, full_w, mid_h, 0.095, 0.098, 0.145, 0.20, 0.22, 0.31);

// Column Header Labels inside Middle Deck
hdr_strip_h = floor(24 * S);
row_pad = floor(12 * S);
row_gap = floor(8 * S);
row_w   = full_w - row_pad * 2;
row_h   = floor((mid_h - hdr_strip_h - row_pad - row_gap * 2) / 3.0);

// Horizontal Sub-Column Geometry inside each Band Row:
// [Band Enable Button (76px)] [Threshold & Level Bar (54%)] [Gain Change Meter (25%)] [Inline Band Gain Knob]
b_btn_w = floor(76 * S);
k_col_w = floor(92 * S);
bars_avail_w = row_w - b_btn_w - k_col_w - floor(36 * S);
lvl_bar_w = floor(bars_avail_w * 0.65);
gr_bar_w  = bars_avail_w - lvl_bar_w;

col_btn_x = pad + row_pad + floor(8 * S);
col_lvl_x = col_btn_x + b_btn_w + floor(10 * S);
col_gr_x  = col_lvl_x + lvl_bar_w + floor(10 * S);
col_knb_cx = col_gr_x + gr_bar_w + floor(8 * S) + k_col_w * 0.5;

gfx_setfont(5);
gfx_set(0.58, 0.62, 0.76, 1.0);
gfx_x = col_btn_x;  gfx_y = mid_y + floor(6 * S); gfx_drawstr("BAND");
gfx_x = col_lvl_x;  gfx_y = mid_y + floor(6 * S); gfx_drawstr("THRESHOLDS & RMS LEVEL (DRAG TO SHIFT)");
gfx_x = col_gr_x;   gfx_y = mid_y + floor(6 * S); gfx_drawstr("GAIN CHANGE");
gfx_measurestr("BAND GAIN", bgw, bgh);
gfx_x = col_knb_cx - bgw * 0.5; gfx_y = mid_y + floor(6 * S); gfx_drawstr("BAND GAIN");

function draw_integrated_band_strip(row_id, knob_id, ry, band_title, freq_sub, in_db, gr_db, up_thr, dn_thr, thr_off, band_gain, is_byp)
  local(inner_y, inner_h, db_min, db_max, up_px, dn_px, in_px, hit_thr, hit_byp,
        zero_gx, gr_px, bar_x0, bar_x1, tw, th, r_inline, knb_cy)
(
  draw_panel_box(pad + row_pad, ry, row_w, row_h, 0.072, 0.075, 0.115, 0.19, 0.21, 0.30);

  inner_y = ry + floor(8 * S);
  inner_h = row_h - floor(16 * S);

  // 1. Left Clickable Band Enable Button (H / M / L)
  hit_byp = (mouse_x >= col_btn_x && mouse_x <= col_btn_x + b_btn_w &&
             mouse_y >= inner_y && mouse_y <= inner_y + inner_h);
  (mouse_cap & 1) && !(last_mouse_cap & 1) && hit_byp ? (
    byp_clicked = 1;
  ) : (
    byp_clicked = 0;
  );

  !is_byp ? (
    draw_panel_box(col_btn_x, inner_y, b_btn_w, inner_h, 0.16, 0.38, 0.68, 0.45, 0.78, 0.98);
    gfx_set(1.0, 1.0, 1.0, 1.0);
  ) : (
    draw_panel_box(col_btn_x, inner_y, b_btn_w, inner_h, 0.12, 0.13, 0.18, 0.24, 0.26, 0.35);
    gfx_set(0.48, 0.52, 0.62, 1.0);
  );

  gfx_setfont(6);
  gfx_measurestr(band_title, tw, th);
  gfx_x = col_btn_x + (b_btn_w - tw) * 0.5;
  gfx_y = inner_y + floor(inner_h * 0.14);
  gfx_drawstr(band_title);

  gfx_setfont(5);
  !is_byp ? gfx_set(0.82, 0.90, 1.0, 0.95) : gfx_set(0.45, 0.48, 0.58, 0.9);
  gfx_measurestr(freq_sub, tw, th);
  gfx_x = col_btn_x + (b_btn_w - tw) * 0.5;
  gfx_y = inner_y + inner_h - th - floor(5 * S);
  gfx_drawstr(freq_sub);

  // 2. Threshold & Input Level Bar (-60 dB to 0 dB)
  draw_panel_box(col_lvl_x, inner_y, lvl_bar_w, inner_h, 0.045, 0.047, 0.075, 0.18, 0.20, 0.28);

  db_min = -60.0;
  db_max = 0.0;
  up_px = col_lvl_x + max(0.0, min(1.0, (up_thr - db_min) / (db_max - db_min))) * lvl_bar_w;
  dn_px = col_lvl_x + max(0.0, min(1.0, (dn_thr - db_min) / (db_max - db_min))) * lvl_bar_w;
  in_px = col_lvl_x + max(0.0, min(1.0, (in_db  - db_min) / (db_max - db_min))) * lvl_bar_w;

  !is_byp ? (
    // Upward Boost Shaded Region (Sapphire Blue)
    up_px > col_lvl_x + 2 ? (
      gfx_set(0.28, 0.62, 0.95, 0.25 * min(1.5, up_str_pct * 0.01));
      gfx_rect(col_lvl_x + 1, inner_y + 2, up_px - col_lvl_x - 1, inner_h - 4);
      gfx_set(0.45, 0.78, 0.98, 0.95);
      gfx_line(up_px, inner_y + 1, up_px, inner_y + inner_h - 2);
      gfx_line(up_px + 1, inner_y + 1, up_px + 1, inner_y + inner_h - 2);
    );

    // Downward Compression Shaded Region (Amber / Peach)
    dn_px < col_lvl_x + lvl_bar_w - 2 ? (
      gfx_set(0.98, 0.68, 0.45, 0.25 * min(1.5, dn_str_pct * 0.01));
      gfx_rect(dn_px, inner_y + 2, (col_lvl_x + lvl_bar_w - 1) - dn_px, inner_h - 4);
      gfx_set(0.98, 0.75, 0.50, 0.95);
      gfx_line(dn_px, inner_y + 1, dn_px, inner_y + inner_h - 2);
      gfx_line(dn_px - 1, inner_y + 1, dn_px - 1, inner_y + inner_h - 2);
    );
  );

  // Live Input Level Fill & White Peak Cursor
  in_px > col_lvl_x + 2 ? (
    gfx_set(0.54, 0.71, 0.98, 0.42);
    gfx_rect(col_lvl_x + 2, inner_y + floor(inner_h * 0.30), in_px - col_lvl_x - 2, floor(inner_h * 0.40));
    gfx_set(0.96, 0.98, 1.0, 1.0);
    gfx_rect(in_px - 2, inner_y + 3, 4, inner_h - 6);
  );

  // Horizontal Drag inside Level Bar to Shift Band Thresholds
  hit_thr = (mouse_x >= col_lvl_x && mouse_x <= col_lvl_x + lvl_bar_w &&
             mouse_y >= inner_y && mouse_y <= inner_y + inner_h);
  (mouse_cap & 1) && !(last_mouse_cap & 1) && hit_thr && (drag_id == 0) ? (
    (time_precise() - last_click_time < 0.28) && (last_click_id == row_id) ? (
      thr_off = 0.0;
      drag_id = 0;
    ) : (
      drag_id = row_id;
      drag_start_x = mouse_x;
      drag_start_val = thr_off;
      last_click_time = time_precise();
      last_click_id = row_id;
    );
  );

  drag_id == row_id ? (
    (mouse_cap & 1) ? (
      thr_off = max(-24.0, min(24.0, drag_start_val + ((mouse_x - drag_start_x) / lvl_bar_w) * 48.0));
    ) : (
      drag_id = 0;
    );
  );

  // 3. Center-Zero Gain Change Bar (-24 dB Downward <-> +24 dB Upward)
  draw_panel_box(col_gr_x, inner_y, gr_bar_w, inner_h, 0.045, 0.047, 0.075, 0.18, 0.20, 0.28);

  zero_gx = col_gr_x + gr_bar_w * 0.5;
  gfx_set(0.32, 0.35, 0.48, 0.9);
  gfx_line(zero_gx, inner_y + 1, zero_gx, inner_y + inner_h - 2);

  gr_px  = zero_gx + max(-1.0, min(1.0, gr_db / 24.0)) * (gr_bar_w * 0.48);
  bar_x0 = min(zero_gx, gr_px);
  bar_x1 = max(zero_gx, gr_px);

  abs(gr_db) > 0.05 ? (
    gr_db > 0.0 ? (
      gfx_set(0.58, 0.89, 0.84, 0.90); // Teal upward boost
    ) : (
      gfx_set(0.45, 0.78, 0.98, 0.90); // Sapphire downward reduction
    );
    gfx_rect(bar_x0, inner_y + 4, max(2, bar_x1 - bar_x0), inner_h - 8);
  );

  sprintf(#gr_s, "%+.1f dB", gr_db);
  gfx_setfont(5);
  gfx_measurestr(#gr_s, tw, th);
  gfx_set(0.92, 0.95, 1.0, 0.95);
  gfx_x = col_gr_x + gr_bar_w - tw - 6;
  gfx_y = inner_y + (inner_h - th) * 0.5;
  gfx_drawstr(#gr_s);

  // 4. Right Inline Band Gain Knob (Aligned on the exact same row)
  r_inline = min(floor(21 * S), floor(row_h * 0.26));
  knb_cy   = ry + row_h * 0.36;
  sprintf(#bg_s, "%+.1f dB", band_gain);
  out_band_gain = draw_inline_band_knob(knob_id, col_knb_cx, knb_cy, r_inline, band_gain, -24.0, 24.0, 0.0, #bg_s, is_byp);
  out_thr_off   = thr_off;
);

// --- ROW 1: HIGH BAND (2.5 kHz+) ---
r_hy = mid_y + hdr_strip_h;
draw_integrated_band_strip(101, 7, r_hy, "HIGH", "2.5k+", db_in_h, gr_db_h, up_thr_h, dn_thr_h, thresh_offset_h, gain_h_db, byp_h);
byp_clicked ? ( byp_h = !byp_h; slider_automate(slider15); );
abs(out_thr_off - thresh_offset_h) > 0.01 ? ( thresh_offset_h = out_thr_off; update_parameters(); slider_automate(slider12); );
abs(out_band_gain - gain_h_db) > 0.01 ? ( gain_h_db = out_band_gain; update_parameters(); slider_automate(slider9); );

// --- ROW 2: MID BAND (88 Hz - 2.5 kHz) ---
r_my = r_hy + row_h + row_gap;
draw_integrated_band_strip(102, 8, r_my, "MID", "88-2.5k", db_in_m, gr_db_m, up_thr_m, dn_thr_m, thresh_offset_m, gain_m_db, byp_m);
byp_clicked ? ( byp_m = !byp_m; slider_automate(slider14); );
abs(out_thr_off - thresh_offset_m) > 0.01 ? ( thresh_offset_m = out_thr_off; update_parameters(); slider_automate(slider11); );
abs(out_band_gain - gain_m_db) > 0.01 ? ( gain_m_db = out_band_gain; update_parameters(); slider_automate(slider8); );

// --- ROW 3: LOW BAND (< 88 Hz) ---
r_ly = r_my + row_h + row_gap;
draw_integrated_band_strip(103, 9, r_ly, "LOW", "< 88Hz", db_in_l, gr_db_l, up_thr_l, dn_thr_l, thresh_offset_l, gain_l_db, byp_l);
byp_clicked ? ( byp_l = !byp_l; slider_automate(slider13); );
abs(out_thr_off - thresh_offset_l) > 0.01 ? ( thresh_offset_l = out_thr_off; update_parameters(); slider_automate(slider10); );
abs(out_band_gain - gain_l_db) > 0.01 ? ( gain_l_db = out_band_gain; update_parameters(); slider_automate(slider7); );

// =========================================================================
// 4. TIER 3 (BOTTOM): 2 CENTERED KNOBS FOR UPWARD % AND DOWNWARD %
// =========================================================================
bot_y = mid_y + mid_h + pad;
draw_panel_box(pad, bot_y, full_w, bot_h, 0.095, 0.098, 0.145, 0.20, 0.22, 0.31);

r_bot  = min(floor(33 * S), floor(bot_h * 0.24));
bot_cy = bot_y + bot_h * 0.36;

// UPWARD % (0..200%)
sprintf(#up_s, "%.0f %%", up_str_pct);
new_up = draw_rotary_knob(5, pad + full_w * 0.35, bot_cy, r_bot, up_str_pct, 0.0, 200.0, 100.0, "UPWARD %", #up_s, 1, 0);
abs(new_up - up_str_pct) > 0.01 ? ( up_str_pct = new_up; update_parameters(); slider_automate(slider5); );

// DOWNWARD % (0..200%)
sprintf(#dn_s, "%.0f %%", dn_str_pct);
new_dn = draw_rotary_knob(6, pad + full_w * 0.65, bot_cy, r_bot, dn_str_pct, 0.0, 200.0, 100.0, "DOWNWARD %", #dn_s, 1, 0);
abs(new_dn - dn_str_pct) > 0.01 ? ( dn_str_pct = new_dn; update_parameters(); slider_automate(slider6); );

// Subtle center divider line between Upward % and Downward %
gfx_set(0.18, 0.20, 0.28, 1.0);
gfx_line(pad + full_w * 0.50, bot_y + floor(16 * S), pad + full_w * 0.50, bot_y + bot_h - floor(16 * S));

// =========================================================================
// 5. INFO OVERLAY MODAL (Click OVERTOP Logo to Toggle)
// =========================================================================
info_open ? (
  mw = floor(W * 0.78);
  mh = floor(300 * S);
  mx = (W - mw) * 0.5;
  my = (H - mh) * 0.5;

  draw_panel_box(mx, my, mw, mh, 0.07, 0.07, 0.11, 0.54, 0.71, 0.98);

  gfx_setfont(1);
  gfx_set(0.54, 0.71, 0.98, 1.0);
  gfx_x = mx + 24; gfx_y = my + 20;
  gfx_drawstr("OverTop v1.2 (Authentic OTT 3-Band Dynamics)");

  gfx_setfont(3);
  gfx_set(0.90, 0.93, 0.98, 1.0);
  lh_step = floor(27 * S);
  ty = my + 62;
  gfx_x = mx + 24; gfx_y = ty;             gfx_drawstr("• 4th-Order Linkwitz-Riley (24 dB/oct) phase-aligned crossover (88.3 Hz & 2.5 kHz)");
  gfx_x = mx + 24; gfx_y = ty + lh_step;   gfx_drawstr("• True stereo RMS power detection + dB-domain gain smoothing");
  gfx_x = mx + 24; gfx_y = ty + lh_step*2; gfx_drawstr("• Authentic OTT time scaling (0.15x Attack / 0.25x Release) & +10.3 dB High lift");
  gfx_x = mx + 24; gfx_y = ty + lh_step*3; gfx_drawstr("• Phase-coherent Depth scaling (scales ratios & makeup with zero comb filtering)");
  gfx_x = mx + 24; gfx_y = ty + lh_step*4; gfx_drawstr("• Drag horizontally inside any band's level bar to shift its thresholds");
  gfx_x = mx + 24; gfx_y = ty + lh_step*5; gfx_drawstr("• Double-click any knob or threshold bar to reset to factory default");

  gfx_set(0.58, 0.64, 0.78, 1.0);
  gfx_x = mx + 24; gfx_y = my + mh - 34;
  gfx_drawstr("Click anywhere on this card or the header logo to close.");

  (mouse_cap & 1) && !(last_mouse_cap & 1) &&
  (mouse_x >= mx && mouse_x <= mx + mw && mouse_y >= my && mouse_y <= my + mh) ? (
    info_open = 0;
  );
);

last_mouse_cap = mouse_cap;
